---
/**
 * Route: /app/affiliate
 * Auto-redirect to /aff/
 */
---
<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content="0;url=/aff/" />
    <title>Redirecting to Travel4U VIP Affiliate Dashboard (/aff/)...</title>
    <script>
      window.location.href = '/aff/' + window.location.search;
    </script>
  </head>
  <body class="bg-[#07111e] text-white flex items-center justify-center min-h-screen font-sans">
    <p class="text-sm text-slate-400">Đang chuyển hướng tới Bảng điều khiển Đối tác: <a href="/aff/" class="text-amber-400 underline font-semibold">/aff/</a>...</p>
  </body>
</html>
