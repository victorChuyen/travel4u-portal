---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Xác Nhận Đơn Hàng Thành Công — OPC AI Revenue Lab | Victor Chuyen";
const description = "Cảm ơn quý khách đã đặt hàng giải pháp AI thực chiến tại OPC AI Revenue Lab.";
---

<Layout title={title} description={description}>
  <Header currentLocale="vi" />
  <main class="min-h-screen bg-[#07111e] text-slate-100 py-16 px-4 sm:px-6 lg:px-8 flex items-center justify-center">
    <div class="max-w-xl w-full bg-slate-900/90 border border-slate-800 rounded-3xl p-8 sm:p-10 text-center shadow-2xl relative overflow-hidden">
      
      <!-- Top Glow -->
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-48 h-48 bg-amber-500/20 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Icon -->
      <div class="w-16 h-16 rounded-full bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 flex items-center justify-center text-3xl mx-auto mb-6 shadow-lg shadow-emerald-500/20">
        ✓
      </div>

      <span class="inline-block px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-bold uppercase tracking-wider mb-2">
        HỆ THỐNG ĐÃ TIẾP NHẬN ĐƠN HÀNG
      </span>

      <h1 class="text-2xl sm:text-3xl font-extrabold text-white mb-3">
        CẢM ƠN QUÝ KHÁCH!
      </h1>

      <p class="text-slate-300 text-sm sm:text-base mb-6 leading-relaxed">
        Thông tin đặt hàng / đặt cọc của bạn đã được ghi nhận vào hệ thống CRM tự động của <strong>OPC AI Revenue Lab</strong>.
      </p>

      <!-- Order details box -->
      <div class="bg-slate-950/80 border border-slate-800 rounded-2xl p-5 text-left text-xs sm:text-sm space-y-2 mb-8">
        <div class="flex justify-between">
          <span class="text-slate-400">Mã đơn hàng:</span>
          <strong id="res-order-id" class="text-amber-400 font-mono">Đang tải...</strong>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-400">Họ và tên:</span>
          <strong id="res-cust-name" class="text-white">Quý khách</strong>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-400">Trạng thái:</span>
          <span class="text-emerald-400 font-bold">Đã Ghi Nhận Đối Soát 24/7</span>
        </div>
      </div>

      <!-- Next Steps -->
      <div class="text-left bg-blue-950/20 border border-blue-800/40 rounded-2xl p-5 mb-6 text-xs sm:text-sm text-slate-300 space-y-2">
        <strong class="text-blue-300 block mb-1">📌 Bước tiếp theo của bạn:</strong>
        <p>• <strong>Đối với Gói 01 (DIY):</strong> Hướng dẫn tải tài nguyên số và eBook đã được gửi vào Email của bạn.</p>
        <p>• <strong>Đối với Gói 02 &amp; Gói 03 (DWY / DFY):</strong> Victor Chuyen sẽ trực tiếp liên hệ qua Zalo / SĐT bạn đã đăng ký để thống nhất phạm vi và sắp xếp lịch làm việc 1:1.</p>
      </div>

      <!-- Affiliate VIP Tier Activation Box -->
      <div class="text-left bg-gradient-to-r from-amber-950/40 via-slate-900 to-amber-950/40 border border-amber-500/40 rounded-2xl p-5 mb-8 text-xs sm:text-sm text-slate-300 space-y-2">
        <div class="flex items-center justify-between">
          <strong class="text-amber-400 flex items-center gap-2">
            <span>💎 KÍCH HOẠT QUYỀN LỢI AFFILIATE VIP:</span>
          </strong>
          <span id="res-aff-rate" class="px-2.5 py-0.5 rounded-full bg-amber-500/20 text-amber-300 font-extrabold text-xs border border-amber-500/40">
            Hoa hồng 10% - 30%
          </span>
        </div>
        <p class="text-slate-300 text-xs leading-relaxed">
          Đơn hàng của bạn đủ điều kiện kích hoạt <strong>Chính sách Hoa Hồng Đối Tác VIP</strong> (Gói 1: 10%, Gói 2: 20%, Gói 3: 30%). Bạn có thể nhận tới <strong>3.000.000 VNĐ</strong> cho mỗi lượt giới thiệu thành công.
        </p>
        <p class="text-amber-300 text-xs font-semibold">
          ➔ Nhắn Zalo Victor Chuyen với cú pháp: <em>"Kích hoạt Affiliate [Mã Đơn]"</em> để nhận Mã Đối Tác và link giới thiệu cá nhân!
        </p>
      </div>

      <!-- CTA Buttons -->
      <div class="space-y-3">
        <a href="https://zalo.me/0989890022" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-3 w-full py-3.5 px-6 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm transition shadow-lg shadow-blue-600/30">
          <span class="w-6 h-6 rounded-full bg-white text-blue-600 flex items-center justify-center font-black text-xs">Z</span>
          <span>KẾT NỐI ZALO TRỰC TIẾP CÙNG VICTOR CHUYEN</span>
        </a>

        <a href="/" class="block w-full py-3 px-6 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white text-xs font-semibold transition border border-slate-700">
          Quay về Trang Chủ Travel4U
        </a>
      </div>

    </div>
  </main>
  <Footer currentLocale="vi" />
</Layout>

<script>
  const urlParams = new URLSearchParams(window.location.search);
  const orderId = urlParams.get('order_id') || 'OPC-DIRECT';
  const name = urlParams.get('name') || 'Quý khách';
  const tier = urlParams.get('tier') || '';

  const elOrder = document.getElementById('res-order-id');
  const elName = document.getElementById('res-cust-name');
  const affRateEl = document.getElementById('res-aff-rate');

  if (elOrder) elOrder.innerText = orderId;
  if (elName) elName.innerText = decodeURIComponent(name);
  if (affRateEl) {
    if (tier === 'starter-kit') affRateEl.innerText = 'Hoa hồng VIP 10%';
    else if (tier === 'builder-sprint') affRateEl.innerText = 'Hoa hồng VIP 20%';
    else if (tier === 'revenue-system') affRateEl.innerText = 'Hoa hồng VIP 30% 🔥';
  }
</script>
