---
import Layout from '../layouts/Layout.astro';

const title = "Bảng Giá Giải Pháp AI Thực Chiến — OPC AI Revenue Lab | Victor Chuyen";
const description = "Biến AI thành doanh thu thực tế cho Freelancer, SME và Doanh nghiệp. 3 Gói giải pháp từ tự học DIY $19, coaching DWY $139 đến triển khai trọn gói DFY $388.";
---

<Layout title={title} description={description}>
  <main class="min-h-screen bg-[#07111e] text-slate-100 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      
      <!-- HEADER HERO -->
      <div class="text-center mb-16">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs sm:text-sm font-semibold tracking-wider uppercase mb-4">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          OPC AI REVENUE LAB • BUILD • AUTOMATE • MONETIZE
        </div>
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white mb-4">
          BIẾN AI THÀNH <span class="bg-gradient-to-r from-amber-300 via-amber-400 to-amber-500 bg-clip-text text-transparent">DOANH THU THỰC TẾ</span>
        </h1>
        <p class="text-lg sm:text-xl text-slate-300 max-w-3xl mx-auto font-medium mb-3">
          Giải pháp AI thực chiến dành cho Freelancer, SME và Doanh nghiệp
        </p>
        <p class="text-sm sm:text-base text-amber-300/90 font-serif italic">
          "Work Smarter, Grow Faster" — Victor Chuyen
        </p>
      </div>

      <!-- 3 PRICING CARDS -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-8 items-stretch mb-16">
        
        <!-- GÓI 01: DIY -->
        <div class="flex flex-col justify-between bg-slate-900/90 rounded-2xl border border-slate-800 p-6 lg:p-8 hover:border-blue-500/40 transition-all duration-300 shadow-xl relative group">
          <div>
            <div class="text-center pb-6 border-b border-slate-800">
              <span class="inline-block px-3 py-1 rounded bg-blue-500/10 text-blue-400 text-xs font-bold tracking-wider uppercase mb-2">
                GÓI 01 — DIY (DO IT YOURSELF)
              </span>
              <h2 class="text-xl font-bold text-white mb-1">OPC AI STARTER KIT</h2>
              <p class="text-xs text-slate-400 mb-4">Tự xây hệ thống AI đầu tiên cho doanh nghiệp</p>
              
              <div class="flex items-baseline justify-center gap-2">
                <span class="text-4xl font-extrabold text-white">$19</span>
                <span class="text-slate-400 text-sm">/ 500.000 VNĐ</span>
              </div>
            </div>

            <!-- Features -->
            <ul class="space-y-3.5 my-6 text-sm text-slate-300">
              <li class="flex items-start gap-2.5">
                <svg class="w-5 h-5 text-blue-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>eBook 25 AI Automations for SMEs</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-5 h-5 text-blue-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Bộ prompt và template Google Sheets CRM</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-5 h-5 text-blue-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Hướng dẫn từng bước dùng Gemini, AI Studio và Apps Script</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-5 h-5 text-blue-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Checklist triển khai và đo hiệu quả</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-5 h-5 text-blue-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Quyền truy cập tài liệu số và các bản cập nhật</span>
              </li>
            </ul>
          </div>

          <div>
            <p class="text-xs text-center text-slate-400 mb-4 italic">
              Hình thức: Digital Product • Tự học, tự triển khai • Không kèm hỗ trợ 1:1
            </p>
            <a href="/checkout/starter-kit" class="block w-full text-center py-3 px-6 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold transition shadow-lg shadow-blue-600/20">
              BẮT ĐẦU NGAY &gt;
            </a>
          </div>
        </div>

        <!-- GÓI 02: DWY -->
        <div class="flex flex-col justify-between bg-slate-900/90 rounded-2xl border border-slate-800 p-6 lg:p-8 hover:border-emerald-500/40 transition-all duration-300 shadow-xl relative group">
          <div>
            <div class="text-center pb-6 border-b border-slate-800">
              <span class="inline-block px-3 py-1 rounded bg-emerald-500/10 text-emerald-400 text-xs font-bold tracking-wider uppercase mb-2">
                GÓI 02 — DWY (DONE WITH YOU)
              </span>
              <h2 class="text-xl font-bold text-white mb-1">OPC AI BUILDER SPRINT</h2>
              <p class="text-xs text-slate-400 mb-4">Cùng Victor xây một giải pháp AI chạy được thật</p>
              
              <div class="flex items-baseline justify-center gap-2">
                <span class="text-4xl font-extrabold text-white">$139</span>
                <span class="text-slate-400 text-sm">/ 3.600.000 VNĐ</span>
              </div>
              <p class="text-xs text-emerald-400 mt-1 font-medium">Hỗ trợ đặt cọc 50%: 1.800.000 VNĐ</p>
            </div>

            <!-- Features -->
            <ul class="space-y-3.5 my-6 text-sm text-slate-300">
              <li class="flex items-start gap-2.5">
                <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span><strong>Bao gồm toàn bộ</strong> Starter Kit ($19)</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>01 phiên AI Business Audit & xác định bottleneck</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span><strong>02 phiên coaching 1:1 trực tuyến</strong> (mỗi phiên 60 phút)</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Cùng thiết kế và triển khai 01 workflow AI cụ thể</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Hướng dẫn kết nối Google Sheets, Apps Script, Gmail hoặc Telegram</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Checklist QA và tài liệu bàn giao tự vận hành</span>
              </li>
            </ul>
          </div>

          <div>
            <p class="text-xs text-center text-slate-400 mb-4 italic">
              Hình thức: Coaching + Guided Build • Tối đa 01 workflow thống nhất
            </p>
            <a href="/checkout/builder-sprint" class="block w-full text-center py-3 px-6 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold transition shadow-lg shadow-emerald-600/20">
              XÂY CÙNG VICTOR &gt;
            </a>
          </div>
        </div>

        <!-- GÓI 03: DFY (MOST POPULAR) -->
        <div class="flex flex-col justify-between bg-gradient-to-b from-slate-900 via-slate-900 to-[#141b29] rounded-2xl border-2 border-amber-500/80 p-6 lg:p-8 hover:border-amber-400 transition-all duration-300 shadow-2xl relative group transform lg:-translate-y-2">
          <!-- Top badge -->
          <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-gradient-to-r from-amber-500 to-amber-600 text-slate-950 px-4 py-1 rounded-full text-xs font-black tracking-wider uppercase shadow-md">
            👑 PHỔ BIẾN NHẤT (MOST POPULAR)
          </div>

          <div>
            <div class="text-center pb-6 border-b border-slate-800">
              <span class="inline-block px-3 py-1 rounded bg-amber-500/10 text-amber-400 text-xs font-bold tracking-wider uppercase mb-2">
                GÓI 03 — DFY (DONE FOR YOU)
              </span>
              <h2 class="text-xl font-bold text-white mb-1">OPC AI REVENUE SYSTEM</h2>
              <p class="text-xs text-slate-400 mb-4">Victor trực tiếp xây dựng và bàn giao hệ thống AI</p>
              
              <div class="flex items-baseline justify-center gap-2">
                <span class="text-4xl font-extrabold text-amber-400">$388</span>
                <span class="text-slate-300 text-sm">/ 10.000.000 VNĐ</span>
              </div>
              <p class="text-xs text-amber-300 mt-1 font-semibold">Hỗ trợ đặt cọc 50%: 5.000.000 VNĐ</p>
            </div>

            <!-- Features -->
            <ul class="space-y-3.5 my-6 text-sm text-slate-300">
              <li class="flex items-start gap-2.5">
                <svg class="w-5 h-5 text-amber-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>AI Business Audit chuyên sâu và bản thiết kế giải pháp</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-5 h-5 text-amber-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Triển khai 01 hệ thống AI trong phạm vi đã thống nhất</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-5 h-5 text-amber-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span><strong>Kết nối full luồng:</strong> Landing Page ➔ CRM ➔ Automation ➔ Revenue</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-5 h-5 text-amber-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Thiết lập workflow tự động và dashboard KPI cơ bản</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-5 h-5 text-amber-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Kiểm thử, triển khai và bàn giao tài liệu vận hành</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-5 h-5 text-amber-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span><strong>01 buổi đào tạo sử dụng &amp; 14 ngày hỗ trợ sửa lỗi</strong></span>
              </li>
            </ul>
          </div>

          <div>
            <p class="text-xs text-center text-slate-400 mb-4 italic">
              Hình thức: Custom Implementation • Nhận đặt cọc 50% bắt đầu ngay
            </p>
            <a href="/checkout/revenue-system" class="block w-full text-center py-3.5 px-6 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-black transition shadow-lg shadow-amber-500/25">
              ĐẶT LỊCH TRIỂN KHAI &gt;
            </a>
          </div>
        </div>

      </div>

      <!-- VALUE BADGES FOOTER -->
      <div class="grid grid-cols-2 sm:grid-cols-5 gap-4 py-8 border-y border-slate-800 text-center mb-12 text-slate-300 text-xs sm:text-sm font-medium">
        <div class="flex items-center justify-center gap-2">
          <span>⚡</span> <span>Thực chiến (Practical)</span>
        </div>
        <div class="flex items-center justify-center gap-2">
          <span>⏱️</span> <span>Tiết kiệm thời gian</span>
        </div>
        <div class="flex items-center justify-center gap-2">
          <span>📈</span> <span>Tăng doanh thu</span>
        </div>
        <div class="flex items-center justify-center gap-2">
          <span>🤝</span> <span>Hỗ trợ tận tâm</span>
        </div>
        <div class="flex items-center justify-center gap-2 col-span-2 sm:col-span-1">
          <span>🤖</span> <span>Ứng dụng AI mới nhất</span>
        </div>
      </div>

      <!-- 100% RISK-FREE GUARANTEE -->
      <div class="mb-12 bg-gradient-to-r from-emerald-950/40 via-slate-900 to-emerald-950/40 border border-emerald-500/30 rounded-2xl p-6 sm:p-8 text-center relative overflow-hidden shadow-2xl">
        <div class="absolute -top-12 left-1/2 -translate-x-1/2 w-40 h-40 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-bold uppercase tracking-wider mb-3">
          <span>🛡️ CAM KẾT VÀNG TỪ VICTOR CHUYEN</span>
        </div>
