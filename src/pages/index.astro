---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DestinationCard from '../components/DestinationCard.astro';
import SearchBar from '../components/SearchBar.astro';
import destinationsData from '../data/destinations.json';
import i18n from '../data/i18n.json';

const dict = i18n.en;

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://travel4u.us/#website",
      "url": "https://travel4u.us/",
      "name": "Travel4U Luxury Stays & Concierge",
      "description": "World's Most Exclusive 5-Star Luxury Hotels, Historic Palaces & Private Overwater Villas",
      "publisher": {
        "@type": "Organization",
        "name": "Travel4U Luxury Stays",
        "url": "https://travel4u.us/"
      }
    },
    {
      "@type": "ItemList",
      "itemListElement": destinationsData.map((dest, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "name": dest.english_title,
        "url": `https://travel4u.us/experience/${dest.slugs.en}/`
      }))
    }
  ]
};
---

<Layout
  title="Travel4U | World's Top 5-Star Luxury Hotels & Private Sanctuaries"
  description="Discover handpicked presidential suites, Lake Como villas, Maldives overwater reserves, and Kyoto ryokans with verified VIP perks via Expedia Partner Network."
  locale="en"
  schema={schemaData}
>
  <Header currentLocale="en" />

  <main class="flex-grow">
    
    <!-- 👑 HERO SECTION (EXPEDIA LUXURY REDESIGN) -->
    <section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden py-24 px-4 sm:px-6 lg:px-8">
      
      <!-- Background 4K Atmosphere (Official Expedia 4K CDN) -->
      <div class="absolute inset-0 z-0">
        <img
          src="/media/expedia_hotels/expedia_paris_four_seasons_george_v_hero_4k.jpg"
          alt="Four Seasons Hotel George V Paris 4K UHD"
          class="w-full h-full object-cover object-center brightness-[0.35] scale-105 transform animate-pulse duration-[12000ms]"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-[#07111e]/85 via-[#07111e]/70 to-[#07111e]"></div>
      </div>

      <div class="relative z-10 max-w-5xl mx-auto text-center w-full">
        
        <!-- Trust Badges -->
        <div class="inline-flex flex-wrap items-center justify-center gap-3 mb-8">
          <span class="bg-[#c9a54e]/20 border border-[#c9a54e]/50 text-[#c9a54e] text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full backdrop-blur-md shadow-lg">
            👑 2026 Gold List Luxury Stays
          </span>
          <span class="bg-slate-900/80 border border-slate-700 text-slate-300 text-xs font-medium px-4 py-1.5 rounded-full backdrop-blur-md">
            ⚡ Verified by 35,000+ Forbes & Expedia Reviews
          </span>
          <span class="bg-emerald-950/60 border border-emerald-500/40 text-emerald-300 text-xs font-semibold px-4 py-1.5 rounded-full backdrop-blur-md">
            ✓ VIP Breakfast & Room Upgrade Perks
          </span>
        </div>

        <!-- Headline -->
        <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-white tracking-tight leading-[1.15] mb-6">
          Sovereign Sanctuaries <span class="bg-gradient-to-r from-[#c9a54e] via-[#dfba63] to-[#ff7043] bg-clip-text text-transparent">Worth Traveling For</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg md:text-xl text-slate-300 max-w-3xl mx-auto font-normal leading-relaxed mb-10">
          From Lake Como floating palaces to secluded Maldives overwater reserves. An authoritative global collection of 1,000 peerless 5-star sanctuaries verified with Expedia Partner Network.
        </p>

        <!-- 🔍 FLOATING SEARCH BAR & CATEGORY PILLS -->
        <SearchBar currentLocale="en" />

      </div>

    </section>

    <!-- 💎 10 GOLD LIST FLAGSHIP DESTINATIONS -->
    <section id="experiences" class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
        <div>
          <span class="text-xs font-bold text-[#c9a54e] uppercase tracking-[0.2em] block mb-2">
            The 2026 Sovereign Stays Collection
          </span>
          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white tracking-tight">
            Curated 5-Star Sanctuaries of a Lifetime
          </h2>
        </div>
        <p class="text-sm text-slate-400 max-w-md">
          Every sanctuary is rigorously audited for Forbes Five-Star excellence, verified master butler service, and direct live availability via Expedia Group.
        </p>
      </div>

      <!-- Empty Search State -->
      <div id="no-search-results-msg" style="display: none;" class="text-center py-16 px-4 bg-[#0b1726]/60 border border-slate-800 rounded-3xl mb-8">
        <span class="text-4xl mb-3 block">🔍</span>
        <h3 class="font-serif text-xl font-bold text-white mb-2">No Matching Luxury Sanctuaries Found</h3>
        <p class="text-xs text-slate-400 max-w-md mx-auto">
          Try searching for "Paris", "Rome", "Kyoto", "Maldives", or click "All Destinations" above to view our complete collection.
        </p>
      </div>

      <!-- Destination Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="destinations-grid-container">
        {destinationsData.map((dest) => (
          <DestinationCard
            title={dest.english_title}
            slug={dest.slugs.en}
            location={dest.location}
            image={dest.hero_image}
            rating={dest.rating}
            price={dest.price_display}
            expediaLink={(dest as any).expedia_direct_link}
            locale="en"
            region={(dest as any).region || (dest.location.includes('Japan') ? 'Asia' : dest.location.includes('Maldives') ? 'Islands' : dest.location.includes('Serengeti') ? 'Safari' : dest.location.includes('Dubai') ? 'Middle East' : 'Europe')}
            category="5-Star Luxury Stay"
          />
        ))}
      </div>

    </section>

    <!-- 🌟 VALUE PROPOSITION: WHY BOOK THROUGH EXPEDIA PARTNER NETWORK -->
    <section class="py-16 bg-[#040a12] border-t border-b border-slate-800/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <span class="text-xs font-bold text-[#c9a54e] uppercase tracking-[0.2em] block mb-2">
            The Sovereign Standard
          </span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-white tracking-tight">
            Why Reserve Through Verified Expedia Partner Links?
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="p-6 rounded-2xl bg-[#07111e] border border-slate-800">
            <div class="w-10 h-10 rounded-xl bg-[#c9a54e]/10 border border-[#c9a54e]/30 flex items-center justify-center text-xl mb-4">
              👑
            </div>
            <h3 class="font-serif text-lg font-bold text-white mb-2">Elite VIP Amenities</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Complimentary daily gourmet breakfast for two, room upgrades upon arrival (subject to availability), and exclusive on-property credits at world-renowned spas.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-[#07111e] border border-slate-800">
            <div class="w-10 h-10 rounded-xl bg-[#c9a54e]/10 border border-[#c9a54e]/30 flex items-center justify-center text-xl mb-4">
              🛡️
            </div>
            <h3 class="font-serif text-lg font-bold text-white mb-2">Live Availability & Rate Parity</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Direct integration with Expedia Group inventory guarantees real-time room availability, official member rates, and transparent pricing with zero surprise fees.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-[#07111e] border border-slate-800">
            <div class="w-10 h-10 rounded-xl bg-[#c9a54e]/10 border border-[#c9a54e]/30 flex items-center justify-center text-xl mb-4">
              🤝
            </div>
            <h3 class="font-serif text-lg font-bold text-white mb-2">Flexible Cancellation Protection</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Travel with peace of mind. Access flexible cancellation windows and 24/7 dedicated guest support across international time zones.
            </p>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer currentLocale="en" />
</Layout>
