---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DestinationCard from '../components/DestinationCard.astro';
import SearchBar from '../components/SearchBar.astro';
import destinationsData from '../data/destinations.json';
import i18n from '../data/i18n.json';

const dict = i18n.en;

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://travel4u.us/#website",
      "url": "https://travel4u.us/",
      "name": "Travel4U | Luxury Journeys, Intelligently Crafted",
      "alternateName": [
        "Travel4U Luxury Stays",
        "Travel4U Expedia Concierge",
        "Luxury Travel4U Victor & Lucky"
      ],
      "description": "World's most extraordinary 5-star luxury hotels, historic palaces, private overwater villas, and alpine chalets curated by Victor & Lucky with Expedia Partner Network.",
      "publisher": {
        "@id": "https://travel4u.us/#organization"
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://travel4u.us/?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      },
      "inLanguage": "en"
    },
    {
      "@type": "Organization",
      "@id": "https://travel4u.us/#organization",
      "name": "Travel4U - Sovereign Luxury Concierge",
      "alternateName": "Luxury Travel4U",
      "url": "https://travel4u.us/",
      "logo": "https://travel4u.us/Luxury-Travel4U.png",
      "image": "https://travel4u.us/Luxury-Travel4U.png",
      "slogan": "More Than A Trip · A Brighter You",
      "founders": [
        {
          "@type": "Person",
          "name": "Victor",
          "jobTitle": "Co-Founder & Heritage Curation Lead"
        },
        {
          "@type": "Person",
          "name": "Lucky",
          "jobTitle": "Co-Founder & Sensory Experience Director"
        }
      ],
      "knowsAbout": [
        "Luxury Hotels",
        "Expedia Partner Network",
        "5-Star Presidential Suites",
        "Overwater Villas",
        "Michelin Dining",
        "VIP Travel Concierge"
      ],
      "sameAs": [
        "https://www.youtube.com/@Travel4U_Luxury",
        "https://twitter.com/Travel4U_VIP"
      ]
    },
    {
      "@type": "ItemList",
      "@id": "https://travel4u.us/#itemlist",
      "name": "The 2026 Gold List Luxury Stays & Sanctuaries",
      "description": "Handpicked presidential suites and private sanctuaries across Europe, Asia, Americas, and the Indian Ocean.",
      "itemListElement": destinationsData.map((dest, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "name": dest.english_title,
        "url": `https://travel4u.us/experience/${dest.slugs.en}/`,
        "image": `https://travel4u.us${dest.hero_image}`
      }))
    },
    {
      "@type": "FAQPage",
      "@id": "https://travel4u.us/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What makes Travel4U luxury stays different from standard booking portals?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Travel4U is an intimate luxury curation platform led by founders Victor & Lucky. Every property is audited for sensory acoustic privacy, Forbes Five-Star standards, Michelin gastronomy, and verified VIP perks powered directly by Expedia Partner Network."
          }
        },
        {
          "@type": "Question",
          "name": "How do Victor & Lucky curate each 5-star hotel in the collection?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Victor and Lucky evaluate each stay through a 4-point emotional formula: 1 positive emotion, 1 core concern resolved (such as complete soundproofing and discreet butler service), 1 ideal guest persona, and an unforgettable 'WOA' climax that inspires guests to return annually."
          }
        },
        {
          "@type": "Question",
          "name": "What VIP perks do I receive when reserving via Travel4U's Expedia partnership?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Guests booking through our verified Expedia partner links enjoy official member rate parity, complimentary gourmet daily breakfast for two, priority room upgrades upon arrival (subject to availability), and exclusive on-property spa credits."
          }
        },
        {
          "@type": "Question",
          "name": "Are reservation cancellations flexible and transparent?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Every booking is managed directly on Expedia Group's secure global infrastructure, offering transparent room policies, flexible cancellation windows, and 24/7 dedicated guest protection."
          }
        },
        {
          "@type": "Question",
          "name": "How does Travel4U utilize AI in luxury travel planning?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Travel4U pairs high-touch human curation with intelligent search indexing to deliver 60 FPS real-time availability filtering, multi-locale cultural adaptation across 12 languages, and custom sensory recommendations."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title="Travel4U | Luxury Journeys, Intelligently Crafted — 5-Star Sanctuaries & Historic Palaces"
  description="Discover handpicked presidential suites, Lake Como villas, Maldives overwater reserves, and Kyoto ryokans. Curated by Victor & Lucky with Expedia VIP perks."
  keywords="luxury journeys intelligently crafted, luxury hotels, 5 star presidential suites, private overwater villas, Lake Como luxury stays, Kyoto luxury ryokan, luxury safari camps, Swiss Alps luxury chalets, Expedia VIP perks, Travel4U Victor and Lucky, luxury travel concierge"
  image="/Luxury-Travel4U.png"
  locale="en"
  schema={schemaData}
>
  <Header currentLocale="en" />

  <main class="flex-grow">
    
    <!-- 👑 HERO SECTION (LUXURY JOURNEYS, INTELLIGENTLY CRAFTED) -->
    <section class="relative min-h-[82vh] sm:min-h-[88vh] flex items-center justify-center overflow-hidden py-10 sm:py-20 md:py-24 px-3 sm:px-6 lg:px-8">
      
      <!-- Background 4K Atmosphere -->
      <div class="absolute inset-0 z-0">
        <img
          src="/media/expedia_hotels/expedia_paris_four_seasons_george_v_hero_4k.jpg"
          alt="Luxury Journeys Intelligently Crafted - Four Seasons George V"
          class="w-full h-full object-cover object-center brightness-[0.28] scale-105 transform animate-pulse duration-[14000ms]"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-[#07111e]/90 via-[#07111e]/75 to-[#07111e]"></div>
      </div>

      <div class="relative z-10 max-w-5xl mx-auto text-center w-full">
        
        <!-- Trust & Brand Badges -->
        <div class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-3 mb-6 sm:mb-8">
          <span class="bg-[#c9a54e]/20 border border-[#c9a54e]/50 text-[#c9a54e] text-[11px] sm:text-xs font-bold uppercase tracking-wider sm:tracking-widest px-3 py-1 sm:px-4 sm:py-1.5 rounded-full backdrop-blur-md shadow-lg shrink-0">
            👑 2026 Sovereign Gold List
          </span>
          <span class="bg-slate-900/80 border border-slate-700 text-slate-300 text-[11px] sm:text-xs font-medium px-3 py-1 sm:px-4 sm:py-1.5 rounded-full backdrop-blur-md shrink-0">
            ✨ Curated by Victor & Lucky
          </span>
          <span class="bg-emerald-950/60 border border-emerald-500/40 text-emerald-300 text-[11px] sm:text-xs font-semibold px-3 py-1 sm:px-4 sm:py-1.5 rounded-full backdrop-blur-md shrink-0">
            ✓ VIP Perks & Verified Parity
          </span>
        </div>

        <!-- Master Headline from Brand Directives -->
        <h1 class="luxury-neon-headline font-serif text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight leading-[1.14] mb-4 sm:mb-6">
          Luxury Journeys, <span class="luxury-neon-gradient">Intelligently Crafted</span>
        </h1>

        <!-- Signature Tagline -->
        <p class="font-serif italic text-base sm:text-xl text-[#c9a54e] mb-3 sm:mb-4 px-2">
          “A more beautiful world awaits you · More than a trip, a brighter you.”
        </p>

        <!-- Subtitle -->
        <p class="text-xs sm:text-base md:text-lg text-slate-300 max-w-3xl mx-auto font-normal leading-relaxed mb-8 sm:mb-10 px-2">
          Discover the world’s most extraordinary destinations with AI-powered itineraries, handpicked 5-star sanctuaries, and personal storytelling from founders Victor & Lucky.
        </p>

        <!-- 🔍 FLOATING SEARCH BAR & CATEGORY PILLS -->
        <SearchBar currentLocale="en" />

        <!-- 📊 4 LIVE TRUST STATS FROM MASTER BRAND ASSET -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-2.5 sm:gap-4 mt-8 pt-6 sm:mt-12 sm:pt-8 border-t border-slate-800/80 max-w-4xl mx-auto">
          <div class="p-3 sm:p-4 rounded-xl bg-[#0b1726]/80 border border-slate-800/60 backdrop-blur-sm text-center">
            <div class="font-serif text-xl sm:text-3xl font-bold text-[#c9a54e]">1M+</div>
            <div class="text-[10px] sm:text-[11px] uppercase tracking-wider text-slate-400 mt-0.5">Happy Travelers</div>
          </div>
          <div class="p-3 sm:p-4 rounded-xl bg-[#0b1726]/80 border border-slate-800/60 backdrop-blur-sm text-center">
            <div class="font-serif text-xl sm:text-3xl font-bold text-[#c9a54e]">4.9 ★</div>
            <div class="text-[10px] sm:text-[11px] uppercase tracking-wider text-slate-400 mt-0.5">Average Rating</div>
          </div>
          <div class="p-3 sm:p-4 rounded-xl bg-[#0b1726]/80 border border-slate-800/60 backdrop-blur-sm text-center">
            <div class="font-serif text-xl sm:text-3xl font-bold text-[#c9a54e]">150+</div>
            <div class="text-[10px] sm:text-[11px] uppercase tracking-wider text-slate-400 mt-0.5">Countries</div>
          </div>
          <div class="p-3 sm:p-4 rounded-xl bg-[#0b1726]/80 border border-slate-800/60 backdrop-blur-sm text-center">
            <div class="font-serif text-xl sm:text-3xl font-bold text-[#c9a54e]">10,000+</div>
            <div class="text-[10px] sm:text-[11px] uppercase tracking-wider text-slate-400 mt-0.5">Curated Experiences</div>
          </div>
        </div>

      </div>

    </section>

    <!-- 🖼️ MASTER BRAND VISUAL SHOWCASE -->
    <section id="curator" class="scroll-mt-24 py-8 sm:py-12 px-3 sm:px-6 lg:px-8 max-w-7xl mx-auto">
      <div class="relative rounded-3xl overflow-hidden border border-[#c9a54e]/30 shadow-2xl bg-gradient-to-b from-[#0b1726] to-[#040a12] p-2 sm:p-4 group">
        
        <div class="relative rounded-2xl overflow-hidden min-h-[360px] sm:min-h-[440px] md:aspect-[16/9] md:max-h-[640px] flex items-end">
          <img
            src="/media/expedia_hotels/expedia_como_passalacqua_hero_4k.webp"
            alt="Passalacqua Lake Como - Sovereign Luxury Sanctuary (Curated by Victor & Lucky)"
            class="absolute inset-0 w-full h-full object-cover object-center transform transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
          
          <!-- Subtle Gradient Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#07111e] via-[#07111e]/40 to-transparent"></div>

          <!-- Bottom Caption & Philosophy Overlay -->
          <div class="relative z-10 w-full m-2 sm:m-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-[#07111e]/85 backdrop-blur-md p-4 sm:p-6 rounded-2xl border border-slate-700/80 shadow-2xl">
            <div class="max-w-2xl">
              <div class="flex items-center gap-2 mb-2">
                <span class="text-[10px] sm:text-xs font-bold text-[#c9a54e] uppercase tracking-widest bg-[#c9a54e]/10 border border-[#c9a54e]/30 px-2.5 py-0.5 rounded-full">
                  Curator Reflection &amp; Philosophy
                </span>
                <span class="text-[10px] sm:text-xs text-amber-300 font-medium">★ Forbes Five-Star Standard</span>
              </div>
              <h3 class="font-serif text-lg sm:text-2xl font-bold text-white leading-snug">
                “Extraordinary Journeys for a Brighter Tomorrow”
              </h3>
              <p class="text-xs sm:text-sm text-slate-300 mt-1 leading-relaxed">
                Handpicked luxury sanctuaries · Verified acoustic privacy · Official Expedia Partner Network VIP rates &amp; perks.
              </p>
              <div class="flex items-center gap-3 mt-3 text-[11px] text-[#c9a54e] font-medium">
                <span>👑 Curators: Victor (Heritage Lead) &amp; Lucky (Sensory Lead)</span>
              </div>
            </div>

            <div class="flex sm:flex-col items-center sm:items-end justify-between w-full sm:w-auto gap-3 pt-3 sm:pt-0 border-t sm:border-t-0 border-slate-800 shrink-0">
              <div class="flex items-center gap-2">
                <span class="text-xs text-slate-300 font-medium">Verified Curation</span>
                <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
              </div>
              <a
                href="#experiences"
                class="inline-flex items-center space-x-1 px-4 py-2 rounded-xl bg-[#c9a54e] hover:bg-[#d8b560] text-slate-950 font-bold text-xs transition shadow-lg shadow-[#c9a54e]/20"
              >
                <span>Explore Stays</span>
                <span>↓</span>
              </a>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- 💎 10 GOLD LIST FLAGSHIP DESTINATIONS -->
    <div id="destinations" class="scroll-mt-24"></div>
    <section id="experiences" class="scroll-mt-24 py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
        <div>
          <span class="text-xs font-bold text-[#c9a54e] uppercase tracking-[0.2em] block mb-2">
            The 2026 Sovereign Stays Collection
          </span>
          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white tracking-tight">
            Curated 5-Star Sanctuaries of a Lifetime
          </h2>
        </div>
        <p class="text-sm text-slate-400 max-w-md">
          Every sanctuary is rigorously audited for Forbes Five-Star excellence, verified acoustic privacy, and direct live rates via Expedia Partner Network.
        </p>
      </div>

      <!-- Empty Search State -->
      <div id="no-search-results-msg" style="display: none;" class="text-center py-16 px-4 bg-[#0b1726]/60 border border-slate-800 rounded-3xl mb-8">
        <span class="text-4xl mb-3 block">🔍</span>
        <h3 class="font-serif text-xl font-bold text-white mb-2">No Matching Luxury Sanctuaries Found</h3>
        <p class="text-xs text-slate-400 max-w-md mx-auto">
          Try searching for "Paris", "Rome", "Kyoto", "Maldives", or click "All Destinations" above to view our complete collection.
        </p>
      </div>

      <!-- Destination Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="destinations-grid-container">
        {destinationsData.map((dest) => (
          <DestinationCard
            title={dest.english_title}
            slug={dest.slugs.en}
            location={dest.location}
            image={dest.hero_image}
            rating={dest.rating}
            price={dest.price_display}
            expediaLink={(dest as any).expedia_direct_link}
            locale="en"
            region={(dest as any).region || (dest.location.includes('Japan') ? 'Asia' : dest.location.includes('Maldives') ? 'Islands' : dest.location.includes('Serengeti') ? 'Safari' : dest.location.includes('Dubai') ? 'Middle East' : 'Europe')}
            category="5-Star Luxury Stay"
          />
        ))}
      </div>

    </section>

    <!-- 🌟 VALUE PROPOSITION: THE SOVEREIGN STANDARD -->
    <section class="py-16 bg-[#040a12] border-t border-b border-slate-800/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <span class="text-xs font-bold text-[#c9a54e] uppercase tracking-[0.2em] block mb-2">
            The Sovereign Standard
          </span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-white tracking-tight">
            Why Reserve Through Verified Expedia Partner Links?
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="p-6 rounded-2xl bg-[#07111e] border border-slate-800">
            <div class="w-10 h-10 rounded-xl bg-[#c9a54e]/10 border border-[#c9a54e]/30 flex items-center justify-center text-xl mb-4">
              👑
            </div>
            <h3 class="font-serif text-lg font-bold text-white mb-2">Elite VIP Amenities</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Complimentary daily gourmet breakfast for two, priority room upgrades upon arrival (subject to availability), and exclusive on-property credits at world-renowned spas.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-[#07111e] border border-slate-800">
            <div class="w-10 h-10 rounded-xl bg-[#c9a54e]/10 border border-[#c9a54e]/30 flex items-center justify-center text-xl mb-4">
              🛡️
            </div>
            <h3 class="font-serif text-lg font-bold text-white mb-2">Live Availability & Rate Parity</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Direct integration with Expedia Group inventory guarantees real-time room availability, official member rates, and transparent pricing with zero surprise fees.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-[#07111e] border border-slate-800">
            <div class="w-10 h-10 rounded-xl bg-[#c9a54e]/10 border border-[#c9a54e]/30 flex items-center justify-center text-xl mb-4">
              🤝
            </div>
            <h3 class="font-serif text-lg font-bold text-white mb-2">Flexible Cancellation Protection</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Travel with peace of mind. Access flexible cancellation windows and 24/7 dedicated guest support across international time zones.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ❓ FAQ SECTION FOR SEARCH ENGINES & AI CRAWLERS (MATCHING SCHEMA) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <span class="text-xs font-bold text-[#c9a54e] uppercase tracking-[0.2em] block mb-2">
          Concierge Guidance
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white tracking-tight">
          Frequently Asked Questions
        </h2>
        <p class="text-xs text-slate-400 mt-2">
          Everything discerning travelers need to know about booking with Travel4U and Expedia Partner Network.
        </p>
      </div>

      <div class="space-y-4">
        <details class="group bg-[#0b1726] border border-slate-800 rounded-2xl p-6 [&_summary::-webkit-details-marker]:none cursor-pointer">
          <summary class="flex items-center justify-between font-serif text-base sm:text-lg font-semibold text-white">
            <span>What makes Travel4U luxury stays different from standard booking sites?</span>
            <span class="ml-4 text-[#c9a54e] transition-transform duration-300 group-open:rotate-180">▼</span>
          </summary>
          <p class="mt-4 text-xs sm:text-sm text-slate-400 leading-relaxed">
            Travel4U is an intimate luxury curation platform led by founders Victor & Lucky. Every property is audited for sensory acoustic privacy, Forbes Five-Star standards, Michelin gastronomy, and verified VIP perks powered directly by Expedia Partner Network.
          </p>
        </details>

        <details class="group bg-[#0b1726] border border-slate-800 rounded-2xl p-6 [&_summary::-webkit-details-marker]:none cursor-pointer">
          <summary class="flex items-center justify-between font-serif text-base sm:text-lg font-semibold text-white">
            <span>How do Victor & Lucky curate each 5-star hotel in the collection?</span>
            <span class="ml-4 text-[#c9a54e] transition-transform duration-300 group-open:rotate-180">▼</span>
          </summary>
          <p class="mt-4 text-xs sm:text-sm text-slate-400 leading-relaxed">
            Victor and Lucky evaluate each stay through a 4-point emotional formula: 1 positive emotion, 1 core concern resolved (such as complete soundproofing and discreet butler service), 1 ideal guest persona, and an unforgettable 'WOA' climax that inspires guests to return annually.
          </p>
        </details>

        <details class="group bg-[#0b1726] border border-slate-800 rounded-2xl p-6 [&_summary::-webkit-details-marker]:none cursor-pointer">
          <summary class="flex items-center justify-between font-serif text-base sm:text-lg font-semibold text-white">
            <span>What VIP perks do I receive when reserving via Travel4U's Expedia partnership?</span>
            <span class="ml-4 text-[#c9a54e] transition-transform duration-300 group-open:rotate-180">▼</span>
          </summary>
          <p class="mt-4 text-xs sm:text-sm text-slate-400 leading-relaxed">
            Guests booking through our verified Expedia partner links enjoy official member rate parity, complimentary gourmet daily breakfast for two, priority room upgrades upon arrival (subject to availability), and exclusive on-property spa credits.
          </p>
        </details>

        <details class="group bg-[#0b1726] border border-slate-800 rounded-2xl p-6 [&_summary::-webkit-details-marker]:none cursor-pointer">
          <summary class="flex items-center justify-between font-serif text-base sm:text-lg font-semibold text-white">
            <span>Are reservation cancellations flexible and transparent?</span>
            <span class="ml-4 text-[#c9a54e] transition-transform duration-300 group-open:rotate-180">▼</span>
          </summary>
          <p class="mt-4 text-xs sm:text-sm text-slate-400 leading-relaxed">
            Yes. Every booking is managed directly on Expedia Group's secure global infrastructure, offering transparent room policies, flexible cancellation windows, and 24/7 dedicated guest protection.
          </p>
        </details>

        <details class="group bg-[#0b1726] border border-slate-800 rounded-2xl p-6 [&_summary::-webkit-details-marker]:none cursor-pointer">
          <summary class="flex items-center justify-between font-serif text-base sm:text-lg font-semibold text-white">
            <span>How does Travel4U utilize AI in luxury travel planning?</span>
            <span class="ml-4 text-[#c9a54e] transition-transform duration-300 group-open:rotate-180">▼</span>
          </summary>
          <p class="mt-4 text-xs sm:text-sm text-slate-400 leading-relaxed">
            Travel4U pairs high-touch human curation with intelligent search indexing to deliver 60 FPS real-time availability filtering, multi-locale cultural adaptation across 12 languages, and custom sensory recommendations.
          </p>
        </details>
      </div>
    </section>

  </main>

  <Footer currentLocale="en" />
</Layout>

<style>
  /* ═══════════════════════════════════════════════════════════════
     ✨ LUXURY NEON GOLD GLOW — Hero Headline Animation
     Breathing gold text-shadow pulse + shimmer sweep
     Design: Dark Obsidian #07111e bg × Gold #c9a54e accent
     ═══════════════════════════════════════════════════════════════ */

  .luxury-neon-headline {
    color: #f0e6d3;
    text-shadow:
      0 0 7px rgba(201, 165, 78, 0.5),
      0 0 20px rgba(201, 165, 78, 0.3),
      0 0 42px rgba(201, 165, 78, 0.15),
      0 0 80px rgba(201, 165, 78, 0.07);
    background-image: linear-gradient(
      90deg,
      #f0e6d3 0%,
      #c9a54e 25%,
      #dfba63 50%,
      #c9a54e 75%,
      #f0e6d3 100%
    );
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: neonBreath 4s ease-in-out infinite, shimmerSweep 6s linear infinite;
  }

  /* "Intelligently Crafted" gradient span — enhanced neon variant */
  .luxury-neon-gradient {
    background-image: linear-gradient(
      90deg,
      #c9a54e 0%,
      #dfba63 30%,
      #ff7043 60%,
      #dfba63 80%,
      #c9a54e 100%
    );
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shimmerSweep 5s linear infinite;
  }

