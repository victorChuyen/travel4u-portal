---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ActionBar from '../../../components/ActionBar.astro';
import CuratorSignatureBox from '../../../components/CuratorSignatureBox.astro';
import PodcastAudioBar from '../../../components/PodcastAudioBar.astro';
import SensoryLuxuryHooks from '../../../components/SensoryLuxuryHooks.astro';
import CuratorDuoNotes from '../../../components/CuratorDuoNotes.astro';
import EmotionalWoaCallout from '../../../components/EmotionalWoaCallout.astro';
import ExpediaPerksCallout from '../../../components/ExpediaPerksCallout.astro';
import PodcastDialogueSection from '../../../components/PodcastDialogueSection.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import RelatedSanctuaries from '../../../components/RelatedSanctuaries.astro';
import SanctuaryNav from '../../../components/SanctuaryNav.astro';
import fs from 'node:fs';
import path from 'node:path';
import destinationsData from '../../../data/destinations.json';
import i18nData from '../../../data/i18n.json';

export async function getStaticPaths() {
  const articlesData = JSON.parse(fs.readFileSync(path.resolve('./src/data/articles.json'), 'utf-8'));
  const nonEnArticles = (articlesData as any[]).filter(art => art.locale !== 'en');
  return nonEnArticles.map(article => ({
    params: { locale: article.locale, slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;
const locale = article.locale;
const t = (i18nData as any)[locale] || (i18nData as any)['en'];

const currentDest = (destinationsData as any[]).find(d => Object.values(d.slugs).includes(article.slug)) || destinationsData[0];
const hotelCleanName = currentDest?.english_title ? currentDest.english_title.split(':')[0].trim() : article.title;
const alternateUrls: Record<string, string> = {};
for (const [loc, slug] of Object.entries(currentDest.slugs as Record<string, string>)) {
  alternateUrls[loc] = loc === 'en' ? `https://travel4u.us/experience/${slug}/` : `https://travel4u.us/${loc}/experience/${slug}/`;
}
alternateUrls['x-default'] = `https://travel4u.us/experience/${currentDest.slugs.en}/`;
const canonicalUrl = `https://travel4u.us/${locale}/experience/${article.slug}/`;

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Hotel",
      "@id": `https://travel4u.us/${locale}/experience/${article.slug}/#hotel`,
      "name": article.title,
      "description": article.excerpt,
      "image": `https://travel4u.us${article.hero_image?.url}`,
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "3800"
      },
      "priceRange": "$$$$"
    },
    {
      "@type": "Review",
      "itemReviewed": {
        "@type": "Hotel",
        "name": article.title
      },
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "5"
      },
      "author": {
        "@type": "Organization",
        "name": "Luxury Travel4U - Victor & Lucky"
      },
      "reviewBody": article.excerpt
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": `https://travel4u.us/${locale}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": article.location,
          "item": `https://travel4u.us/${locale}/#experiences`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": article.title,
          "item": `https://travel4u.us/${locale}/experience/${article.slug}/`
        }
      ]
    }
  ]
};
---

<Layout
  title={`${article.title} | Victor & Lucky Luxury Diary`}
  description={article.excerpt}
  locale={locale}
  image={article.hero_image?.url}
  canonicalUrl={canonicalUrl}
  alternateUrls={alternateUrls}
  type="article"
  schema={schemaData}
>
  <Header currentLocale={locale} alternateUrls={alternateUrls} />

  <main class="flex-grow pb-24">
    <!-- 🧭 Visual Clickable Breadcrumbs -->
    <Breadcrumbs currentTitle={article.title} locale={locale} />
    
    <!-- Hero Article Header -->
    <header class="relative py-20 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-[#0b1726] to-[#07111e] border-b border-slate-800">
      <div class="max-w-4xl mx-auto text-center">
        
        <div class="inline-flex items-center space-x-2 text-xs font-bold text-[#c9a54e] uppercase tracking-widest bg-[#c9a54e]/10 border border-[#c9a54e]/30 px-4 py-1.5 rounded-full mb-6">
          <span>👑</span>
          <span>Victor & Lucky Curated Diary</span>
          <span class="text-slate-500">•</span>
          <span>📍 {article.location}</span>
        </div>

        <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-white leading-tight mb-6">
          {article.title}
        </h1>

        <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-3xl mx-auto mb-8 font-serif italic">
          "{article.excerpt}"
        </p>

        <!-- CTA Bar -->
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href={article.affiliate?.expedia_cloaked_path || `/go/${article.slug}`}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="bg-gradient-to-r from-[#c9a54e] to-[#dfba63] hover:from-[#dfba63] hover:to-[#eed07e] text-[#07111e] font-bold text-sm uppercase tracking-wider px-8 py-3.5 rounded-xl shadow-lg shadow-[#c9a54e]/25 transition-all duration-300"
          >
            {t.exp_check_rates_btn || "Check Live Rates via Expedia Partner Network →"}
          </a>
          <span class="text-xs text-slate-400 flex items-center space-x-1">
            <span class="text-emerald-400 font-bold">✓</span>
            <span>{t.exp_vip_breakfast_badge || "VIP Breakfast & Upgrade Perks"}</span>
          </span>
        </div>

      </div>
    </header>

    <!-- Main Editorial Content -->
    <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
      
      <!-- Action Bar: Bookmark, Like, Share -->
      <ActionBar
        slug={article.slug}
        title={article.title}
        locale={locale}
      />

      <!-- 👑 Curator Duo Signature & Philosophy -->
      <CuratorSignatureBox
        hotelName={hotelCleanName}
        verdictScore={article.rating_score || "9.9 / 10 Masterpiece"}
        locale={locale}
      />

      <!-- 🎙️ Audio Story / Podcast Teaser Bar -->
      <PodcastAudioBar
        episodeTitle={article.podcast_title || `Victor & Lucky: Behind the Velvet Curtain at ${hotelCleanName}`}
        duration={article.podcast_duration || "4:30"}
        locale={locale}
      />

      <!-- Feature Hero 4K Photo -->
      {article.hero_image && (
        <div class="mb-12 rounded-3xl overflow-hidden shadow-2xl border border-slate-800 relative group">
          <img
            src={article.hero_image.url}
            alt={article.title}
            class="w-full h-auto object-cover max-h-[580px] group-hover:scale-105 transition-transform duration-700"
          />
          <div class="absolute bottom-4 left-4 bg-[#07111e]/90 backdrop-blur-md px-3.5 py-1.5 rounded-full border border-slate-700 text-xs text-slate-300">
            📸 {t.exp_official_4k_badge || "Official 4K Architecture · Curated by Victor & Lucky"}
          </div>
        </div>
      )}

      <!-- 🎵🍷 Sensory Luxury Hooks: Soundscape & Gastronomy -->
      <SensoryLuxuryHooks
        soundscapeTitle={article.soundscape_title}
        soundscapeDescription={article.soundscape_description}
        soundscapeTrack={article.soundscape_track}
        gastronomyTitle={article.gastronomy_title}
        gastronomyDish={article.gastronomy_dish}
        winePairing={article.wine_pairing}
        locale={locale}
      />

      <!-- Body Content: The 6-Chapter Narrative Storytelling -->
      <div class="prose prose-invert prose-lg max-w-none prose-headings:font-serif prose-headings:text-white prose-p:text-slate-300 prose-p:leading-relaxed prose-a:text-[#c9a54e] prose-a:underline hover:prose-a:text-[#dfba63] prose-strong:text-white prose-table:border-collapse prose-th:bg-[#07111e] prose-th:text-white prose-td:border-slate-800 prose-td:text-slate-300" set:html={article.html} />

      <!-- ☕✨ Dual Reflections: Victor's Note & Lucky's Discovery -->
      <CuratorDuoNotes
        victorNote={article.victor_note}
        luckyNote={article.lucky_note}
        locale={locale}
      />

      <!-- 💎⚡ Emotional WOA Climax & High-Converting Booking Action -->
      <EmotionalWoaCallout
        positiveEmotion={article.positive_emotion}
        clientConcern={article.client_concern}
        targetPersona={article.target_persona}
        woaDeclaration={article.woa_declaration}
        bookingUrl={article.affiliate?.expedia_cloaked_path || `/go/${article.slug}`}
        hotelName={hotelCleanName}
        minPrice={article.affiliate?.price_display}
        locale={locale}
      />

      <!-- 🛡️ How We Booked with VIP Perks via Expedia Callout Box -->
      <ExpediaPerksCallout
        bookingUrl={article.affiliate?.expedia_cloaked_path || `/go/${article.slug}`}
        hotelName={hotelCleanName}
        minPrice={article.affiliate?.price_display}
        locale={locale}
      />

      <!-- 🎙️🎬 Full Podcast Dialogue Script & 3 Viral Shorts Concepts -->
      <PodcastDialogueSection
        episodeTitle={article.podcast_title}
        dialogue={article.podcast_dialogue}
        shorts={article.viral_shorts}
        locale={locale}
      />

      <!-- 🧭 Next / Previous Sanctuary Navigation -->
      <SanctuaryNav
        currentSlug={article.slug}
        locale={locale}
        destinations={destinationsData}
      />

      <!-- 👑 Sibling Sanctuaries in the 2026 Gold List -->
      <RelatedSanctuaries
        currentSlug={article.slug}
        locale={locale}
        destinations={destinationsData}
      />

    </article>

  </main>

  <Footer currentLocale={locale} />
</Layout>
