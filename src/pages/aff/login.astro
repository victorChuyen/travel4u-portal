      verifStep2: "Tìm thư từ <strong>Travel4U / Firebase</strong> (kiểm tra cả mục <strong>Spam / Thư rác</strong> nếu không thấy ở Hộp thư đến).",
      verifStep3: "Bấm vào liên kết xác nhận để hoàn tất kích hoạt tài khoản.",
      btnResendVerif: "Gửi lại email xác thực",
      btnBackSignin: "Tôi đã xác nhận → Đăng nhập",
      // Alerts & Errors
      errFillAll: "Vui lòng điền đầy đủ Email và Mật khẩu.",
