---
/**
 * 🏛️ TRAVEL4U — CỔNG ĐĂNG KÝ & ĐĂNG NHẬP VIP MEMBER / AFFILIATE PARTNER
 * Chuẩn SaaS Quốc Tế (Google 1-Tap + Email Verification Gateway + Eye Password Toggle)
 * Authors: Chairman Victor Chuyen & AI CEO Lucky
 */

import Layout from '../../layouts/Layout.astro';
import { firebaseConfig } from '../../lib/firebaseClient';

const pageTitle = "Cổng Đăng Nhập & Đăng Ký VIP Member | Travel4U Sovereign Portal";
const pageDescription = "Đăng nhập hoặc đăng ký thành viên VIP / Đối tác Affiliate nhận hoa hồng 10% - 20% - 30% trực tiếp trên mạng lưới Travel4U.";
---

<Layout title={pageTitle} description={pageDescription} locale="vi">
  <main
    id="auth-container"
    data-config={JSON.stringify(firebaseConfig)}
    class="min-h-screen bg-[#07111e] flex items-center justify-center px-4 py-12 relative overflow-hidden"
  >
    
    <!-- Ambient Gold & Navy Glow -->
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-[#c9a54e]/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-md rounded-3xl border border-[#c9a54e]/40 bg-gradient-to-b from-[#0d1c31] via-[#091424] to-[#060c16] p-6 sm:p-8 shadow-2xl relative z-10">
      
      <!-- Top Navigation -->
      <div class="mb-6 flex items-center justify-between">
        <a href="/" class="inline-flex items-center text-xs font-semibold text-slate-400 hover:text-[#c9a54e] transition-colors group">
          <span class="mr-1.5 transition-transform group-hover:-translate-x-1">←</span>
          <span>Trang Chủ Travel4U</span>
        </a>
        <a href="/pricing" class="inline-flex items-center text-xs font-bold text-amber-400 hover:text-amber-300 transition-colors">
          <span>⚡ Bảng Giá 3 Gói AI</span>
        </a>
      </div>

      <!-- Brand Header -->
      <div class="text-center mb-6">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-[11px] font-bold uppercase tracking-wider mb-2">
          <span>👑 TRAVEL4U VIP MEMBER & AFFILIATE GATEWAY</span>
        </div>
        <h1 class="font-serif text-2xl sm:text-3xl font-bold text-white tracking-tight">
          Cổng Thành Viên VIP
        </h1>
        <p class="text-xs text-slate-300 mt-1.5">
          Đăng nhập để quản lý mã giới thiệu, theo dõi hoa hồng <strong class="text-amber-400">10% - 20% - 30%</strong> và rút tiền 24/7.
        </p>
      </div>

      <!-- 1-TAP GOOGLE SIGN IN BUTTON (TOP PRIORITY) -->
      <div id="google-signin-wrapper" class="mb-5">
        <button
          type="button"
          id="btn-google-login"
          class="w-full py-3 px-4 rounded-xl bg-white hover:bg-slate-100 text-slate-900 font-bold text-xs sm:text-sm flex items-center justify-center gap-3 transition shadow-lg hover:shadow-xl cursor-pointer active:scale-[0.99]"
        >
          <!-- Official Google "G" SVG Icon -->
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
          <span id="btn-google-text">Đăng nhập 1-Chạm với Google</span>
        </button>
      </div>

      <!-- Divider -->
      <div id="auth-divider" class="flex items-center my-4">
        <div class="flex-grow border-t border-slate-700/80"></div>
        <span class="px-3 text-[11px] text-slate-400 uppercase tracking-wider font-semibold">hoặc email</span>
        <div class="flex-grow border-t border-slate-700/80"></div>
      </div>

      <!-- Auth Tabs: Đăng Nhập vs Đăng Ký Mới -->
      <div id="auth-tabs-wrapper" class="flex rounded-xl bg-slate-950 p-1 mb-4 border border-slate-800 text-xs font-bold">
        <button
          type="button"
          id="tab-signin"
          class="flex-1 py-2 rounded-lg text-center transition bg-[#c9a54e] text-slate-950 shadow cursor-pointer"
        >
          Đăng Nhập
        </button>
        <button
          type="button"
          id="tab-signup"
          class="flex-1 py-2 rounded-lg text-center transition text-slate-400 hover:text-white cursor-pointer"
        >
          Đăng Ký Mới
        </button>
      </div>

      <!-- Form Error / Status Message -->
      <div id="auth-status-box" class="hidden mb-4 p-3 rounded-xl text-xs font-semibold leading-relaxed"></div>

      <!-- EMAIL VERIFICATION PENDING SCREEN (Hidden by default) -->
      <div id="verification-notice-view" class="hidden space-y-4 p-5 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-slate-200">
        <div class="flex items-center space-x-2 text-amber-400 font-bold text-sm">
          <span class="text-xl">✉️</span>
          <span>XÁC NHẬN EMAIL ĐỂ KÍCH HOẠT TÀI KHOẢN VIP</span>
        </div>
        <p class="text-xs text-slate-300 leading-relaxed">
          Chúng tôi đã gửi một liên kết xác thực tới: <strong id="verification-target-email" class="text-white underline"></strong>.
        </p>
        <div class="p-3 bg-slate-950/80 rounded-xl border border-slate-800 text-[11px] text-slate-400 space-y-1.5">
          <p class="flex items-start space-x-1.5">
            <span class="text-amber-400 font-bold">1.</span>
            <span>Mở ứng dụng Email của bạn (Gmail, Outlook, v.v.).</span>
          </p>
          <p class="flex items-start space-x-1.5">
            <span class="text-amber-400 font-bold">2.</span>
            <span>Tìm thư từ <strong>Travel4U / Firebase</strong> (kiểm tra cả mục <strong>Spam / Thư rác</strong> nếu không thấy ở Hộp thư đến).</span>
          </p>
          <p class="flex items-start space-x-1.5">
            <span class="text-amber-400 font-bold">3.</span>
            <span>Bấm vào liên kết xác nhận để hoàn tất kích hoạt tài khoản.</span>
          </p>
        </div>

        <div class="pt-2 flex flex-col sm:flex-row gap-2.5">
          <button
            type="button"
            id="btn-resend-verification"
            class="flex-1 py-2.5 px-3 bg-slate-900 hover:bg-slate-800 border border-slate-700 hover:border-amber-400 text-slate-200 text-xs font-semibold rounded-xl transition flex items-center justify-center space-x-1.5 cursor-pointer"
          >
            <span>🔄</span>
            <span id="btn-resend-text">Gửi lại email xác thực</span>
          </button>
          <button
            type="button"
            id="btn-back-to-signin"
            class="flex-1 py-2.5 px-3 bg-[#c9a54e] hover:bg-[#dfba63] text-slate-950 text-xs font-bold rounded-xl transition flex items-center justify-center space-x-1.5 cursor-pointer shadow"
          >
            <span>🔑</span>
            <span>Tôi đã xác nhận → Đăng nhập</span>
          </button>
        </div>
      </div>

      <!-- Email / Password Form Wrapper -->
      <div id="auth-form-wrapper">
        <form id="auth-form" class="space-y-3.5" novalidate>
          
          <!-- Full Name (Only for Registration) -->
          <div id="field-fullname" class="hidden">
            <label for="auth-fullname" class="block text-xs font-semibold text-slate-300 uppercase mb-1">
              Họ và tên của bạn *
            </label>
            <input
              id="auth-fullname"
              type="text"
              placeholder="Ví dụ: Victor Chuyen"
              class="w-full rounded-xl border border-slate-700 bg-slate-950/80 px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 transition"
            />
          </div>

          <!-- Email Field -->
          <div>
            <label for="auth-email" class="block text-xs font-semibold text-slate-300 uppercase mb-1">
              Địa chỉ Email *
            </label>
            <input
              id="auth-email"
              type="email"
              required
              autocomplete="email"
              inputmode="email"
              autocapitalize="none"
              spellcheck="false"
              placeholder="name@example.com"
              class="w-full rounded-xl border border-slate-700 bg-slate-950/80 px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 transition"
            />
          </div>

          <!-- Password Field with Show/Hide Eye Toggle -->
          <div>
            <div class="flex items-center justify-between mb-1">
              <label for="auth-password" class="block text-xs font-semibold text-slate-300 uppercase">
                Mật khẩu (tối thiểu 6 ký tự) *
              </label>
              <button
                type="button"
                id="btn-forgot-password"
                class="text-[11px] text-amber-400 hover:underline cursor-pointer"
              >
                Quên mật khẩu?
              </button>
            </div>
            <div class="relative">
              <input
                id="auth-password"
                type="password"
                required
                minlength="6"
                placeholder="Nhập mật khẩu..."
                class="w-full rounded-xl border border-slate-700 bg-slate-950/80 pl-4 pr-11 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 transition"
              />
              <!-- Eye Toggle Button -->
              <button
                type="button"
                id="btn-toggle-pwd"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-[#c9a54e] focus:outline-none transition p-1 cursor-pointer"
                title="Hiện / Ẩn mật khẩu"
                aria-label="Toggle password visibility"
              >
                <!-- Eye Open Icon -->
                <svg class="icon-eye w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <!-- Eye Slash Icon (Hidden by default) -->
                <svg class="icon-eye-slash w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Confirm Password Field (Only for Registration) with Eye Toggle -->
          <div id="field-confirm-pwd" class="hidden">
            <label for="auth-confirm-pwd" class="block text-xs font-semibold text-slate-300 uppercase mb-1">
              Xác nhận mật khẩu *
            </label>
            <div class="relative">
              <input
                id="auth-confirm-pwd"
                type="password"
                minlength="6"
                placeholder="Nhập lại mật khẩu..."
                class="w-full rounded-xl border border-slate-700 bg-slate-950/80 pl-4 pr-11 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 transition"
              />
              <!-- Eye Toggle Button -->
              <button
                type="button"
                id="btn-toggle-confirm-pwd"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-[#c9a54e] focus:outline-none transition p-1 cursor-pointer"
                title="Hiện / Ẩn mật khẩu"
                aria-label="Toggle confirm password visibility"
              >
                <!-- Eye Open Icon -->
                <svg class="icon-eye w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <!-- Eye Slash Icon (Hidden by default) -->
                <svg class="icon-eye-slash w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                </svg>
              </button>
            </div>
            <p id="pwd-match-error" class="hidden text-[11px] text-rose-400 mt-1">
              ⚠️ Mật khẩu xác nhận không trùng khớp.
            </p>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            id="btn-submit-auth"
            class="w-full py-3 px-6 rounded-xl bg-gradient-to-r from-amber-500 via-[#c9a54e] to-amber-600 hover:from-amber-400 hover:to-amber-500 active:scale-[0.99] text-slate-950 font-black text-sm transition shadow-xl shadow-amber-500/20 flex items-center justify-center gap-2 cursor-pointer mt-2"
          >
            <span id="btn-submit-text">ĐĂNG NHẬP VIP NGAY</span>
            <span id="btn-submit-arrow">→</span>
            <span id="btn-submit-spinner" class="hidden animate-spin">
              <svg class="w-4 h-4 text-slate-950" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </span>
          </button>
        </form>
      </div>

      <!-- Footer Trust Badge -->
      <div class="mt-6 pt-4 border-t border-slate-800/80 text-center text-xs text-slate-400 space-y-1">
        <p class="flex items-center justify-center space-x-1.5 text-slate-300">
          <span class="text-[#c9a54e]">🔒</span>
          <span>Bảo mật dữ liệu tiêu chuẩn 256-bit SSL · Tuyệt đối an toàn</span>
        </p>
        <p class="text-slate-500 text-[11px]">Hệ thống tự động kích hoạt mã định danh và bảng điều khiển độc quyền sau khi đăng nhập.</p>
      </div>

    </div>
  </main>
</Layout>

<!-- PURE ES6 CLIENT MODULE SCRIPT (100% BROWSER COMPLIANT — NO ASTRO CLOSURE BUG) -->
<script type="module">
  import { initializeApp, getApps, getApp } from 'https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js';
  import {
    getAuth,
    signInWithPopup,
    GoogleAuthProvider,
    signInWithEmailAndPassword,
    createUserWithEmailAndPassword,
    sendPasswordResetEmail,
    sendEmailVerification,
    updateProfile,
    signOut,
    onAuthStateChanged
  } from 'https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js';

  // 1. Initialize Firebase App via DOM attribute
  const container = document.getElementById('auth-container');
  let firebaseConfig = {};
  try {
    firebaseConfig = JSON.parse(container.getAttribute('data-config') || '{}');
  } catch (e) {
    console.error('Failed to parse firebase config from DOM:', e);
  }

  const app = getApps().length > 0 ? getApp() : initializeApp(firebaseConfig);
  const auth = getAuth(app);
  const googleProvider = new GoogleAuthProvider();
  googleProvider.setCustomParameters({ prompt: 'select_account' });

  // UI Elements
  const tabSignin = document.getElementById('tab-signin');
  const tabSignup = document.getElementById('tab-signup');
  const fieldFullname = document.getElementById('field-fullname');
  const fieldConfirmPwd = document.getElementById('field-confirm-pwd');
  const authFormWrapper = document.getElementById('auth-form-wrapper');
  const authForm = document.getElementById('auth-form');
  const authEmail = document.getElementById('auth-email');
  const authPassword = document.getElementById('auth-password');
  const authConfirmPwd = document.getElementById('auth-confirm-pwd');
  const authFullname = document.getElementById('auth-fullname');
  const pwdMatchError = document.getElementById('pwd-match-error');

  const btnSubmitAuth = document.getElementById('btn-submit-auth');
  const btnSubmitText = document.getElementById('btn-submit-text');
  const btnSubmitArrow = document.getElementById('btn-submit-arrow');
  const btnSubmitSpinner = document.getElementById('btn-submit-spinner');

  const btnGoogleLogin = document.getElementById('btn-google-login');
  const btnGoogleText = document.getElementById('btn-google-text');
  const btnForgotPassword = document.getElementById('btn-forgot-password');
  const statusBox = document.getElementById('auth-status-box');

  const verificationNoticeView = document.getElementById('verification-notice-view');
  const verificationTargetEmail = document.getElementById('verification-target-email');
  const btnResendVerification = document.getElementById('btn-resend-verification');
  const btnResendText = document.getElementById('btn-resend-text');
  const btnBackToSignin = document.getElementById('btn-back-to-signin');

  let currentMode = 'signin'; // 'signin' | 'signup'
  let lastRegisteredUser = null;

  // Eye toggle helper
  function setupPasswordToggle(inputEl, btnEl) {
    if (!inputEl || !btnEl) return;
    btnEl.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const isPassword = inputEl.type === 'password';
      inputEl.type = isPassword ? 'text' : 'password';

      const iconEye = btnEl.querySelector('.icon-eye');
      const iconEyeSlash = btnEl.querySelector('.icon-eye-slash');
      if (iconEye && iconEyeSlash) {
        if (isPassword) {
          iconEye.classList.add('hidden');
          iconEyeSlash.classList.remove('hidden');
        } else {
          iconEye.classList.remove('hidden');
          iconEyeSlash.classList.add('hidden');
        }
      }
      inputEl.focus();
    });
  }

  setupPasswordToggle(authPassword, document.getElementById('btn-toggle-pwd'));
  setupPasswordToggle(authConfirmPwd, document.getElementById('btn-toggle-confirm-pwd'));

  function showStatus(msg, isError = false) {
    if (!statusBox) return;
    statusBox.innerHTML = msg;
    statusBox.classList.remove('hidden', 'bg-red-500/20', 'text-red-300', 'border-red-500/40', 'bg-emerald-500/20', 'text-emerald-300', 'border-emerald-500/40', 'bg-amber-500/20', 'text-amber-300', 'border-amber-500/40');
    if (isError) {
      statusBox.classList.add('bg-red-500/20', 'text-red-300', 'border', 'border-red-500/40');
    } else {
      statusBox.classList.add('bg-emerald-500/20', 'text-emerald-300', 'border', 'border-emerald-500/40');
    }
  }

  function setMode(mode) {
    currentMode = mode;
    statusBox?.classList.add('hidden');
    pwdMatchError?.classList.add('hidden');

    if (mode === 'signin') {
      tabSignin.classList.add('bg-[#c9a54e]', 'text-slate-950', 'shadow');
      tabSignin.classList.remove('text-slate-400');
      tabSignup.classList.remove('bg-[#c9a54e]', 'text-slate-950', 'shadow');
      tabSignup.classList.add('text-slate-400');

      fieldFullname.classList.add('hidden');
      fieldConfirmPwd.classList.add('hidden');
      authFullname.removeAttribute('required');
      authConfirmPwd.removeAttribute('required');
      btnForgotPassword.classList.remove('hidden');
      btnSubmitText.textContent = 'ĐĂNG NHẬP VIP NGAY';
    } else {
      tabSignup.classList.add('bg-[#c9a54e]', 'text-slate-950', 'shadow');
      tabSignup.classList.remove('text-slate-400');
      tabSignin.classList.remove('bg-[#c9a54e]', 'text-slate-950', 'shadow');
      tabSignin.classList.add('text-slate-400');

      fieldFullname.classList.remove('hidden');
      fieldConfirmPwd.classList.remove('hidden');
      authFullname.setAttribute('required', 'true');
      authConfirmPwd.setAttribute('required', 'true');
      btnForgotPassword.classList.add('hidden');
      btnSubmitText.textContent = 'ĐĂNG KÝ THÀNH VIÊN VIP';
    }
  }

  tabSignin?.addEventListener('click', () => {
    verificationNoticeView?.classList.add('hidden');
    authFormWrapper?.classList.remove('hidden');
    setMode('signin');
  });

  tabSignup?.addEventListener('click', () => {
    verificationNoticeView?.classList.add('hidden');
    authFormWrapper?.classList.remove('hidden');
    setMode('signup');
  });

  // Password confirmation check on input
  function checkPasswordMatch() {
    if (currentMode !== 'signup') return true;
    const p1 = authPassword.value;
    const p2 = authConfirmPwd.value;
    if (p2 && p1 !== p2) {
      pwdMatchError?.classList.remove('hidden');
      authConfirmPwd.classList.add('border-rose-500');
      return false;
    } else {
      pwdMatchError?.classList.add('hidden');
      authConfirmPwd.classList.remove('border-rose-500');
      return true;
    }
  }

  authConfirmPwd?.addEventListener('input', checkPasswordMatch);
  authPassword?.addEventListener('input', () => {
    if (authConfirmPwd?.value) checkPasswordMatch();
  });

  function handleAuthSuccess(user) {
    const displayName = user.displayName || user.email?.split('@')[0] || 'VIP Member';
    const refBase = displayName.replace(/[^a-zA-Z0-9]/g, '').toUpperCase().slice(0, 8) || 'VIP';
    const refCode = `${refBase}88`;

    const vipUser = {
      uid: user.uid,
      email: user.email,
      displayName,
      photoURL: user.photoURL,
      emailVerified: user.emailVerified,
      tier: 'tier_02',
      commissionRate: 0.20,
      refCode
    };

    localStorage.setItem('t4u_vip_user', JSON.stringify(vipUser));
    localStorage.setItem('t4u_partner_name', displayName);
    localStorage.setItem('t4u_partner_ref', refCode);

    showStatus('✨ Đăng nhập thành công! Đang chuyển hướng vào Bảng điều khiển đối tác...', false);
    setTimeout(() => {
      window.location.href = '/aff/';
    }, 800);
  }

  // 1. Google 1-Tap Login
  btnGoogleLogin?.addEventListener('click', async () => {
    try {
      btnGoogleLogin.setAttribute('disabled', 'true');
      btnGoogleLogin.classList.add('opacity-75');
      if (btnGoogleText) btnGoogleText.textContent = 'Đang mở cửa sổ Google...';
      showStatus('Đang kết nối xác thực tài khoản Google...', false);

      const result = await signInWithPopup(auth, googleProvider);
      handleAuthSuccess(result.user);
    } catch (err) {
      console.error('Google Auth error:', err);
      showStatus('Không thể hoàn tất đăng nhập Google: ' + (err.message || 'Vui lòng thử lại.'), true);
    } finally {
      btnGoogleLogin.removeAttribute('disabled');
      btnGoogleLogin.classList.remove('opacity-75');
      if (btnGoogleText) btnGoogleText.textContent = 'Đăng nhập 1-Chạm với Google';
    }
  });

  // 2. Email Verification Screen
  function showVerificationView(email, user) {
    lastRegisteredUser = user;
    if (verificationTargetEmail) verificationTargetEmail.textContent = email;
    authFormWrapper?.classList.add('hidden');
    verificationNoticeView?.classList.remove('hidden');
    statusBox?.classList.add('hidden');
  }

  btnBackToSignin?.addEventListener('click', () => {
    verificationNoticeView?.classList.add('hidden');
    authFormWrapper?.classList.remove('hidden');
    setMode('signin');
    showStatus('Sau khi bấm link trong email của bạn, hãy nhập email và mật khẩu để đăng nhập.', false);
  });

  // Resend verification email
  btnResendVerification?.addEventListener('click', async () => {
    try {
      btnResendVerification.setAttribute('disabled', 'true');
      if (btnResendText) btnResendText.textContent = 'Đang gửi...';

      // If user session is active, send verification directly
      if (auth.currentUser) {
        await sendEmailVerification(auth.currentUser);
        showStatus('✅ Đã gửi lại email xác thực! Vui lòng kiểm tra hộp thư.', false);
      } else {
        // Prompt them to sign in
        showStatus('Vui lòng đăng nhập để hệ thống gửi lại email xác thực.', true);
      }
    } catch (err) {
      showStatus('Lỗi khi gửi lại email: ' + err.message, true);
    } finally {
      setTimeout(() => {
        btnResendVerification.removeAttribute('disabled');
        if (btnResendText) btnResendText.textContent = 'Gửi lại email xác thực';
      }, 5000);
    }
  });

  // 3. Form Submit (Email / Password)
  authForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = authEmail.value.trim();
    const password = authPassword.value;
    const fullName = authFullname.value.trim();
    const confirmPwd = authConfirmPwd.value;

    if (!email || !password) {
      showStatus('Vui lòng điền đầy đủ Email và Mật khẩu.', true);
      return;
    }

    if (currentMode === 'signup') {
      if (!fullName) {
        showStatus('Vui lòng nhập Họ và tên của bạn.', true);
        authFullname.focus();
        return;
      }
      if (password !== confirmPwd) {
        showStatus('Mật khẩu xác nhận không trùng khớp. Vui lòng kiểm tra lại.', true);
        authConfirmPwd.focus();
        return;
      }
    }

    // Set Loading State
    btnSubmitAuth.setAttribute('disabled', 'true');
    btnSubmitAuth.classList.add('opacity-75', 'cursor-not-allowed');
    btnSubmitArrow?.classList.add('hidden');
    btnSubmitSpinner?.classList.remove('hidden');
    btnSubmitText.textContent = currentMode === 'signup' ? 'Đang tạo tài khoản...' : 'Đang đăng nhập...';

    try {
      if (currentMode === 'signup') {
        // Create user in Firebase Auth
        const userCredential = await createUserWithEmailAndPassword(auth, email, password);
        const user = userCredential.user;

        // Update displayName
        if (fullName) {
          await updateProfile(user, { displayName: fullName });
        }

        // Send Email Verification
        try {
          await sendEmailVerification(user);
        } catch (verErr) {
          console.warn('Verification email dispatch warning:', verErr);
        }

        // Sign out temporarily so they must verify email to sign in
        await signOut(auth);

        // Show standard Verification Dispatch screen
        showVerificationView(email, user);

      } else {
        // Sign in with email and password
        const userCredential = await signInWithEmailAndPassword(auth, email, password);
        const user = userCredential.user;

        // Check if email is verified (Allow admin bypass)
        const isSuperAdmin = email === 'coach.chuyen@gmail.com' || email === 'victorchuyen68@gmail.com';
        
        if (user.emailVerified || isSuperAdmin) {
          handleAuthSuccess(user);
        } else {
          // Email not verified -> Show friendly alert with resend option
          showStatus(`
            <div class="space-y-2">
              <p>⚠️ <strong>Email chưa được xác thực:</strong> Tài khoản của bạn cần xác nhận email trước khi đăng nhập.</p>
              <p class="text-[11px] text-slate-300">Vui lòng kiểm tra hộp thư hoặc bấm vào nút bên dưới để nhận lại liên kết kích hoạt.</p>
              <button type="button" id="btn-inline-resend" class="mt-1 px-3 py-1.5 bg-[#c9a54e] text-slate-950 font-bold rounded-lg text-[11px] hover:bg-[#dfba63] transition">
                📩 Gửi lại email xác thực ngay
              </button>
            </div>
          `, true);

          // Attach inline resend listener
          document.getElementById('btn-inline-resend')?.addEventListener('click', async () => {
            try {
              await sendEmailVerification(user);
              showStatus('✅ Đã gửi lại email xác thực! Vui lòng kiểm tra hộp thư (cả mục Spam/Junk).', false);
            } catch (err) {
              showStatus('Lỗi gửi email: ' + err.message, true);
            }
          });

          // Sign out unverified session
          await signOut(auth);
        }
      }
    } catch (err) {
      console.error('Auth error:', err);
      let errorMsg = 'Đã có lỗi xảy ra. Vui lòng thử lại.';
      if (err.code === 'auth/user-not-found' || err.code === 'auth/wrong-password' || err.code === 'auth/invalid-credential') {
        errorMsg = 'Email hoặc mật khẩu không chính xác.';
      } else if (err.code === 'auth/email-already-in-use') {
        errorMsg = 'Email này đã được đăng ký. Vui lòng chuyển sang tab Đăng Nhập.';
      } else if (err.code === 'auth/weak-password') {
        errorMsg = 'Mật khẩu quá ngắn, vui lòng nhập ít nhất 6 ký tự.';
      } else if (err.code === 'auth/invalid-email') {
        errorMsg = 'Địa chỉ email không hợp lệ.';
      } else if (err.code === 'auth/too-many-requests') {
        errorMsg = 'Quá nhiều yêu cầu không thành công. Vui lòng thử lại sau vài phút.';
      }
      showStatus(errorMsg, true);
    } finally {
      btnSubmitAuth.removeAttribute('disabled');
      btnSubmitAuth.classList.remove('opacity-75', 'cursor-not-allowed');
      btnSubmitArrow?.classList.remove('hidden');
      btnSubmitSpinner?.classList.add('hidden');
      btnSubmitText.textContent = currentMode === 'signin' ? 'ĐĂNG NHẬP VIP NGAY' : 'ĐĂNG KÝ THÀNH VIÊN VIP';
    }
  });

  // 4. Forgot Password
  btnForgotPassword?.addEventListener('click', async () => {
    const email = authEmail.value.trim();
    if (!email) {
      showStatus('Vui lòng nhập địa chỉ email vào ô phía trên trước khi yêu cầu cấp lại mật khẩu.', true);
      authEmail.focus();
      return;
    }
    try {
      await sendPasswordResetEmail(auth, email);
      showStatus('✅ Đã gửi email hướng dẫn đặt lại mật khẩu tới: ' + email + '. Vui lòng kiểm tra hộp thư của bạn.', false);
    } catch (err) {
      showStatus('Lỗi gửi email đặt lại mật khẩu: ' + err.message, true);
    }
  });

  // Check URL params (e.g. ?verified=1)
  try {
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('verified') === '1') {
      showStatus('✨ Email của bạn đã được xác nhận thành công! Vui lòng đăng nhập để bắt đầu.', false);
    }
  } catch (e) {}
</script>
