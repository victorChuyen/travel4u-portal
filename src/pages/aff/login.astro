    en: {
      backHome: "Travel4U Home",
      pricingLink: "⚡ 3 AI Solutions Pricing",
      gatewayBadge: "👑 TRAVEL4U VIP MEMBER & AFFILIATE GATEWAY",
      heading: "VIP Member Portal",
      subheading: "Sign in to manage your referral link, track <strong class=\"text-amber-400\">10% - 20% - 30%</strong> commissions, and request 24/7 payouts.",
      googleBtn: "1-Tap Sign-In with Google",
      divider: "or with email",
      tabSignin: "Sign In",
      tabSignup: "Register",
      labelFullname: "Your Full Name *",
      placeholderFullname: "E.g. Victor Chuyen",
      labelEmail: "Email Address *",
      labelPassword: "Password (min. 6 characters) *",
      placeholderPassword: "Enter your password...",
      forgotPassword: "Forgot password?",
      labelConfirmPassword: "Confirm Password *",
      placeholderConfirmPassword: "Re-enter your password...",
      btnSubmitSignin: "SIGN IN TO VIP PORTAL",
      btnSubmitSignup: "CREATE VIP ACCOUNT",
      trustSecurity: "256-Bit SSL Data Encryption · Sovereign Security Protocol",
      trustActivation: "Your exclusive referral code and partner dashboard are activated automatically upon signing in.",
      // Verification Screen
      verifTitle: "VERIFY YOUR EMAIL TO ACTIVATE VIP ACCESS",
      verifSentTo: "We have dispatched a verification link to:",
      verifStep1: "Open your email app (Gmail, Outlook, iCloud, etc.).",
      verifStep2: "Find the message from <strong>Travel4U / Firebase</strong> (check your <strong>Spam/Junk</strong> folder if not in your Inbox).",
      verifStep3: "Click the verification link to activate your VIP membership.",
      btnResendVerif: "Resend Verification Email",
      btnBackSignin: "I Have Verified → Sign In",
      // Alerts & Errors
      errFillAll: "Please fill in both Email and Password.",
      errEnterName: "Please enter your Full Name.",
      errPwdMismatch: "Passwords do not match. Please re-check.",
      errPwdShort: "Password is too short. Please enter at least 6 characters.",
      errEmailInvalid: "Please enter a valid email address.",
      errEmailInUse: "This email is already registered. Please switch to Sign In.",
      errWrongCreds: "Incorrect email or password.",
      errTooMany: "Too many unsuccessful attempts. Please try again later.",
      errGeneric: "An error occurred. Please try again.",
      loginSuccess: "✨ Login successful! Redirecting to your dashboard...",
      resendSuccess: "✅ Verification email re-sent! Please check your inbox.",
      resetSent: "✅ Password reset instructions sent! Please check your inbox.",
      promptEnterEmailReset: "Please enter your email address above before requesting a password reset.",
      unverifiedWarning: "⚠️ <strong>Email Not Verified:</strong> You must verify your email before signing in.",
      unverifiedSub: "Please check your inbox or click the button below to resend the activation link.",
      btnUnverifiedResend: "📩 Resend Verification Email"
    }
  };

  // Determine Language: Query param > localStorage > default (vi)
  const urlParams = new URLSearchParams(window.location.search);
  let currentLang = urlParams.get('lang') || urlParams.get('locale') || localStorage.getItem('t4u_login_lang') || 'vi';
  if (currentLang !== 'en' && currentLang !== 'vi') currentLang = 'vi';

  // 2. Initialize Firebase App via DOM attribute
  const container = document.getElementById('auth-container');
  let firebaseConfig = {};
  try {
    firebaseConfig = JSON.parse(container.getAttribute('data-config') || '{}');
  } catch (e) {
    console.error('Failed to parse firebase config from DOM:', e);
  }

  const app = getApps().length > 0 ? getApp() : initializeApp(firebaseConfig);
  const auth = getAuth(app);
  const googleProvider = new GoogleAuthProvider();
  googleProvider.setCustomParameters({ prompt: 'select_account' });

  // UI Elements
  const btnLangVi = document.getElementById('btn-lang-vi');
  const btnLangEn = document.getElementById('btn-lang-en');

  const textBackHome = document.getElementById('text-back-home');
  const textPricing = document.getElementById('text-pricing');
  const textGatewayBadge = document.getElementById('text-gateway-badge');
  const textHeading = document.getElementById('text-heading');
  const textSubheading = document.getElementById('text-subheading');
  const btnGoogleText = document.getElementById('btn-google-text');
  const textDivider = document.getElementById('text-divider');

  const tabSignin = document.getElementById('tab-signin');
  const tabSignup = document.getElementById('tab-signup');
  const fieldFullname = document.getElementById('field-fullname');
  const labelFullname = document.getElementById('label-fullname');
  const fieldConfirmPwd = document.getElementById('field-confirm-pwd');
  const labelConfirmPwd = document.getElementById('label-confirm-pwd');

  const authFormWrapper = document.getElementById('auth-form-wrapper');
  const authForm = document.getElementById('auth-form');
  const authEmail = document.getElementById('auth-email');
  const labelEmail = document.getElementById('label-email');
  const authPassword = document.getElementById('auth-password');
  const labelPassword = document.getElementById('label-password');
  const authConfirmPwd = document.getElementById('auth-confirm-pwd');
  const authFullname = document.getElementById('auth-fullname');
  const pwdMatchError = document.getElementById('pwd-match-error');

  const btnSubmitAuth = document.getElementById('btn-submit-auth');
  const btnSubmitText = document.getElementById('btn-submit-text');
  const btnSubmitArrow = document.getElementById('btn-submit-arrow');
  const btnSubmitSpinner = document.getElementById('btn-submit-spinner');

  const btnGoogleLogin = document.getElementById('btn-google-login');
  const btnForgotPassword = document.getElementById('btn-forgot-password');
  const statusBox = document.getElementById('auth-status-box');

  const textTrustSecurity = document.getElementById('text-trust-security');
  const textTrustActivation = document.getElementById('text-trust-activation');

  const verificationNoticeView = document.getElementById('verification-notice-view');
  const verifTitle = document.getElementById('verif-title');
  const verifSentTo = document.getElementById('verif-sent-to');
  const verificationTargetEmail = document.getElementById('verification-target-email');
  const verifStep1 = document.getElementById('verif-step-1');
  const verifStep2 = document.getElementById('verif-step-2');
  const verifStep3 = document.getElementById('verif-step-3');
  const btnResendVerification = document.getElementById('btn-resend-verification');
  const btnResendText = document.getElementById('btn-resend-text');
  const btnBackToSignin = document.getElementById('btn-back-to-signin');
  const textBtnBackSignin = document.getElementById('text-btn-back-signin');

  let currentMode = 'signin'; // 'signin' | 'signup'
  let lastRegisteredUser = null;

  // Language Apply Engine
  function applyLanguage(lang) {
    currentLang = lang;
    localStorage.setItem('t4u_login_lang', lang);
    const t = I18N[lang] || I18N.vi;

    // Toggle button active states
    if (lang === 'vi') {
      btnLangVi.className = "px-2 py-0.5 rounded transition bg-[#c9a54e] text-slate-950 shadow cursor-pointer font-bold";
      btnLangEn.className = "px-2 py-0.5 rounded transition text-slate-400 hover:text-white cursor-pointer font-bold";
    } else {
      btnLangEn.className = "px-2 py-0.5 rounded transition bg-[#c9a54e] text-slate-950 shadow cursor-pointer font-bold";
      btnLangVi.className = "px-2 py-0.5 rounded transition text-slate-400 hover:text-white cursor-pointer font-bold";
    }

    // Static text updates
    if (textBackHome) textBackHome.textContent = t.backHome;
    if (textPricing) textPricing.textContent = t.pricingLink;
    if (textGatewayBadge) textGatewayBadge.textContent = t.gatewayBadge;
    if (textHeading) textHeading.textContent = t.heading;
    if (textSubheading) textSubheading.innerHTML = t.subheading;
    if (btnGoogleText) btnGoogleText.textContent = t.googleBtn;
    if (textDivider) textDivider.textContent = t.divider;

    if (tabSignin) tabSignin.textContent = t.tabSignin;
    if (tabSignup) tabSignup.textContent = t.tabSignup;

    if (labelFullname) labelFullname.textContent = t.labelFullname;
    if (authFullname) authFullname.placeholder = t.placeholderFullname;

    if (labelEmail) labelEmail.textContent = t.labelEmail;
    if (labelPassword) labelPassword.textContent = t.labelPassword;
    if (authPassword) authPassword.placeholder = t.placeholderPassword;
    if (btnForgotPassword) btnForgotPassword.textContent = t.forgotPassword;

    if (labelConfirmPwd) labelConfirmPwd.textContent = t.labelConfirmPassword;
    if (authConfirmPwd) authConfirmPwd.placeholder = t.placeholderConfirmPassword;

    if (btnSubmitText) {
      btnSubmitText.textContent = currentMode === 'signin' ? t.btnSubmitSignin : t.btnSubmitSignup;
    }

    if (textTrustSecurity) textTrustSecurity.textContent = t.trustSecurity;
    if (textTrustActivation) textTrustActivation.textContent = t.trustActivation;

    // Verification screen text
    if (verifTitle) verifTitle.textContent = t.verifTitle;
    if (verifSentTo) verifSentTo.textContent = t.verifSentTo;
    if (verifStep1) verifStep1.textContent = t.verifStep1;
    if (verifStep2) verifStep2.innerHTML = t.verifStep2;
    if (verifStep3) verifStep3.textContent = t.verifStep3;
    if (btnResendText) btnResendText.textContent = t.btnResendVerif;
    if (textBtnBackSignin) textBtnBackSignin.textContent = t.btnBackSignin;

    if (pwdMatchError) pwdMatchError.textContent = `⚠️ ${t.errPwdMismatch}`;
  }

  // Bind Language Switches
  btnLangVi?.addEventListener('click', () => applyLanguage('vi'));
  btnLangEn?.addEventListener('click', () => applyLanguage('en'));

  // Initial apply
  applyLanguage(currentLang);

  // Eye toggle helper
  function setupPasswordToggle(inputEl, btnEl) {
    if (!inputEl || !btnEl) return;
    btnEl.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const isPassword = inputEl.type === 'password';
      inputEl.type = isPassword ? 'text' : 'password';

      const iconEye = btnEl.querySelector('.icon-eye');
      const iconEyeSlash = btnEl.querySelector('.icon-eye-slash');
      if (iconEye && iconEyeSlash) {
        if (isPassword) {
          iconEye.classList.add('hidden');
          iconEyeSlash.classList.remove('hidden');
        } else {
          iconEye.classList.remove('hidden');
          iconEyeSlash.classList.add('hidden');
        }
      }
      inputEl.focus();
    });
  }

  setupPasswordToggle(authPassword, document.getElementById('btn-toggle-pwd'));
  setupPasswordToggle(authConfirmPwd, document.getElementById('btn-toggle-confirm-pwd'));

  function showStatus(msg, isError = false) {
    if (!statusBox) return;
    statusBox.innerHTML = msg;
    statusBox.classList.remove('hidden', 'bg-red-500/20', 'text-red-300', 'border-red-500/40', 'bg-emerald-500/20', 'text-emerald-300', 'border-emerald-500/40', 'bg-amber-500/20', 'text-amber-300', 'border-amber-500/40');
    if (isError) {
      statusBox.classList.add('bg-red-500/20', 'text-red-300', 'border', 'border-red-500/40');
    } else {
      statusBox.classList.add('bg-emerald-500/20', 'text-emerald-300', 'border', 'border-emerald-500/40');
    }
  }

  function setMode(mode) {
    currentMode = mode;
    statusBox?.classList.add('hidden');
    pwdMatchError?.classList.add('hidden');
    const t = I18N[currentLang] || I18N.vi;

    if (mode === 'signin') {
      tabSignin.classList.add('bg-[#c9a54e]', 'text-slate-950', 'shadow');
      tabSignin.classList.remove('text-slate-400');
      tabSignup.classList.remove('bg-[#c9a54e]', 'text-slate-950', 'shadow');
      tabSignup.classList.add('text-slate-400');

      fieldFullname.classList.add('hidden');
      fieldConfirmPwd.classList.add('hidden');
      authFullname.removeAttribute('required');
      authConfirmPwd.removeAttribute('required');
      btnForgotPassword.classList.remove('hidden');
      btnSubmitText.textContent = t.btnSubmitSignin;
    } else {
      tabSignup.classList.add('bg-[#c9a54e]', 'text-slate-950', 'shadow');
      tabSignup.classList.remove('text-slate-400');
      tabSignin.classList.remove('bg-[#c9a54e]', 'text-slate-950', 'shadow');
      tabSignin.classList.add('text-slate-400');

      fieldFullname.classList.remove('hidden');
      fieldConfirmPwd.classList.remove('hidden');
      authFullname.setAttribute('required', 'true');
      authConfirmPwd.setAttribute('required', 'true');
      btnForgotPassword.classList.add('hidden');
      btnSubmitText.textContent = t.btnSubmitSignup;
    }
  }

  tabSignin?.addEventListener('click', () => {
    verificationNoticeView?.classList.add('hidden');
    authFormWrapper?.classList.remove('hidden');
    setMode('signin');
  });

  tabSignup?.addEventListener('click', () => {
    verificationNoticeView?.classList.add('hidden');
    authFormWrapper?.classList.remove('hidden');
    setMode('signup');
  });

  // Password confirmation check on input
  function checkPasswordMatch() {
    if (currentMode !== 'signup') return true;
    const p1 = authPassword.value;
    const p2 = authConfirmPwd.value;
    if (p2 && p1 !== p2) {
      pwdMatchError?.classList.remove('hidden');
      authConfirmPwd.classList.add('border-rose-500');
      return false;
    } else {
      pwdMatchError?.classList.add('hidden');
      authConfirmPwd.classList.remove('border-rose-500');
      return true;
    }
  }

  authConfirmPwd?.addEventListener('input', checkPasswordMatch);
  authPassword?.addEventListener('input', () => {
    if (authConfirmPwd?.value) checkPasswordMatch();
  });

  function handleAuthSuccess(user) {
    const isSuperAdmin = 
      user.email === 'coach.chuyen@gmail.com' ||
      user.email === 'f0807557459@gmail.com' ||
      user.uid === 'GM9BYPVvotUqgZq8VYOU1vhFBjr2' ||
      user.email === 'victorchuyen68@gmail.com';

    const displayName = isSuperAdmin ? 'Chairman Victor' : (user.displayName || user.email?.split('@')[0] || 'VIP Member');
    const refCode = isSuperAdmin ? 'VICTOR88' : `${displayName.replace(/[^a-zA-Z0-9]/g, '').toUpperCase().slice(0, 8) || 'VIP'}88`;

    const vipUser = {
      uid: user.uid,
      email: user.email,
      displayName,
      photoURL: user.photoURL,
      emailVerified: true,
      isSuperAdmin: isSuperAdmin,
      role: isSuperAdmin ? 'SUPER_ADMIN' : 'VIP_MEMBER',
      tier: isSuperAdmin ? 'tier_03_dfy' : 'tier_01_free',
      tierName: isSuperAdmin ? '👑 SUPER ADMIN (30%)' : (currentLang === 'en' ? 'VIP Member (10%)' : 'Hội Viên VIP (10%)'),
      commissionRate: isSuperAdmin ? 0.30 : 0.10,
      refCode: refCode
    };

    localStorage.setItem('t4u_vip_user', JSON.stringify(vipUser));
    localStorage.setItem('t4u_partner_name', displayName);
    localStorage.setItem('t4u_partner_ref', refCode);

    const t = I18N[currentLang] || I18N.vi;
    showStatus(t.loginSuccess, false);
    setTimeout(() => {
      window.location.href = '/aff/';
    }, 800);
  }

  // 1. Google 1-Tap Login
  btnGoogleLogin?.addEventListener('click', async () => {
    const t = I18N[currentLang] || I18N.vi;
    try {
      btnGoogleLogin.setAttribute('disabled', 'true');
      btnGoogleLogin.classList.add('opacity-75');
      if (btnGoogleText) btnGoogleText.textContent = currentLang === 'en' ? 'Connecting to Google...' : 'Đang mở cửa sổ Google...';
      showStatus(currentLang === 'en' ? 'Opening Google Account authentication...' : 'Đang kết nối xác thực tài khoản Google...', false);

      const result = await signInWithPopup(auth, googleProvider);
      handleAuthSuccess(result.user);
    } catch (err) {
      console.error('Google Auth error:', err);
      showStatus((currentLang === 'en' ? 'Could not complete Google Sign-In: ' : 'Không thể hoàn tất đăng nhập Google: ') + (err.message || ''), true);
    } finally {
      btnGoogleLogin.removeAttribute('disabled');
      btnGoogleLogin.classList.remove('opacity-75');
      if (btnGoogleText) btnGoogleText.textContent = t.googleBtn;
    }
  });

  // 2. Email Verification Screen
  function showVerificationView(email, user) {
    lastRegisteredUser = user;
    if (verificationTargetEmail) verificationTargetEmail.textContent = email;
    authFormWrapper?.classList.add('hidden');
    verificationNoticeView?.classList.remove('hidden');
    statusBox?.classList.add('hidden');
  }

  btnBackToSignin?.addEventListener('click', () => {
    verificationNoticeView?.classList.add('hidden');
    authFormWrapper?.classList.remove('hidden');
    setMode('signin');
    const t = I18N[currentLang] || I18N.vi;
    showStatus(currentLang === 'en' ? 'After clicking the verification link in your email, enter your email and password to sign in.' : 'Sau khi bấm link trong email của bạn, hãy nhập email và mật khẩu để đăng nhập.', false);
  });

  // Resend verification email
  btnResendVerification?.addEventListener('click', async () => {
    const t = I18N[currentLang] || I18N.vi;
    try {
      btnResendVerification.setAttribute('disabled', 'true');
      if (btnResendText) btnResendText.textContent = currentLang === 'en' ? 'Sending...' : 'Đang gửi...';

      if (auth.currentUser) {
        await sendEmailVerification(auth.currentUser);
        showStatus(t.resendSuccess, false);
      } else {
        showStatus(currentLang === 'en' ? 'Please sign in to resend the verification email.' : 'Vui lòng đăng nhập để hệ thống gửi lại email xác thực.', true);
      }
    } catch (err) {
      showStatus('Error: ' + err.message, true);
    } finally {
      setTimeout(() => {
        btnResendVerification.removeAttribute('disabled');
        if (btnResendText) btnResendText.textContent = t.btnResendVerif;
      }, 5000);
    }
  });

  // 3. Form Submit (Email / Password)
  authForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const t = I18N[currentLang] || I18N.vi;
    const email = authEmail.value.trim();
    const password = authPassword.value;
    const fullName = authFullname.value.trim();
    const confirmPwd = authConfirmPwd.value;

    if (!email || !password) {
      showStatus(t.errFillAll, true);
      return;
    }

    if (currentMode === 'signup') {
      if (!fullName) {
        showStatus(t.errEnterName, true);
        authFullname.focus();
        return;
      }
      if (password !== confirmPwd) {
        showStatus(t.errPwdMismatch, true);
        authConfirmPwd.focus();
        return;
      }
    }

    // Set Loading State
    btnSubmitAuth.setAttribute('disabled', 'true');
    btnSubmitAuth.classList.add('opacity-75', 'cursor-not-allowed');
    btnSubmitArrow?.classList.add('hidden');
    btnSubmitSpinner?.classList.remove('hidden');
    btnSubmitText.textContent = currentMode === 'signup' 
      ? (currentLang === 'en' ? 'Creating VIP account...' : 'Đang tạo tài khoản...') 
      : (currentLang === 'en' ? 'Signing in...' : 'Đang đăng nhập...');

    try {
      if (currentMode === 'signup') {
        const userCredential = await createUserWithEmailAndPassword(auth, email, password);
        const user = userCredential.user;

        if (fullName) {
          await updateProfile(user, { displayName: fullName });
        }

        try {
          await sendEmailVerification(user);
        } catch (verErr) {
          console.warn('Verification email dispatch warning:', verErr);
        }

        await signOut(auth);
        showVerificationView(email, user);

      } else {
        const userCredential = await signInWithEmailAndPassword(auth, email, password);
        const user = userCredential.user;

        const isSuperAdmin = 
          email === 'coach.chuyen@gmail.com' ||
          email === 'f0807557459@gmail.com' ||
          user.uid === 'GM9BYPVvotUqgZq8VYOU1vhFBjr2' ||
          email === 'victorchuyen68@gmail.com';

        if (user.emailVerified || isSuperAdmin) {
          handleAuthSuccess(user);
        } else {
          showStatus(`
            <div class="space-y-2">
              <p>${t.unverifiedWarning}</p>
              <p class="text-[11px] text-slate-300">${t.unverifiedSub}</p>
              <button type="button" id="btn-inline-resend" class="mt-1 px-3 py-1.5 bg-[#c9a54e] text-slate-950 font-bold rounded-lg text-[11px] hover:bg-[#dfba63] transition cursor-pointer">
                ${t.btnUnverifiedResend}
              </button>
            </div>
          `, true);

          document.getElementById('btn-inline-resend')?.addEventListener('click', async () => {
            try {
              await sendEmailVerification(user);
              showStatus(t.resendSuccess, false);
            } catch (err) {
              showStatus('Error: ' + err.message, true);
            }
          });

          await signOut(auth);
        }
      }
    } catch (err) {
      console.error('Auth error:', err);
      let errorMsg = t.errGeneric;
      if (err.code === 'auth/user-not-found' || err.code === 'auth/wrong-password' || err.code === 'auth/invalid-credential') {
        errorMsg = t.errWrongCreds;
      } else if (err.code === 'auth/email-already-in-use') {
        errorMsg = t.errEmailInUse;
      } else if (err.code === 'auth/weak-password') {
        errorMsg = t.errPwdShort;
      } else if (err.code === 'auth/invalid-email') {
        errorMsg = t.errEmailInvalid;
      } else if (err.code === 'auth/too-many-requests') {
        errorMsg = t.errTooMany;
      }
      showStatus(errorMsg, true);
    } finally {
      btnSubmitAuth.removeAttribute('disabled');
      btnSubmitAuth.classList.remove('opacity-75', 'cursor-not-allowed');
      btnSubmitArrow?.classList.remove('hidden');
      btnSubmitSpinner?.classList.add('hidden');
      btnSubmitText.textContent = currentMode === 'signin' ? t.btnSubmitSignin : t.btnSubmitSignup;
    }
  });

  // 4. Forgot Password
  btnForgotPassword?.addEventListener('click', async () => {
    const t = I18N[currentLang] || I18N.vi;
    const email = authEmail.value.trim();
    if (!email) {
      showStatus(t.promptEnterEmailReset, true);
      authEmail.focus();
      return;
    }
    try {
      await sendPasswordResetEmail(auth, email);
      showStatus(t.resetSent, false);
    } catch (err) {
      showStatus('Error: ' + err.message, true);
    }
  });

  // Check URL params (e.g. ?verified=1)
  try {
    if (urlParams.get('verified') === '1') {
      showStatus(currentLang === 'en' ? '✨ Your email has been verified! Please sign in to access your portal.' : '✨ Email của bạn đã được xác nhận thành công! Vui lòng đăng nhập để bắt đầu.', false);
    }
  } catch (e) {}
</script>
