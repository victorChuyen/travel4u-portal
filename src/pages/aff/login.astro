---
/**
 * 🏛️ TRAVEL4U — CỔNG ĐĂNG KÝ & ĐĂNG NHẬP VIP MEMBER / AFFILIATE PARTNER
 * Google 1-Tap Login + Email/Password via Google Firebase (travel4you-app)
 * Authors: Chairman Victor Chuyen & AI CEO Lucky
 */

import Layout from '../../layouts/Layout.astro';
import { firebaseConfig } from '../../lib/firebaseClient';

const pageTitle = "Cổng Đăng Nhập & Đăng Ký VIP Member | Travel4U Sovereign Portal";
const pageDescription = "Đăng nhập hoặc đăng ký thành viên VIP / Đối tác Affiliate nhận hoa hồng 10% - 20% - 30% trực tiếp trên mạng lưới Travel4U.";
---

<Layout title={pageTitle} description={pageDescription} locale="vi">
  <main class="min-h-screen bg-[#07111e] flex items-center justify-center px-4 py-12 relative overflow-hidden">
    
    <!-- Ambient Gold & Navy Glow -->
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-[#c9a54e]/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-md rounded-3xl border border-[#c9a54e]/40 bg-gradient-to-b from-[#0d1c31] via-[#091424] to-[#060c16] p-6 sm:p-8 shadow-2xl relative z-10">
      
      <!-- Top Navigation -->
      <div class="mb-6 flex items-center justify-between">
        <a href="/" class="inline-flex items-center text-xs font-semibold text-slate-400 hover:text-[#c9a54e] transition-colors group">
          <span class="mr-1.5 transition-transform group-hover:-translate-x-1">←</span>
          <span>Trang Chủ Travel4U</span>
        </a>
        <a href="/pricing" class="inline-flex items-center text-xs font-bold text-amber-400 hover:text-amber-300 transition-colors">
          <span>⚡ Bảng Giá 3 Gói AI</span>
        </a>
      </div>

      <!-- Brand Header -->
      <div class="text-center mb-6">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-[11px] font-bold uppercase tracking-wider mb-2">
          <span>👑 TRAVEL4U VIP MEMBER & AFFILIATE GATEWAY</span>
        </div>
        <h1 class="font-serif text-2xl sm:text-3xl font-bold text-white tracking-tight">
          Cổng Thành Viên VIP
        </h1>
        <p class="text-xs text-slate-300 mt-1.5">
          Đăng nhập để quản lý mã giới thiệu, theo dõi hoa hồng <strong class="text-amber-400">10% - 20% - 30%</strong> và rút tiền 24/7.
        </p>
      </div>

      <!-- 1-TAP GOOGLE SIGN IN BUTTON (TOP PRIORITY) -->
      <div class="mb-5">
        <button
          type="button"
          id="btn-google-login"
          class="w-full py-3 px-4 rounded-xl bg-white hover:bg-slate-100 text-slate-900 font-bold text-xs sm:text-sm flex items-center justify-center gap-3 transition shadow-lg hover:shadow-xl cursor-pointer"
        >
          <!-- Official Google "G" SVG Icon -->
          <svg class="w-4 h-4" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
          <span>Đăng nhập 1-Chạm với Google</span>
        </button>
      </div>

      <!-- Divider -->
      <div class="flex items-center my-4">
        <div class="flex-grow border-t border-slate-700/80"></div>
        <span class="px-3 text-[11px] text-slate-400 uppercase tracking-wider font-semibold">hoặc email</span>
        <div class="flex-grow border-t border-slate-700/80"></div>
      </div>

      <!-- Auth Tabs: Đăng Nhập vs Đăng Ký -->
      <div class="flex rounded-xl bg-slate-950 p-1 mb-4 border border-slate-800 text-xs font-bold">
        <button
          type="button"
          id="tab-signin"
          class="flex-1 py-2 rounded-lg text-center transition bg-[#c9a54e] text-slate-950 shadow"
        >
          Đăng Nhập
        </button>
        <button
          type="button"
          id="tab-signup"
          class="flex-1 py-2 rounded-lg text-center transition text-slate-400 hover:text-white"
        >
          Đăng Ký Mới
        </button>
      </div>

      <!-- Form Error / Status Message -->
      <div id="auth-status-box" class="hidden mb-4 p-3 rounded-xl text-xs font-semibold"></div>

      <!-- Email / Password Form -->
      <form id="auth-form" class="space-y-3.5">
        
        <!-- Full Name (Only for Registration) -->
        <div id="field-fullname" class="hidden">
          <label for="auth-fullname" class="block text-xs font-semibold text-slate-300 uppercase mb-1">
            Họ và tên của bạn *
          </label>
          <input
            id="auth-fullname"
            type="text"
            placeholder="Ví dụ: Victor Chuyen"
            class="w-full rounded-xl border border-slate-700 bg-slate-950/80 px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 transition"
          />
        </div>

        <div>
          <label for="auth-email" class="block text-xs font-semibold text-slate-300 uppercase mb-1">
            Địa chỉ Email *
          </label>
          <input
            id="auth-email"
            type="email"
            required
            placeholder="name@example.com"
            class="w-full rounded-xl border border-slate-700 bg-slate-950/80 px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 transition"
          />
        </div>

        <div>
          <div class="flex items-center justify-between mb-1">
            <label for="auth-password" class="block text-xs font-semibold text-slate-300 uppercase">
              Mật khẩu *
            </label>
            <button
              type="button"
              id="btn-forgot-password"
              class="text-[11px] text-amber-400 hover:underline"
            >
              Quên mật khẩu?
            </button>
          </div>
          <input
            id="auth-password"
            type="password"
            required
            minlength="6"
            placeholder="Tối thiểu 6 ký tự"
            class="w-full rounded-xl border border-slate-700 bg-slate-950/80 px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 transition"
          />
        </div>

        <button
          type="submit"
          id="btn-submit-auth"
          class="w-full py-3 px-6 rounded-xl bg-gradient-to-r from-amber-500 via-[#c9a54e] to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-black text-sm transition shadow-xl shadow-amber-500/20 flex items-center justify-center gap-2 cursor-pointer mt-2"
        >
          <span id="btn-submit-text">ĐĂNG NHẬP VIP NGAY</span>
          <span>→</span>
        </button>
      </form>

      <!-- Footer Trust Badge -->
      <div class="mt-6 pt-4 border-t border-slate-800/80 text-center text-xs text-slate-400 space-y-1">
        <p class="flex items-center justify-center space-x-1.5 text-slate-300">
          <span class="text-[#c9a54e]">🔒</span>
          <span>Bảo mật dữ liệu tiêu chuẩn 256-bit SSL · Tuyệt đối an toàn</span>
        </p>
        <p class="text-slate-500 text-[11px]">Hệ thống tự động kích hoạt mã định danh và bảng điều khiển độc quyền sau khi đăng nhập.</p>
      </div>

    </div>
  </main>
</Layout>

<!-- FIREBASE CLIENT MODULAR SCRIPT -->
<script define:vars={{ firebaseConfig }}>
  import { initializeApp, getApps, getApp } from 'https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js';
  import {
    getAuth,
    signInWithPopup,
    GoogleAuthProvider,
    signInWithEmailAndPassword,
    createUserWithEmailAndPassword,
    sendPasswordResetEmail,
    updateProfile,
    onAuthStateChanged
  } from 'https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js';

  // 1. Initialize Firebase App
  const app = getApps().length > 0 ? getApp() : initializeApp(firebaseConfig);
  const auth = getAuth(app);
  const googleProvider = new GoogleAuthProvider();
  googleProvider.setCustomParameters({ prompt: 'select_account' });

  // UI Elements
  const tabSignin = document.getElementById('tab-signin');
  const tabSignup = document.getElementById('tab-signup');
  const fieldFullname = document.getElementById('field-fullname');
  const authForm = document.getElementById('auth-form');
  const authEmail = document.getElementById('auth-email');
  const authPassword = document.getElementById('auth-password');
  const authFullname = document.getElementById('auth-fullname');
  const btnSubmitAuth = document.getElementById('btn-submit-auth');
  const btnSubmitText = document.getElementById('btn-submit-text');
  const btnGoogleLogin = document.getElementById('btn-google-login');
  const btnForgotPassword = document.getElementById('btn-forgot-password');
  const statusBox = document.getElementById('auth-status-box');

  let currentMode = 'signin'; // 'signin' | 'signup'

  function showStatus(msg, isError = false) {
    if (!statusBox) return;
    statusBox.textContent = msg;
    statusBox.classList.remove('hidden', 'bg-red-500/20', 'text-red-400', 'border-red-500/30', 'bg-emerald-500/20', 'text-emerald-400', 'border-emerald-500/30');
    if (isError) {
      statusBox.classList.add('bg-red-500/20', 'text-red-400', 'border', 'border-red-500/30');
    } else {
      statusBox.classList.add('bg-emerald-500/20', 'text-emerald-400', 'border', 'border-emerald-500/30');
    }
  }

  function setMode(mode) {
    currentMode = mode;
    if (mode === 'signin') {
      tabSignin.classList.add('bg-[#c9a54e]', 'text-slate-950', 'shadow');
      tabSignin.classList.remove('text-slate-400');
      tabSignup.classList.remove('bg-[#c9a54e]', 'text-slate-950', 'shadow');
      tabSignup.classList.add('text-slate-400');
      fieldFullname.classList.add('hidden');
      authFullname.removeAttribute('required');
      btnSubmitText.textContent = 'ĐĂNG NHẬP VIP NGAY';
    } else {
      tabSignup.classList.add('bg-[#c9a54e]', 'text-slate-950', 'shadow');
      tabSignup.classList.remove('text-slate-400');
      tabSignin.classList.remove('bg-[#c9a54e]', 'text-slate-950', 'shadow');
      tabSignin.classList.add('text-slate-400');
      fieldFullname.classList.remove('hidden');
      authFullname.setAttribute('required', 'true');
      btnSubmitText.textContent = 'ĐĂNG KÝ THÀNH VIÊN VIP';
    }
  }

  tabSignin?.addEventListener('click', () => setMode('signin'));
  tabSignup?.addEventListener('click', () => setMode('signup'));

  function handleAuthSuccess(user) {
    const displayName = user.displayName || user.email?.split('@')[0] || 'VIP Member';
    const refBase = displayName.replace(/[^a-zA-Z0-9]/g, '').toUpperCase().slice(0, 8) || 'VIP';
    const refCode = `${refBase}88`;

    // Save profile to localStorage for instant UI responsiveness
    const vipUser = {
      uid: user.uid,
      email: user.email,
      displayName,
      photoURL: user.photoURL,
      tier: 'tier_02',
      commissionRate: 0.20,
      refCode
    };

    localStorage.setItem('t4u_vip_user', JSON.stringify(vipUser));
    localStorage.setItem('t4u_partner_name', displayName);
    localStorage.setItem('t4u_partner_ref', refCode);

    showStatus('Đăng nhập thành công! Đang chuyển hướng...', false);
    setTimeout(() => {
      window.location.href = '/aff/';
    }, 800);
  }

  // 1. Google Login Handler
  btnGoogleLogin?.addEventListener('click', async () => {
    try {
      btnGoogleLogin.setAttribute('disabled', 'true');
      btnGoogleLogin.classList.add('opacity-75');
      showStatus('Đang mở cửa sổ đăng nhập Google...', false);

      const result = await signInWithPopup(auth, googleProvider);
      handleAuthSuccess(result.user);
    } catch (err) {
      console.error('Google Auth error:', err);
      showStatus('Không thể đăng nhập Google: ' + (err.message || 'Vui lòng thử lại.'), true);
    } finally {
      btnGoogleLogin.removeAttribute('disabled');
      btnGoogleLogin.classList.remove('opacity-75');
    }
  });

  // 2. Email & Password Form Submit
  authForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = authEmail.value.trim();
    const password = authPassword.value;
    const fullName = authFullname.value.trim();

    if (!email || !password) return;

    btnSubmitAuth.setAttribute('disabled', 'true');
    btnSubmitText.textContent = 'Đang xử lý...';

    try {
      if (currentMode === 'signup') {
        const userCredential = await createUserWithEmailAndPassword(auth, email, password);
        if (fullName && userCredential.user) {
          await updateProfile(userCredential.user, { displayName: fullName });
        }
        handleAuthSuccess(userCredential.user);
      } else {
        const userCredential = await signInWithEmailAndPassword(auth, email, password);
        handleAuthSuccess(userCredential.user);
      }
    } catch (err) {
      console.error('Auth error:', err);
      let errorMsg = 'Đã có lỗi xảy ra. Vui lòng thử lại.';
      if (err.code === 'auth/user-not-found' || err.code === 'auth/wrong-password' || err.code === 'auth/invalid-credential') {
        errorMsg = 'Email hoặc mật khẩu không chính xác.';
      } else if (err.code === 'auth/email-already-in-use') {
        errorMsg = 'Email này đã được đăng ký. Vui lòng chuyển sang tab Đăng Nhập.';
      } else if (err.code === 'auth/weak-password') {
        errorMsg = 'Mật khẩu quá ngắn, vui lòng nhập ít nhất 6 ký tự.';
      } else if (err.code === 'auth/invalid-email') {
        errorMsg = 'Địa chỉ email không hợp lệ.';
      }
      showStatus(errorMsg, true);
    } finally {
      btnSubmitAuth.removeAttribute('disabled');
      btnSubmitText.textContent = currentMode === 'signin' ? 'ĐĂNG NHẬP VIP NGAY' : 'ĐĂNG KÝ THÀNH VIÊN VIP';
    }
  });

  // 3. Forgot Password Handler
  btnForgotPassword?.addEventListener('click', async () => {
    const email = authEmail.value.trim();
    if (!email) {
      showStatus('Vui lòng nhập địa chỉ email vào ô phía trên trước khi yêu cầu cấp lại mật khẩu.', true);
      authEmail.focus();
      return;
    }
    try {
      await sendPasswordResetEmail(auth, email);
      showStatus('Đã gửi email hướng dẫn đặt lại mật khẩu tới: ' + email + '. Vui lòng kiểm tra hộp thư.', false);
    } catch (err) {
      showStatus('Lỗi gửi email đặt lại mật khẩu: ' + err.message, true);
    }
  });

  // 4. Auto-redirect if already logged in
  onAuthStateChanged(auth, (user) => {
    if (user && !document.referrer.includes('/aff')) {
      handleAuthSuccess(user);
    }
  });
</script>
