      errPwdShort: "Mật khẩu quá ngắn, vui lòng nhập ít nhất 6 ký tự.",
      errEmailInvalid: "Địa chỉ email không hợp lệ.",
      errEmailInUse: "Email này đã được đăng ký. Vui lòng chuyển sang tab Đăng Nhập.",
      errWrongCreds: "Email hoặc mật khẩu không chính xác.",
