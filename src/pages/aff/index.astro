            <span id="user-display-name" class="font-bold text-white">Đối Tác VIP</span>
            <span id="user-tier-badge" class="px-2 py-0.5 rounded-md bg-amber-500/20 border border-amber-500/40 text-[10px] font-black text-amber-300 uppercase">
              CẤP 2 (20%)
            </span>
          </div>
          <button
            id="btn-edit-profile"
            type="button"
            class="text-xs text-slate-400 hover:text-amber-400 px-2 py-1 rounded transition"
            title="Đổi thông tin hoặc tài khoản"
          >
            ⚙️ Cài đặt
          </button>
        </div>
      </div>

      <!-- HEADER HERO -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8 pb-6 border-b border-slate-800/80">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-bold uppercase tracking-wider mb-2">
            <span>💎 CHƯƠNG TRÌNH ĐỐI TÁC HOA HỒNG CAO NHẤT THỊ TRƯỜNG</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-white font-serif tracking-tight">
            Bảng Điều Khiển Đối Tác Affiliate VIP
