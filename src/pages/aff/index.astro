          <!-- Quick Referral Code & Link Input -->
          <div class="w-full lg:max-w-md bg-slate-950/90 border border-slate-700/80 rounded-2xl p-4 shadow-inner space-y-3">
            <div class="flex items-center justify-between text-xs text-slate-400">
