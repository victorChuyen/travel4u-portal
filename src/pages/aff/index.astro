<script>
  // DOM Elements
  const refCodeEl = document.getElementById('display-ref-code');
  const refLinkInput = document.getElementById('ref-link-input') as HTMLInputElement;
  const btnCopyLink = document.getElementById('btn-copy-ref-link');
  const btnCopyText = document.getElementById('btn-copy-text');
  const userDisplayName = document.getElementById('user-display-name');

  // Load saved partner code or initialize default
  let currentRefCode = localStorage.getItem('t4u_partner_ref') || 'VICTOR88';
  let currentPartnerName = localStorage.getItem('t4u_partner_name') || 'Victor Chuyen';

  function updateRefUI() {
    const origin = window.location.origin;
    const fullLink = `${origin}/?ref=${currentRefCode}`;
    if (refCodeEl) refCodeEl.innerText = currentRefCode;
    if (refLinkInput) refLinkInput.value = fullLink;
    if (userDisplayName) userDisplayName.innerText = currentPartnerName;
  }

  updateRefUI();

  // 1-Click Copy Link
  btnCopyLink?.addEventListener('click', async () => {
    if (!refLinkInput) return;
    try {
      await navigator.clipboard.writeText(refLinkInput.value);
      if (btnCopyText) btnCopyText.innerText = 'Đã chép!';
      btnCopyLink.classList.remove('bg-amber-500');
      btnCopyLink.classList.add('bg-emerald-500');
      setTimeout(() => {
        if (btnCopyText) btnCopyText.innerText = 'Sao Chép';
        btnCopyLink.classList.remove('bg-emerald-500');
        btnCopyLink.classList.add('bg-amber-500');
      }, 2500);
    } catch (err) {
      refLinkInput.select();
    }
  });

  // Share buttons
  document.getElementById('btn-share-zalo')?.addEventListener('click', () => {
    const url = refLinkInput.value;
    window.open(`https://zalo.me/share?url=${encodeURIComponent(url)}`, '_blank');
  });

  document.getElementById('btn-share-fb')?.addEventListener('click', () => {
    const url = refLinkInput.value;
    window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`, '_blank', 'width=600,height=400');
  });

  document.getElementById('btn-share-tele')?.addEventListener('click', () => {
    const url = refLinkInput.value;
    const text = 'Khám phá Hệ thống AI Doanh Thu & Cẩm Nang Du Lịch Xa Xỉ cùng Victor Chuyen:';
    window.open(`https://t.me/share/url?url=${encodeURIComponent(url)}&text=${encodeURIComponent(text)}`, '_blank');
  });

  // QR Modal
  const qrModal = document.getElementById('qr-modal');
  const qrImg = document.getElementById('qr-modal-image') as HTMLImageElement;
  const qrUrlText = document.getElementById('qr-modal-url');

  document.getElementById('btn-view-qr')?.addEventListener('click', () => {
    if (!qrModal || !qrImg || !qrUrlText) return;
    const url = refLinkInput.value;
    qrImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=${encodeURIComponent(url)}`;
    qrUrlText.innerText = url;
    qrModal.classList.remove('hidden');
    setTimeout(() => qrModal.classList.remove('opacity-0'), 10);
  });

  document.getElementById('btn-close-qr-modal')?.addEventListener('click', () => {
    if (!qrModal) return;
    qrModal.classList.add('opacity-0');
    setTimeout(() => qrModal.classList.add('hidden'), 300);
  });

  document.getElementById('btn-copy-qr-url')?.addEventListener('click', async () => {
    await navigator.clipboard.writeText(refLinkInput.value);
    alert('Đã sao chép link!');
  });

  // Payout Modal
  const payoutModal = document.getElementById('payout-modal');
  const openPayoutBtns = [document.getElementById('btn-withdraw-now'), document.getElementById('btn-open-payout-modal-top')];
  const closePayoutBtn = document.getElementById('btn-close-payout-modal');

  openPayoutBtns.forEach(btn => {
    btn?.addEventListener('click', () => {
      if (!payoutModal) return;
      payoutModal.classList.remove('hidden');
      setTimeout(() => payoutModal.classList.remove('opacity-0'), 10);
    });
  });

  closePayoutBtn?.addEventListener('click', () => {
    if (!payoutModal) return;
    payoutModal.classList.add('opacity-0');
    setTimeout(() => payoutModal.classList.add('hidden'), 300);
  });

  // Handle Payout Form
  document.getElementById('payout-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const bank = (document.getElementById('payout-bank') as HTMLSelectElement)?.value;
    const accNum = (document.getElementById('payout-acc-number') as HTMLInputElement)?.value.trim();
    const accName = (document.getElementById('payout-acc-name') as HTMLInputElement)?.value.trim();
    const amount = Number((document.getElementById('payout-amount') as HTMLInputElement)?.value);
    const submitBtn = document.getElementById('btn-submit-payout');

    if (!bank || !accNum || !accName || !amount) return;

    if (submitBtn) {
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.innerText = 'Đang xử lý yêu cầu...';
    }

    try {
      const res = await fetch('/api/affiliate/payout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          affiliate_id: currentRefCode,
          affiliate_name: currentPartnerName,
          bank_name: bank,
          account_number: accNum,
          account_name: accName,
          amount
        })
      });

      const data = await res.json();
      alert(data.message || 'Yêu cầu rút tiền thành công! Hệ thống giải ngân trong 24 giờ.');
      if (payoutModal) {
        payoutModal.classList.add('opacity-0');
        setTimeout(() => payoutModal.classList.add('hidden'), 300);
      }
    } catch (err) {
      alert('Yêu cầu rút tiền đã được ghi nhận. Ban Quản Trị sẽ chuyển khoản trong 24 giờ.');
      if (payoutModal) {
        payoutModal.classList.add('opacity-0');
        setTimeout(() => payoutModal.classList.add('hidden'), 300);
      }
    } finally {
      if (submitBtn) {
        submitBtn.removeAttribute('disabled');
        submitBtn.innerText = 'XÁC NHẬN RÚT TIỀN NGAY';
      }
    }
  });

  // Profile Modal
  const profileModal = document.getElementById('profile-modal');
  document.getElementById('btn-edit-profile')?.addEventListener('click', () => {
    if (!profileModal) return;
    profileModal.classList.remove('hidden');
    setTimeout(() => profileModal.classList.remove('opacity-0'), 10);
  });

  document.getElementById('btn-close-profile-modal')?.addEventListener('click', () => {
    if (!profileModal) return;
    profileModal.classList.add('opacity-0');
    setTimeout(() => profileModal.classList.add('hidden'), 300);
  });

  document.getElementById('profile-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const newName = (document.getElementById('input-partner-name') as HTMLInputElement)?.value.trim();
    const newRef = (document.getElementById('input-partner-ref') as HTMLInputElement)?.value.trim().toUpperCase();
    if (newName && newRef) {
      currentPartnerName = newName;
      currentRefCode = newRef;
      localStorage.setItem('t4u_partner_name', newName);
      localStorage.setItem('t4u_partner_ref', newRef);
      updateRefUI();
      if (profileModal) {
        profileModal.classList.add('opacity-0');
        setTimeout(() => profileModal.classList.add('hidden'), 300);
      }
    }
  });

  // Swipe Copy Tabs
  const tabBtns = [document.getElementById('tab-btn-1'), document.getElementById('tab-btn-2'), document.getElementById('tab-btn-3')];
  const tabContents = [document.getElementById('tab-content-1'), document.getElementById('tab-content-2'), document.getElementById('tab-content-3')];

  tabBtns.forEach((btn, idx) => {
    btn?.addEventListener('click', () => {
      tabBtns.forEach(b => {
        b?.classList.remove('border-amber-400', 'text-amber-400');
        b?.classList.add('border-transparent', 'text-slate-400');
      });
      btn.classList.add('border-amber-400', 'text-amber-400');
      btn.classList.remove('border-transparent', 'text-slate-400');

      tabContents.forEach((c, cIdx) => {
        if (cIdx === idx) c?.classList.remove('hidden');
        else c?.classList.add('hidden');
      });
    });
  });

  // Swipe Copy Buttons
  document.querySelectorAll('.btn-copy-swipe').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const targetIdx = (e.currentTarget as HTMLElement).getAttribute('data-target');
      const contentEl = document.querySelector(`#tab-content-${targetIdx} div`);
      if (!contentEl) return;
      const rawText = contentEl.textContent || '';
      const personalizedText = rawText.replace(/\[LINK_AFFILIATE\]/g, refLinkInput.value);
      try {
        await navigator.clipboard.writeText(personalizedText);
        const originalText = (e.currentTarget as HTMLElement).innerText;
        (e.currentTarget as HTMLElement).innerText = '✓ Đã sao chép bài đăng kèm link của bạn!';
        setTimeout(() => {
          (e.currentTarget as HTMLElement).innerText = originalText;
        }, 3000);
      } catch (err) {
        alert('Đã chọn văn bản. Vui lòng bấm Ctrl+C để sao chép!');
      }
    });
  });
</script>
