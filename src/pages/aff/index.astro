              />
              <button
                id="btn-copy-ref-link"
                type="button"
                class="shrink-0 px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs transition shadow-md flex items-center gap-1"
              >
                <span>📋</span>
                <span id="btn-copy-text">Sao Chép</span>
              </button>
            </div>

            <!-- 1-Click Fast Share Buttons (Zalo, FB, Tele, QR) -->
            <div class="grid grid-cols-4 gap-2 pt-1">
              <button
                id="btn-share-zalo"
                type="button"
                class="flex items-center justify-center gap-1 py-2 px-2 rounded-lg bg-blue-600/20 hover:bg-blue-600/30 border border-blue-500/40 text-blue-300 text-xs font-bold transition"
