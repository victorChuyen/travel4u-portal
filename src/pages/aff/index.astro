---
/**
 * 🏛️ TRAVEL4U SOVEREIGN VIP AFFILIATE & REVENUE PARTNER DASHBOARD
 * Simple, Frictionless, High-Conversion UX/UI ("3 Giây Hiểu Ngay — 1 Chạm Kiếm Tiền")
 * Powered by Firebase Client SDK + Cloudflare Edge Functions + VietQR Instant Payouts
 * Authors: Chairman Victor Chuyen & AI CEO Lucky
 */

import Layout from '../../layouts/Layout.astro';
import { firebaseConfig, FIREBASE_SDK_URLS } from '../../lib/firebaseClient';

const pageTitle = "Bảng Điều Khiển Đối Tác Affiliate VIP (10% - 20% - 30%) | Travel4U & Victor Chuyen";
const pageDescription = "Hệ thống quản lý đối tác tiếp thị liên kết tinh gọn nhất: Sao chép link 1-chạm, theo dõi số dư hoa hồng minh bạch, rút tiền tự động qua VietQR 24/7.";
---

<Layout title={pageTitle} description={pageDescription} locale="vi">
  <main class="min-h-screen bg-[#07111e] text-slate-100 py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">
      
      <!-- TOP NAVIGATION BAR -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 py-3 px-5 mb-8 rounded-2xl bg-slate-900/80 border border-slate-800 backdrop-blur-md">
        <div class="flex items-center space-x-3">
          <a
            href="/"
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-slate-800 hover:bg-[#c9a54e]/20 border border-slate-700 hover:border-[#c9a54e] text-xs font-semibold text-slate-300 hover:text-[#c9a54e] transition group"
          >
            <span class="transition-transform group-hover:-translate-x-1">←</span>
            <span>Về Trang Chủ Travel4U</span>
          </a>
          <a
            href="/pricing"
            class="inline-flex items-center gap-1 text-xs font-bold text-amber-400 hover:text-amber-300 transition"
          >
            <span>⚡</span>
            <span>Bảng Giá Giải Pháp AI</span>
          </a>
        </div>

        <div class="flex items-center space-x-3">
          <!-- Auth / Partner Status Chip -->
          <div id="user-profile-badge" class="flex items-center gap-2 bg-slate-950 px-3 py-1.5 rounded-xl border border-slate-800 text-xs">
