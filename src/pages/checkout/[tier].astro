---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  return [
    {
      params: { tier: 'starter-kit' },
      props: {
        code: 'starter-kit',
        tierNum: 'GÓI 01',
        title: 'OPC AI Starter Kit (DIY)',
        fullPrice: 500000,
        fullPriceDisplay: '500.000 VNĐ ($19)',
        depositAllowed: false,
        depositPrice: 500000,
        depositPriceDisplay: '500.000 VNĐ',
        tagline: 'Tự xây hệ thống AI đầu tiên cho doanh nghiệp',
        badgeColor: 'blue'
      }
    },
    {
      params: { tier: 'builder-sprint' },
      props: {
        code: 'builder-sprint',
        tierNum: 'GÓI 02',
        title: 'OPC AI Builder Sprint (DWY)',
        fullPrice: 3600000,
        fullPriceDisplay: '3.600.000 VNĐ ($139)',
        depositAllowed: true,
        depositPrice: 1800000,
        depositPriceDisplay: '1.800.000 VNĐ (Cọc 50%)',
        tagline: 'Cùng Victor xây một giải pháp AI chạy được thật',
        badgeColor: 'emerald'
      }
    },
    {
      params: { tier: 'revenue-system' },
      props: {
        code: 'revenue-system',
        tierNum: 'GÓI 03',
        title: 'OPC AI Revenue System (DFY)',
        fullPrice: 10000000,
        fullPriceDisplay: '10.000.000 VNĐ ($388)',
        depositAllowed: true,
        depositPrice: 5000000,
        depositPriceDisplay: '5.000.000 VNĐ (Cọc 50%)',
        tagline: 'Victor trực tiếp xây dựng và bàn giao hệ thống AI',
        badgeColor: 'amber'
      }
    }
  ];
}

const { tierNum, title: packageName, fullPrice, fullPriceDisplay, depositAllowed, depositPrice, depositPriceDisplay, tagline, code } = Astro.props;

const pageTitle = `Đặt Hàng & Thanh Toán — ${packageName} | Victor Chuyen`;
const pageDescription = `Trang xác nhận đặt hàng và thanh toán tự động qua VietQR SePay cho ${packageName}.`;
---

<Layout title={pageTitle} description={pageDescription}>
  <Header currentLocale="vi" />

  <main class="min-h-screen bg-[#07111e] text-slate-100 py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      
      <!-- Back links -->
      <div class="flex items-center justify-between py-2 mb-6">
        <a href="/pricing" class="inline-flex items-center gap-2 text-sm text-slate-400 hover:text-amber-400 transition group">
          <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
          <span>Quay lại Bảng Giá</span>
        </a>
        <a href="/" class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-400 hover:text-[#c9a54e] transition">
          <span>🏛️</span>
          <span>Về Trang Chủ Travel4U</span>
        </a>
      </div>

      <!-- Header Card -->
      <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 sm:p-8 mb-8 shadow-xl">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800 pb-6 mb-6">
          <div>
            <span class="inline-block px-3 py-1 rounded bg-amber-500/10 text-amber-400 text-xs font-bold uppercase tracking-wider mb-2">
              {tierNum} — XÁC NHẬN ĐƠN HÀNG
            </span>
            <h1 class="text-2xl sm:text-3xl font-bold text-white">{packageName}</h1>
            <p class="text-slate-400 text-sm mt-1">{tagline}</p>
          </div>
          <div class="text-left sm:text-right">
            <span class="text-xs text-slate-400 block">Đơn giá niêm yết</span>
            <span class="text-2xl sm:text-3xl font-black text-amber-400">{fullPriceDisplay}</span>
          </div>
        </div>

        <!-- TWO COLUMNS: FORM & VIETQR -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          
          <!-- LEFT: INTAKE FORM -->
          <div>
            <h2 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
              <span>📋</span> <span>Thông tin người đặt hàng</span>
            </h2>

            <form id="checkout-form" class="space-y-4">
              <div>
                <label for="cust-name" class="block text-xs font-semibold text-slate-300 uppercase mb-1">Họ và tên *</label>
                <input type="text" id="cust-name" required placeholder="Ví dụ: Nguyễn Văn Tuấn" class="w-full bg-slate-950/80 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 transition" />
              </div>

              <div>
                <label for="cust-phone" class="block text-xs font-semibold text-slate-300 uppercase mb-1">Số điện thoại / Zalo *</label>
                <input type="tel" id="cust-phone" required placeholder="Ví dụ: 0989890022" class="w-full bg-slate-950/80 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 transition" />
              </div>

              <div>
                <label for="cust-email" class="block text-xs font-semibold text-slate-300 uppercase mb-1">Email nhận tài liệu / Hóa đơn *</label>
                <input type="email" id="cust-email" required placeholder="name@company.com" class="w-full bg-slate-950/80 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 transition" />
              </div>

              <div>
                <label for="cust-business" class="block text-xs font-semibold text-slate-300 uppercase mb-1">Doanh nghiệp / Ngành nghề</label>
                <input type="text" id="cust-business" placeholder="Ví dụ: Du lịch, Bất động sản, Spa, SME..." class="w-full bg-slate-950/80 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 transition" />
              </div>

              <!-- Deposit vs Full selector -->
              {depositAllowed ? (
                <div class="pt-2">
                  <label class="block text-xs font-semibold text-slate-300 uppercase mb-2">Hình thức thanh toán</label>
                  <div class="grid grid-cols-2 gap-3">
                    <label class="cursor-pointer border border-amber-500/60 bg-amber-500/10 rounded-xl p-3 flex flex-col text-center has-[:checked]:border-amber-400 has-[:checked]:bg-amber-500/20 transition">
                      <input type="radio" name="payment_type" value="deposit" checked class="sr-only" />
                      <span class="text-xs font-bold text-amber-300">ĐẶT CỌC 50%</span>
                      <span class="text-sm font-extrabold text-white mt-0.5">{depositPriceDisplay}</span>
                    </label>
                    <label class="cursor-pointer border border-slate-700 bg-slate-950/50 rounded-xl p-3 flex flex-col text-center has-[:checked]:border-amber-400 has-[:checked]:bg-amber-500/20 transition">
                      <input type="radio" name="payment_type" value="full" class="sr-only" />
                      <span class="text-xs font-bold text-slate-300">THANH TOÁN 100%</span>
                      <span class="text-sm font-extrabold text-white mt-0.5">{fullPriceDisplay}</span>
                    </label>
                  </div>
                </div>
              ) : (
                <input type="hidden" name="payment_type" value="full" />
              )}
            </form>
          </div>

          <!-- RIGHT: DYNAMIC VIETQR & PAYMENT DETAILS -->
          <div class="bg-slate-950/90 border border-slate-800 rounded-xl p-6 flex flex-col items-center justify-between text-center">
            <div>
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-bold mb-3">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                CỔNG THANH TOÁN TỰ ĐỘNG VIETQR (SEPAY 24/7)
              </span>
              <h3 class="text-sm font-semibold text-slate-300 mb-4">
                Quét mã QR bằng App Ngân hàng bất kỳ
              </h3>

              <!-- RESERVATION TIMER -->
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-semibold mb-3">
                <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
                <span>Đang giữ chỗ ưu đãi:</span>
                <span id="countdown-timer" class="font-mono font-bold text-amber-300">14:59</span>
              </div>

              <!-- QR CODE BOX -->
              <div class="bg-white p-3 rounded-2xl shadow-2xl inline-block mb-4 max-w-[240px]">
                <img id="vietqr-image" src="" alt="VietQR SePay Payment" class="w-full h-auto aspect-square object-contain" />
              </div>

              <!-- Payment Details Summary -->
              <div class="space-y-2 text-xs text-slate-300 bg-slate-900 p-3.5 rounded-xl border border-slate-800 text-left">
                <div class="flex justify-between items-center">
                  <span class="text-slate-400">Ngân hàng:</span>
                  <strong class="text-white">BIDV (Việt Nam)</strong>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-slate-400">Số tài khoản:</span>
                  <div class="flex items-center gap-1.5">
                    <strong class="text-amber-400 font-mono text-sm">96247688688</strong>
                    <button type="button" id="btn-copy-acc" class="text-[10px] bg-slate-800 hover:bg-slate-700 text-amber-300 px-2 py-0.5 rounded border border-slate-700 transition">Copy</button>
                  </div>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-slate-400">Chủ tài khoản:</span>
                  <strong class="text-white uppercase">VICTOR CHUYEN</strong>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-slate-400">Số tiền:</span>
                  <strong id="display-amount" class="text-emerald-400 text-sm font-black"></strong>
                </div>
                <div class="flex justify-between items-center border-t border-slate-800 pt-1.5">
                  <span class="text-slate-400">Nội dung CK:</span>
                  <div class="flex items-center gap-1.5">
                    <strong id="display-reference" class="text-amber-300 font-mono text-xs font-bold"></strong>
                    <button type="button" id="btn-copy-ref" class="text-[10px] bg-slate-800 hover:bg-slate-700 text-amber-300 px-2 py-0.5 rounded border border-slate-700 transition">Copy</button>
                  </div>
                </div>
              </div>
            </div>

            <!-- Action button -->
            <div class="w-full mt-6 space-y-3">
              <button id="btn-confirm-payment" class="w-full py-3 px-6 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-black text-sm transition shadow-lg shadow-amber-500/20">
                XÁC NHẬN ĐÃ CHUYỂN KHOẢN &gt;
              </button>
              
              <a href="https://zalo.me/0989890022" target="_blank" rel="noopener noreferrer" class="block w-full py-2.5 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white text-xs font-semibold transition border border-slate-700">
                Gặp khó khăn? Nhắn Zalo Victor Chuyen (0989890022)
              </a>
            </div>

          </div>

        </div>

      </div>

    </div>
  </main>
  <Footer currentLocale="vi" />
</Layout>

<script define:vars={{ fullPrice, depositPrice, depositAllowed, code, packageName }}>
  // Dynamic order reference generator
  const randomSuffix = Math.floor(1000 + Math.random() * 9000);
  const tierShort = code === 'starter-kit' ? 'OPC19' : (code === 'builder-sprint' ? 'OPC139' : 'OPC388');
  const orderRef = `${tierShort}_${randomSuffix}`;

  let currentAmount = depositAllowed ? depositPrice : fullPrice;

  function updatePaymentQR() {
    const qrImg = document.getElementById('vietqr-image');
    const dispAmount = document.getElementById('display-amount');
    const dispRef = document.getElementById('display-reference');

    if (dispAmount) dispAmount.innerText = Number(currentAmount).toLocaleString('vi-VN') + ' VNĐ';
    if (dispRef) dispRef.innerText = orderRef;

    // VietQR quick URL
    const qrUrl = `https://img.vietqr.io/image/BIDV-96247688688-compact2.png?amount=${currentAmount}&addInfo=${encodeURIComponent(orderRef)}&accountName=VICTOR%20CHUYEN`;
    if (qrImg) qrImg.src = qrUrl;
  }

  // Radio listener
  const radios = document.querySelectorAll('input[name="payment_type"]');
  radios.forEach(r => {
    r.addEventListener('change', (e) => {
      currentAmount = e.target.value === 'deposit' ? depositPrice : fullPrice;
      updatePaymentQR();
    });
  });

  updatePaymentQR();

  // 15-minute countdown timer
  let timeLeft = 14 * 60 + 59;
  const timerEl = document.getElementById('countdown-timer');
  const countdownInterval = setInterval(() => {
    if (timeLeft <= 0) {
      clearInterval(countdownInterval);
      if (timerEl) timerEl.innerText = '00:00';
      return;
    }
    const mins = Math.floor(timeLeft / 60);
    const secs = timeLeft % 60;
    if (timerEl) timerEl.innerText = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
    timeLeft--;
  }, 1000);

  // Quick Copy Account & Order Reference
  const btnCopyAcc = document.getElementById('btn-copy-acc');
  if (btnCopyAcc) {
    btnCopyAcc.addEventListener('click', () => {
      navigator.clipboard.writeText('96247688688');
      btnCopyAcc.innerText = 'Đã chép!';
      setTimeout(() => { btnCopyAcc.innerText = 'Copy'; }, 2000);
    });
  }

  const btnCopyRef = document.getElementById('btn-copy-ref');
  if (btnCopyRef) {
    btnCopyRef.addEventListener('click', () => {
      navigator.clipboard.writeText(orderRef);
      btnCopyRef.innerText = 'Đã chép!';
      setTimeout(() => { btnCopyRef.innerText = 'Copy'; }, 2000);
    });
  }

  // LocalStorage Persistence for Lead Form
  const fieldIds = ['cust-name', 'cust-phone', 'cust-email', 'cust-business'];
  fieldIds.forEach(id => {
    const el = document.getElementById(id);
    if (!el) return;
    const saved = localStorage.getItem(`travel4u_${id}`);
    if (saved) el.value = saved;
    el.addEventListener('input', () => {
      localStorage.setItem(`travel4u_${id}`, el.value);
    });
  });

  // Handle submit confirmation
  const btn = document.getElementById('btn-confirm-payment');
  if (btn) {
    btn.addEventListener('click', async () => {
      const name = document.getElementById('cust-name')?.value || '';
      const phone = document.getElementById('cust-phone')?.value || '';
      const email = document.getElementById('cust-email')?.value || '';
      const business = document.getElementById('cust-business')?.value || '';
      const paymentType = document.querySelector('input[name="payment_type"]:checked')?.value || 'full';

      if (!name || !phone || !email) {
        alert('Vui lòng điền đầy đủ Họ tên, Số điện thoại và Email để hệ thống ghi nhận đối soát đơn hàng!');
        return;
      }

      btn.disabled = true;
      btn.innerText = 'Đang ghi nhận đơn hàng...';

        const refCode = localStorage.getItem('t4u_ref') || '';
        const orderData = {
          order_id: orderRef,
          name,
          phone,
          email,
          business,
          tier: code,
          tier_name: packageName,
          payment_type: paymentType,
          amount_paid: currentAmount,
          amount_remaining: paymentType === 'deposit' ? (fullPrice - depositPrice) : 0,
          status: paymentType === 'deposit' ? 'Đã Cọc 50%' : 'Chờ Đối Soát',
          ref_code: refCode
        };

        const res = await fetch('/api/checkout/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(orderData)
        });

        window.location.href = `/thank-you?order_id=${orderRef}&tier=${code}&amount=${currentAmount}&name=${encodeURIComponent(name)}`;
      } catch (err) {
        window.location.href = `/thank-you?order_id=${orderRef}&tier=${code}&amount=${currentAmount}&name=${encodeURIComponent(name)}`;
      }
    });
  }
</script>
