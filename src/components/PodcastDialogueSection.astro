---
import i18nData from '../data/i18n.json';

interface DialogueLine {
  speaker: string;
  text: string;
}

interface ViralShort {
  title: string;
  hook: string;
  visual: string;
  cta: string;
}

interface Props {
  episodeTitle?: string;
  dialogue?: DialogueLine[];
  shorts?: ViralShort[];
  locale?: string;
}

const {
  episodeTitle = "The Behind-the-Scenes Conversation",
  dialogue = [
    {
      speaker: "Lucky",
      text: "Victor, why would anyone pay a fortune to spend a night here? Is it just the superficial prestige?"
    },
    {
      speaker: "Victor",
      text: "Not at all, Lucky. When you step through these doors, what touches you first is not ostentation, but absolute serenity. Every slab of marble, the scent of fresh morning florals, and the butler greeting you without asking your name—that is the art of living money alone cannot buy."
    },
    {
      speaker: "Lucky",
      text: "And what I love most is dawn. Watching the mist rise over the water while savoring hot cappuccino on the private terrace... it feels as if the entire world belongs only to the two of us."
    },
    {
      speaker: "Victor",
      text: "Precisely. Yet many luxury travelers make one critical mistake: booking via generic OTAs and getting assigned rooms near elevators with obstructed views. That is why we advise reserving through our verified Expedia partner link to secure guaranteed VIP room upgrades."
    }
  ],
  shorts = [
    {
      title: "Short 1: The Sensory Shock",
      hook: "Would you spend $2,000 a night just to wake up here?",
      visual: "Close-up opening terrace doors to the morning breeze, flaky croissant tray and champagne above the abyss.",
      cta: "Access verified VIP upgrade perks at travel4u.us"
    },
    {
      title: "Short 2: The Secret Mistake",
      hook: "The mistake 90% of luxury hotel guests make at check-in!",
      visual: "Victor & Lucky reveal how to request corner sanctuaries and claim $100 resort credit.",
      cta: "Discover sovereign luxury secrets at travel4u.us"
    },
    {
      title: "Short 3: The Unvarnished Truth",
      hook: "Unvarnished review: The only thing this sanctuary is missing?",
      visual: "Candid angles, honest assessment of seasonal trade winds and optimal booking windows.",
      cta: "Read our full curated diary at travel4u.us"
    }
  ],
  locale = "en"
} = Astro.props;

const t = (i18nData as any)[locale] || (i18nData as any)['en'];
---

<section id="podcast-dialogue" class="scroll-mt-24 my-16 bg-[#060f1c] border border-slate-800 rounded-3xl p-6 sm:p-10 shadow-2xl relative overflow-hidden">
  <div class="flex items-center space-x-2 text-[11px] font-bold text-[#c9a54e] uppercase tracking-widest mb-2">
    <span>🎙️</span>
    <span>{t.exp_podcast_studio_badge || "Travel4U Multimedia Studio & Podcast Vault"}</span>
  </div>
  
  <h3 class="font-serif text-2xl sm:text-3xl font-bold text-white mb-2">
    {episodeTitle}
  </h3>
  <p class="text-xs sm:text-sm text-slate-400 mb-8 max-w-2xl">
    {t.exp_podcast_dialogue_sub || "Behind-the-scenes dialogue between Chairman Victor & AI CEO Lucky. Exclusive content curated for upcoming YouTube Podcast and Video Shorts series."}
  </p>

  <!-- Conversational Dialogue Stream -->
  <div class="space-y-4 mb-12">
    {dialogue.map((item) => (
      <div class={`flex items-start space-x-3.5 ${item.speaker === 'Victor' ? 'bg-[#0a1626]/80 border-[#c9a54e]/30' : 'bg-[#09182a]/80 border-blue-500/30'} border rounded-2xl p-4 sm:p-5 transition-all`}>
        <div class={`w-9 h-9 rounded-full flex items-center justify-center font-bold text-xs flex-shrink-0 shadow-md ${item.speaker === 'Victor' ? 'bg-[#c9a54e] text-[#07111e]' : 'bg-blue-500 text-white'}`}>
          {item.speaker === 'Victor' ? 'V' : 'L'}
        </div>
        <div>
          <div class="flex items-center space-x-2 mb-1">
            <span class={`text-xs font-bold ${item.speaker === 'Victor' ? 'text-[#c9a54e]' : 'text-blue-400'}`}>
              {item.speaker === 'Victor' ? 'Chairman Victor' : 'AI CEO Lucky'}
            </span>
            <span class="text-[10px] text-slate-500">· {t.exp_authentic_audio_story || "Authentic Audio Story"}</span>
          </div>
          <p class="text-xs sm:text-sm text-slate-200 leading-relaxed font-serif">
            "{item.text}"
          </p>
        </div>
      </div>
    ))}
  </div>
</section>
