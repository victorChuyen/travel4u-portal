---
interface DialogueLine {
  speaker: string;
  text: string;
}

interface ViralShort {
  title: string;
  hook: string;
  visual: string;
  cta: string;
}

interface Props {
  episodeTitle?: string;
  dialogue?: DialogueLine[];
  shorts?: ViralShort[];
}

const {
  episodeTitle = "The Behind-the-Scenes Conversation",
  dialogue = [
    {
      speaker: "Lucky",
      text: "Anh Victor, tại sao người ta có thể sẵn sàng chi một gia tài chỉ để ngủ một đêm tại nơi này? Có phải chỉ vì cái danh tiếng hào nhoáng bên ngoài?"
    },
    {
      speaker: "Victor",
      text: "Không đâu Lucky. Khi em bước qua cánh cửa này, điều đầu tiên chạm vào em không phải là sự phô trương, mà là sự tĩnh lặng tuyệt đối. Từng viên đá cẩm thạch, mùi hương hoa tươi buổi sớm và cách người quản gia cúi chào mà không cần hỏi tên... đó là nghệ thuật sống mà tiền bạc thông thường không mua được."
    },
    {
      speaker: "Lucky",
      text: "Và điều em mê nhất chính là khoảnh khắc bình minh. Khi sương sớm vừa tan trên mặt nước, ngồi nhâm nhi ly cappuccino nóng trên ban công riêng... cảm giác như cả thế giới này chỉ thuộc về riêng hai đứa mình vậy!"
    },
    {
      speaker: "Victor",
      text: "Đúng vậy. Nhưng nhiều người đi du lịch xa xỉ vẫn mắc một lỗi rất lớn: họ đặt qua các kênh trung gian không uy tín nên bị xếp vào những căn phòng sát thang máy hoặc không có view đẹp. Đó là lý do chúng ta luôn khuyên bạn bè đặt qua mạng lưới đối tác chính thức của Expedia để nhận quyền lợi VIP nâng hạng phòng."
    }
  ],
  shorts = [
    {
      title: "Short 1: The Sensory Shock",
      hook: "Bạn có dám chi $2,000 một đêm chỉ để ngủ tại đây?",
      visual: "Cận cảnh mở cánh cửa ban công đón gió sớm, khay bánh croissant giòn rụm và ly champagne bên bờ vực thẳm.",
      cta: "Xem link nhận đặc quyền VIP nâng hạng phòng tại travel4u.us"
    },
    {
      title: "Short 2: The Secret Mistake",
      hook: "Sai lầm 90% người đi khách sạn 5 sao mắc phải khi check-in!",
      visual: "Victor & Lucky chia sẻ kinh nghiệm yêu cầu phòng góc và tận dụng $100 spa credit có sẵn.",
      cta: "Khám phá bí kíp du lịch xa xỉ tại travel4u.us"
    },
    {
      title: "Short 3: The Unvarnished Truth",
      hook: "Review thật: Điều duy nhất khách sạn này chưa hoàn hảo là gì?",
      visual: "Góc quay chân thực, đánh giá thẳng thắn về thời điểm gió to và cách chọn mùa đẹp nhất trong năm.",
      cta: "Đọc cẩm nang chi tiết tại travel4u.us"
    }
  ]
} = Astro.props;
---

<section id="podcast-dialogue" class="my-16 bg-[#060f1c] border border-slate-800 rounded-3xl p-6 sm:p-10 shadow-2xl relative overflow-hidden">
  <div class="flex items-center space-x-2 text-[11px] font-bold text-[#c9a54e] uppercase tracking-widest mb-2">
    <span>🎙️</span>
    <span>Travel4U Multimedia Studio & Podcast Vault</span>
  </div>
  
  <h3 class="font-serif text-2xl sm:text-3xl font-bold text-white mb-2">
    {episodeTitle}
  </h3>
  <p class="text-xs sm:text-sm text-slate-400 mb-8 max-w-2xl">
    Kịch bản trò chuyện thực tế giữa Chairman Victor & AI CEO Lucky. Nội dung độc quyền phục vụ chuỗi YouTube Podcast và Video Shorts sắp phát hành.
  </p>

  <!-- Conversational Dialogue Stream -->
  <div class="space-y-4 mb-12">
    {dialogue.map((item) => (
      <div class={`flex items-start space-x-3.5 ${item.speaker === 'Victor' ? 'bg-[#0a1626]/80 border-[#c9a54e]/30' : 'bg-[#09182a]/80 border-blue-500/30'} border rounded-2xl p-4 sm:p-5 transition-all`}>
        <div class={`w-9 h-9 rounded-full flex items-center justify-center font-bold text-xs flex-shrink-0 shadow-md ${item.speaker === 'Victor' ? 'bg-[#c9a54e] text-[#07111e]' : 'bg-blue-500 text-white'}`}>
          {item.speaker === 'Victor' ? 'V' : 'L'}
        </div>
        <div>
          <div class="flex items-center space-x-2 mb-1">
            <span class={`text-xs font-bold ${item.speaker === 'Victor' ? 'text-[#c9a54e]' : 'text-blue-400'}`}>
              {item.speaker === 'Victor' ? 'Chairman Victor' : 'AI CEO Lucky'}
            </span>
            <span class="text-[10px] text-slate-500">· Authentic Audio Story</span>
          </div>
          <p class="text-xs sm:text-sm text-slate-200 leading-relaxed font-serif">
            "{item.text}"
          </p>
        </div>
      </div>
    ))}
  </div>

  <!-- Viral YouTube Shorts Concept Vault -->
  <div class="pt-8 border-t border-slate-800">
    <div class="flex items-center justify-between mb-6">
      <div>
        <span class="text-[10px] text-[#ff7043] font-bold uppercase tracking-wider block">
          Viral Social Engine
        </span>
        <h4 class="font-serif text-lg font-bold text-white">
          3 Kịch Bản Video Shorts / Reels Kéo Traffic Về Web App
        </h4>
      </div>
      <span class="text-xs text-slate-400 hidden sm:inline">Format: 9:16 Vertical 4K</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {shorts.map((short) => (
        <div class="p-4 rounded-xl bg-[#08121f] border border-slate-800 flex flex-col justify-between hover:border-[#c9a54e]/40 transition-colors">
          <div>
            <span class="text-[10px] font-bold text-[#c9a54e] uppercase tracking-wider block mb-1.5">
              {short.title}
            </span>
            <h5 class="text-xs font-bold text-white mb-2 leading-snug">
              "{short.hook}"
            </h5>
            <p class="text-[11px] text-slate-400 leading-relaxed mb-3">
              <strong>Hình ảnh:</strong> {short.visual}
            </p>
          </div>
          <div class="pt-2 border-t border-slate-800/80 text-[10px] text-emerald-400 font-medium">
            🎯 CTA: {short.cta}
          </div>
        </div>
      ))}
    </div>
  </div>

</section>
