      <div class="assistant-icon-box">
        <!-- Travelpayouts Origami Flight / Compass Mark -->
        <svg viewBox="0 0 32 32" width="24" height="24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="16" cy="16" r="14" fill="#0084ff" />
