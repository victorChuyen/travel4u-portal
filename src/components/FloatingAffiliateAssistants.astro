---

<style>
  /* ── LUXURY FLOATING ASSISTANT DOCK (ARCHITECTED BY CHAIRMAN VICTOR & LUCKY) ── */
  .luxury-assistant-dock {
    position: fixed;
    right: 20px;
    bottom: max(24px, calc(20px + env(safe-area-inset-bottom)));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    z-index: 99990;
    pointer-events: auto;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .assistant-items-wrapper {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: center;
    transition: all 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
    transform-origin: bottom center;
  }

  .assistant-items-hidden {
    opacity: 0;
    max-height: 0;
    transform: translateY(20px) scale(0.85);
    pointer-events: none;
    overflow: hidden;
    margin: 0;
    gap: 0;
  }

  .assistant-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35), 0 2px 6px rgba(0, 0, 0, 0.15);
    transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.28s ease, filter 0.28s ease;
    cursor: pointer;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(10px);
    user-select: none;
  }

  .assistant-icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    transition: transform 0.28s ease;
  }

  .assistant-tooltip {
    position: absolute;
    right: 64px;
    background: rgba(7, 17, 30, 0.96);
    color: #ffffff;
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    font-size: 11.5px;
    font-weight: 700;
    padding: 7px 13px;
    border-radius: 10px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transform: translateX(10px);
    transition: opacity 0.22s ease, transform 0.22s ease;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(201, 165, 78, 0.4);
    backdrop-filter: blur(12px);
    letter-spacing: 0.01em;
  }

  .assistant-tooltip::after {
    content: "";
    position: absolute;
    top: 50%;
    right: -5px;
    transform: translateY(-50%);
    border-width: 5px 0 5px 5px;
    border-style: solid;
    border-color: transparent transparent transparent rgba(7, 17, 30, 0.96);
  }

  .assistant-btn:hover .assistant-tooltip {
    opacity: 1;
    transform: translateX(0);
  }

  .assistant-btn:hover {
    transform: scale(1.12) translateY(-2px);
  }

  .assistant-btn:hover .assistant-icon-box {
    transform: scale(1.1);
  }

  /* 1. NÚT EXPEDIA CONCIERGE ASSISTANT (Xanh Đậm Hải Quân & Viền Vàng Hoàng Gia) */
  .btn-expedia {
    background: linear-gradient(135deg, #00355f, #001f3f);
    border: 1.5px solid #ffcc00;
    box-shadow: 0 8px 24px rgba(0, 53, 95, 0.55), 0 0 10px rgba(255, 204, 0, 0.35);
  }
  .btn-expedia:hover {
    box-shadow: 0 12px 30px rgba(0, 53, 95, 0.8), 0 0 16px rgba(255, 204, 0, 0.6);
  }

  /* 2. NÚT GETYOURGUIDE VIP ASSISTANT (Đỏ San Hô GYG Rực Rỡ) */
  .btn-gyg {
    background: linear-gradient(135deg, #ff5533, #d9381e);
    border: 1.5px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 8px 24px rgba(255, 85, 51, 0.5);
  }
  .btn-gyg:hover {
    box-shadow: 0 12px 30px rgba(255, 85, 51, 0.75);
  }

  /* 3. NÚT TRAVELPAYOUTS MOBILITY ASSISTANT (Xanh Dương Điện Tử) */
  .btn-travelpayouts {
    background: linear-gradient(135deg, #0084ff, #0052cc);
    border: 1.5px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 8px 24px rgba(0, 132, 255, 0.45);
  }
  .btn-travelpayouts:hover {
    box-shadow: 0 12px 30px rgba(0, 132, 255, 0.7);
  }

  /* 4. NÚT TOGGLE ĐÓNG / MỞ MENU TRỢ LÝ */
  .btn-toggle-assistant {
    background: linear-gradient(135deg, #07111e, #0f2137);
    border: 1.5px solid #c9a54e;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4), 0 0 12px rgba(201, 165, 78, 0.35);
  }
  .btn-toggle-assistant:hover {
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.6), 0 0 18px rgba(201, 165, 78, 0.6);
    border-color: #ffd700;
  }
  .btn-toggle-close {
    background: linear-gradient(135deg, #1e293b, #0f172a);
    border-color: rgba(255, 255, 255, 0.4);
  }
  .btn-toggle-close:hover {
    background: linear-gradient(135deg, #ef4444, #dc2626);
    border-color: #ffffff;
    box-shadow: 0 10px 28px rgba(239, 68, 68, 0.5);
  }
  .btn-toggle-open {
    animation: assistantGlow 2.8s infinite;
  }

  @keyframes assistantGlow {
    0%, 100% {
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4), 0 0 12px rgba(201, 165, 78, 0.35);
    }
    50% {
      box-shadow: 0 12px 28px rgba(201, 165, 78, 0.6), 0 0 20px rgba(201, 165, 78, 0.5);
      transform: scale(1.04);
    }
  }

  /* RESPONSIVE MOBILE TWEAKS */
  @media (max-width: 768px) {
    .luxury-assistant-dock {
      right: 12px !important;
      bottom: max(72px, calc(68px + env(safe-area-inset-bottom))) !important;
      gap: 10px !important;
    }
    .assistant-items-wrapper {
      gap: 10px !important;
    }
    .assistant-btn {
      width: 44px !important;
      height: 44px !important;
    }
    .assistant-icon-box svg {
      width: 20px !important;
      height: 20px !important;
    }
    .assistant-tooltip {
      display: none !important;
    }
  }
</style>

<!-- LUXURY ASSISTANT FLOATING SPEED-DIAL -->
<div class="luxury-assistant-dock" id="luxuryAssistantDock">
  
