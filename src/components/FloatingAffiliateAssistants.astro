<script is:inline>
  (function initAssistantDock() {
    const STORAGE_KEY = 't4u_affiliate_assistants_dock_open';
    const wrapper = document.getElementById('assistantItemsWrapper');
    const toggleBtn = document.getElementById('btnToggleAssistantDock');
    const tooltip = document.getElementById('assistantToggleTooltip');
    const iconClose = document.getElementById('iconClose');
    const iconOpen = document.getElementById('iconOpen');

    if (!wrapper || !toggleBtn) return;

    // Read saved dock state: default open on desktop, collapsed on small mobile
    let isOpen = true;
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved !== null) {
        isOpen = saved === 'true';
      } else if (window.innerWidth < 768) {
        isOpen = false;
      }
    } catch (e) {
      isOpen = true;
    }

    function renderState(open) {
      if (open) {
        wrapper.classList.remove('assistant-items-hidden');
        toggleBtn.classList.add('btn-toggle-close');
        toggleBtn.classList.remove('btn-toggle-open');
        toggleBtn.setAttribute('aria-expanded', 'true');
        if (iconClose) iconClose.classList.remove('hidden');
        if (iconOpen) {
          iconOpen.classList.add('hidden');
          iconOpen.classList.remove('flex');
        }
        if (tooltip) tooltip.textContent = '✕ Đóng Menu Trợ Lý';
      } else {
        wrapper.classList.add('assistant-items-hidden');
        toggleBtn.classList.remove('btn-toggle-close');
        toggleBtn.classList.add('btn-toggle-open');
        toggleBtn.setAttribute('aria-expanded', 'false');
        if (iconClose) iconClose.classList.add('hidden');
        if (iconOpen) {
          iconOpen.classList.remove('hidden');
          iconOpen.classList.add('flex');
        }
        if (tooltip) tooltip.textContent = '✨ Mở Menu Trợ Lý VIP (Expedia • GYG • Travelpayouts)';
      }
    }

    // Initial render
    renderState(isOpen);

    // Toggle click handler
    toggleBtn.addEventListener('click', (e) => {
      e.preventDefault();
      isOpen = !isOpen;
      try {
        localStorage.setItem(STORAGE_KEY, String(isOpen));
      } catch (err) {}
      renderState(isOpen);
    });

    // Track platform click events
    document.querySelectorAll('.track-assistant-click').forEach(btn => {
      btn.addEventListener('click', () => {
        const platform = btn.getAttribute('data-platform');
        if (window.t4uAnalytics && typeof window.t4uAnalytics.trackEvent === 'function') {
          window.t4uAnalytics.trackEvent('affiliate_assistant_clicked', { platform });
        }
      });
    });
  })();
</script>
