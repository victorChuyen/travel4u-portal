---
/**
 * 👑 TRAVEL4U — INTENT-BASED AFFILIATE OFFER LAYER (PHASE 4)
 * Displays categorized affiliate-ready offers with FTC-compliant disclosures,
 * fit scores, and measurable outbound click tracking.
 */
---

<section id="intent-offers-section" class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 my-16">
  <div class="border border-[#c9a54e]/40 bg-gradient-to-b from-[#091424] to-[#040810] rounded-3xl p-6 sm:p-10 shadow-2xl relative overflow-hidden">
    
    <!-- Background Luxury Glow -->
    <div class="absolute -top-32 -right-32 w-80 h-80 bg-[#c9a54e]/10 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 pb-6 border-b border-slate-800 gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#c9a54e]/10 border border-[#c9a54e]/30 text-[#c9a54e] text-xs font-semibold mb-2">
          <span>👑</span> <span>Curated Partner Solutions</span>
        </div>
        <h3 class="text-2xl sm:text-3xl font-bold font-serif text-white tracking-tight">
          Verified Sanctuary & Experience Offers
        </h3>
        <p class="text-slate-400 text-xs sm:text-sm mt-1 max-w-xl">
          Pre-audited travel categories matching your personalized itinerary. Every link is transparently disclosed.
        </p>
      </div>

      <div class="text-left md:text-right shrink-0">
        <span class="text-[11px] font-medium text-slate-400 block">
          Affiliate Disclosure:
        </span>
        <span class="text-[10px] text-slate-500 max-w-xs block">
          We may earn a commission when you book through these verified partners at no additional cost to you.
        </span>
      </div>
    </div>

    <!-- Dynamic Offer Cards Grid -->
    <div id="offer-cards-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <!-- Static Default Offers (Updated dynamically on intent change) -->
      <div class="offer-card bg-slate-900/80 border border-slate-800 hover:border-[#c9a54e]/70 rounded-2xl p-5 flex flex-col justify-between transition-all duration-300 hover:shadow-xl hover:shadow-black/60 group">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="text-2xl">🏨</span>
            <span class="text-[10px] font-bold px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
              96% Match
            </span>
          </div>
          <span class="text-[11px] font-bold text-[#c9a54e] uppercase tracking-wider block">Hotels & Resorts · Expedia</span>
          <h4 class="text-base font-bold text-white mt-1 group-hover:text-[#c9a54e] transition">
            Forbes 5-Star Suites & Sanctuaries
          </h4>
          <p class="text-xs text-slate-300 mt-2 line-clamp-2">
            Complimentary breakfast, room upgrades, and late check-out with verified Expedia rates.
          </p>
          <ul class="mt-3 space-y-1 text-[11px] text-slate-400">
            <li class="flex items-center gap-1.5"><span class="text-emerald-400">✓</span> Verified VIP amenities</li>
            <li class="flex items-center gap-1.5"><span class="text-emerald-400">✓</span> Flexible cancellation options</li>
          </ul>
        </div>
        <div class="mt-5 pt-3 border-t border-slate-800/80">
          <div class="flex items-center justify-between">
            <span class="text-[10px] text-slate-400">Affiliate Link · Expedia</span>
            <a
              href="/go/paris-four-seasons-george-v"
              class="btn-offer-click px-3.5 py-1.5 rounded-xl bg-[#c9a54e] hover:bg-[#dfc06e] text-slate-950 font-bold text-xs transition shadow"
              data-category="hotel"
              data-provider="expedia"
            >
              Check Availability →
            </a>
          </div>
        </div>
      </div>

      <!-- Offer 2: GetYourGuide VIP Tours -->
      <div class="offer-card bg-slate-900/80 border border-slate-800 hover:border-[#c9a54e]/70 rounded-2xl p-5 flex flex-col justify-between transition-all duration-300 hover:shadow-xl hover:shadow-black/60 group">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="text-2xl">🎟️</span>
            <span class="text-[10px] font-bold px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
              94% Match
            </span>
          </div>
          <span class="text-[11px] font-bold text-[#c9a54e] uppercase tracking-wider block">Tours & Activities · GetYourGuide</span>
          <h4 class="text-base font-bold text-white mt-1 group-hover:text-[#c9a54e] transition">
            Skip-the-Line & Private Masterclasses
          </h4>
          <p class="text-xs text-slate-300 mt-2 line-clamp-2">
            VIP museum access, private yacht charters, and authentic Michelin culinary tastings.
          </p>
          <ul class="mt-3 space-y-1 text-[11px] text-slate-400">
            <li class="flex items-center gap-1.5"><span class="text-emerald-400">✓</span> 8% Direct Partner Guarantee</li>
            <li class="flex items-center gap-1.5"><span class="text-emerald-400">✓</span> Instant mobile confirmations</li>
          </ul>
        </div>
        <div class="mt-5 pt-3 border-t border-slate-800/80">
          <div class="flex items-center justify-between">
            <span class="text-[10px] text-slate-400">Affiliate Link · Partner 4G5BPIE</span>
            <a
              href="https://www.getyourguide.com/?partner_id=4G5BPIE&utm_medium=online_publisher"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-offer-click px-3.5 py-1.5 rounded-xl bg-[#c9a54e] hover:bg-[#dfc06e] text-slate-950 font-bold text-xs transition shadow"
              data-category="tours"
              data-provider="getyourguide"
            >
              Explore Experiences →
            </a>
          </div>
        </div>
      </div>

      <!-- Offer 3: Welcome Pickups Chauffeur -->
      <div class="offer-card bg-slate-900/80 border border-slate-800 hover:border-[#c9a54e]/70 rounded-2xl p-5 flex flex-col justify-between transition-all duration-300 hover:shadow-xl hover:shadow-black/60 group">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="text-2xl">🚘</span>
            <span class="text-[10px] font-bold px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
              90% Match
            </span>
          </div>
          <span class="text-[11px] font-bold text-[#c9a54e] uppercase tracking-wider block">Transfers · Welcome Pickups</span>
          <h4 class="text-base font-bold text-white mt-1 group-hover:text-[#c9a54e] transition">
            Private Airport Chauffeur Service
          </h4>
          <p class="text-xs text-slate-300 mt-2 line-clamp-2">
            Executive drivers waiting in arrivals with luggage assistance and pre-paid fixed fares.
          </p>
          <ul class="mt-3 space-y-1 text-[11px] text-slate-400">
            <li class="flex items-center gap-1.5"><span class="text-emerald-400">✓</span> Flight tracking included</li>
            <li class="flex items-center gap-1.5"><span class="text-emerald-400">✓</span> 60 min complimentary wait time</li>
          </ul>
        </div>
        <div class="mt-5 pt-3 border-t border-slate-800/80">
          <div class="flex items-center justify-between">
            <span class="text-[10px] text-slate-400">Affiliate Link · Fixed Rate</span>
            <a
              href="https://welcomepickups.com/?tap_a=26090-3a5f70&tap_s=770720"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-offer-click px-3.5 py-1.5 rounded-xl bg-slate-800 hover:bg-[#c9a54e] hover:text-slate-950 text-white font-bold text-xs transition border border-slate-700"
              data-category="transfer"
              data-provider="welcome_pickups"
            >
              Reserve Chauffeur →
            </a>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  import { trackTravelEvent } from '../lib/analytics';

  // Attach click listener for qualified outbound tracking
  document.querySelectorAll('.btn-offer-click').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const category = btn.getAttribute('data-category') || 'general';
      const provider = btn.getAttribute('data-provider') || 'partner';
      
      trackTravelEvent({
        event: 'offer_click',
        offer_category: category,
        offer_provider: provider,
        ui_placement: 'intent_offers_section'
      });
    });
  });

  // Dynamic reload helper
  (window as any).loadIntentOffers = async function(intent: any) {
    try {
      const res = await fetch('/api/offers/recommend', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ intent })
      });
      const data = await res.json();
      console.log('[Offers Loaded]:', data.total_offers);
    } catch (err) {
      console.warn('Failed to dynamically reload offers:', err);
    }
  };
</script>
