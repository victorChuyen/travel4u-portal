---
interface Props {
  currentSlug: string;
  locale?: string;
  destinations: any[];
}

const { currentSlug, locale = 'en', destinations } = Astro.props;

// Determine current destination
const currentDest = destinations.find(d => Object.values(d.slugs).includes(currentSlug)) || destinations[0];
const currentEnSlug = currentDest.slugs.en;

// Define Semantic Clusters for intelligent cross-linking
const CLUSTERS: Record<string, string[]> = {
  // Lake Como & Italy Cluster
  'passalacqua-lake-como': ['villa-deste-lake-como', 'como-grand-hotel-tremezzo', 'venice-gritti-palace', 'rome-rocco-forte-de-russie'],
  'villa-deste-lake-como': ['passalacqua-lake-como', 'como-grand-hotel-tremezzo', 'venice-gritti-palace', 'rome-rocco-forte-de-russie'],
  'como-grand-hotel-tremezzo': ['passalacqua-lake-como', 'villa-deste-lake-como', 'venice-gritti-palace', 'rome-rocco-forte-de-russie'],
  'venice-gritti-palace': ['rome-rocco-forte-de-russie', 'passalacqua-lake-como', 'villa-deste-lake-como', 'como-grand-hotel-tremezzo'],
  'rome-rocco-forte-de-russie': ['venice-gritti-palace', 'passalacqua-lake-como', 'villa-deste-lake-como', 'paris-four-seasons-george-v'],

  // Japan Cluster
  'kyoto-ritz-carlton': ['hoshinoya-kyoto-arashiyama', 'gora-kadan-hakone-onsen', 'passalacqua-lake-como'],
  'hoshinoya-kyoto-arashiyama': ['kyoto-ritz-carlton', 'gora-kadan-hakone-onsen', 'the-nautilus-maldives'],
  'gora-kadan-hakone-onsen': ['hoshinoya-kyoto-arashiyama', 'kyoto-ritz-carlton', 'swiss-chedi-andermatt'],

  // Maldives Cluster
  'maldives-soneva-jani': ['cheval-blanc-randheli-maldives', 'the-nautilus-maldives', 'dubai-burj-al-arab'],
  'cheval-blanc-randheli-maldives': ['maldives-soneva-jani', 'the-nautilus-maldives', 'paris-four-seasons-george-v'],
  'the-nautilus-maldives': ['cheval-blanc-randheli-maldives', 'maldives-soneva-jani', 'amangiri-canyon-point-utah'],

  // Swiss Alps & Longevity Cluster
  'swiss-chedi-andermatt': ['badrutts-palace-st-moritz', 'clinique-la-prairie-montreux', 'gora-kadan-hakone-onsen'],
  'badrutts-palace-st-moritz': ['swiss-chedi-andermatt', 'clinique-la-prairie-montreux', 'paris-four-seasons-george-v'],
  'clinique-la-prairie-montreux': ['swiss-chedi-andermatt', 'badrutts-palace-st-moritz', 'hoshinoya-kyoto-arashiyama'],

  // US Wilderness & Desert Cluster
  'utah-sorrel-river-ranch': ['amangiri-canyon-point-utah', 'singita-sasakwa-lodge-serengeti', 'serengeti-four-seasons-safari'],
  'amangiri-canyon-point-utah': ['utah-sorrel-river-ranch', 'swiss-chedi-andermatt', 'the-nautilus-maldives'],

  // African Safari Cluster
  'serengeti-four-seasons-safari': ['singita-sasakwa-lodge-serengeti', 'utah-sorrel-river-ranch', 'maldives-soneva-jani'],
  'singita-sasakwa-lodge-serengeti': ['serengeti-four-seasons-safari', 'amangiri-canyon-point-utah', 'badrutts-palace-st-moritz'],

  // Palaces & Global Icons
  'paris-four-seasons-george-v': ['dubai-burj-al-arab', 'venice-gritti-palace', 'badrutts-palace-st-moritz'],
  'dubai-burj-al-arab': ['paris-four-seasons-george-v', 'cheval-blanc-randheli-maldives', 'maldives-soneva-jani']
};

const siblingSlugs = CLUSTERS[currentEnSlug] || [];
let relatedDestinations = destinations.filter(d => siblingSlugs.includes(d.slugs.en)).slice(0, 3);

// Fallback if needed
if (relatedDestinations.length < 3) {
  const others = destinations.filter(d => d.slugs.en !== currentEnSlug && !relatedDestinations.some(r => r.slugs.en === d.slugs.en));
  relatedDestinations = [...relatedDestinations, ...others].slice(0, 3);
}

