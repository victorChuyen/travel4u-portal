const t = dict[locale] || dict.en;
---

<section class="mt-16 pt-12 border-t border-slate-800">
  <div class="text-center max-w-2xl mx-auto mb-10">
    <span class="text-xs font-bold text-[#c9a54e] uppercase tracking-[0.2em] block mb-2">
      Topical Sovereign Mesh
    </span>
    <h2 class="font-serif text-2xl sm:text-3xl font-bold text-white tracking-tight">
      {t.title}
    </h2>
    <p class="text-xs text-slate-400 mt-2">
      {t.subtitle}
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {relatedDestinations.map((rel) => {
      const relSlug = rel.slugs[locale] || rel.slugs.en;
      const relUrl = locale === 'en' ? `/experience/${relSlug}/` : `/${locale}/experience/${relSlug}/`;
      const relTitle = rel.english_title.split(':')[0].replace(/^Inside\s+/i, '').trim();
      const webpImg = rel.hero_image.replace('.jpg', '.webp');

      return (
        <div class="group bg-[#0b1726] border border-slate-800 rounded-2xl overflow-hidden hover:border-[#c9a54e]/60 transition-all duration-300 hover:shadow-2xl hover:shadow-[#c9a54e]/10 flex flex-col justify-between">
          <div class="relative aspect-[16/10] overflow-hidden bg-slate-900">
            <picture>
              <source srcset={webpImg} type="image/webp" />
              <img
                src={rel.hero_image}
                alt={relTitle}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </picture>
            <div class="absolute inset-0 bg-gradient-to-t from-[#0b1726] via-transparent to-transparent"></div>
            <div class="absolute top-3 left-3 bg-[#07111e]/90 backdrop-blur-md px-2.5 py-1 rounded-full border border-slate-700 text-[10px] text-[#c9a54e] font-bold uppercase tracking-wider">
              {rel.location}
            </div>
            <div class="absolute bottom-2.5 right-3 text-amber-400 text-xs font-bold flex items-center space-x-1 bg-[#07111e]/80 px-2 py-0.5 rounded-full border border-slate-700">
              <span>★</span>
              <span>5.0</span>
            </div>
          </div>

          <div class="p-5 flex flex-col flex-grow justify-between">
            <div>
              <h3 class="font-serif text-base font-bold text-white group-hover:text-[#c9a54e] transition-colors line-clamp-1 mb-1">
                <a href={relUrl}>
                  {relTitle}
                </a>
              </h3>
              <p class="text-xs text-slate-400 font-mono mb-4">
                {rel.price_display.split('(')[0]}
              </p>
            </div>

            <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between gap-2">
              <a
                href={relUrl}
                class="text-xs font-bold text-slate-300 hover:text-white flex items-center space-x-1 transition-colors"
              >
                <span>{t.readGuide}</span>
                <span>→</span>
              </a>

              <a
                href={rel.expedia_direct_link || `/go/${rel.slugs.en}`}
                target="_blank"
                rel="nofollow sponsored noopener"
                class="bg-gradient-to-r from-[#c9a54e] to-[#dfba63] text-[#07111e] text-[11px] font-bold px-3 py-1.5 rounded-lg shadow hover:brightness-110 transition-all"
              >
                {t.reserve}
              </a>
            </div>
          </div>
        </div>
      );
    })}
  </div>
</section>
