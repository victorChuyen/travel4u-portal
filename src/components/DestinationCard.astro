---
interface Props {
  title: string;
  slug: string;
  location: string;
  image: string;
  rating: string;
  price: string;
  gygLink?: string;
  expediaLink?: string;
  locale?: string;
  region?: string;
  category?: string;
  postId?: string;
}

const {
  title,
  slug,
  location,
  image,
  rating,
  price,
  gygLink = '',
  expediaLink = '',
  locale = 'en',
  region = 'Global Luxury',
  category = '5-Star Luxury Stay',
  postId = slug
} = Astro.props;

const detailUrl = locale === 'en' ? `/experience/${slug}/` : `/${locale}/experience/${slug}/`;
const bookingUrl = expediaLink || gygLink || `/go/${slug}`;

const cardLabels: Record<string, {
  nightlyRate: string;
  verifiedDesc: string;
  viewSuite: string;
  checkRates: string;
  saveWishlist: string;
  share: string;
}> = {
  en: {
    nightlyRate: 'Nightly Rate',
    verifiedDesc: `${rating} · Verified 5-star sanctuary with VIP breakfast, upgrade eligibility & Expedia Partner rates.`,
    viewSuite: 'View Guide',
    checkRates: 'Check Rates',
    saveWishlist: 'Save to Wishlist',
    share: 'Share Luxury Sanctuary'
  },
  vi: {
    nightlyRate: 'Khởi Điểm / Đêm',
    verifiedDesc: `${rating} · Điểm lưu trú 5 sao danh giá với đặc quyền ăn sáng VIP & giá ưu đãi đối tác Expedia.`,
    viewSuite: 'Xem Cẩm Nang',
    checkRates: 'Xem Giá Phòng',
    saveWishlist: 'Lưu Vào Wishlist',
    share: 'Chia Sẻ Điểm Đến'
  },
  de: {
    nightlyRate: 'Ab / Nacht',
    verifiedDesc: `${rating} · Verifiziertes 5-Sterne-Refugium mit VIP-Frühstück, Upgrade-Option & Expedia-Vorteilen.`,
    viewSuite: 'Führer ansehen',
    checkRates: 'Preise prüfen',
    saveWishlist: 'Auf die Wunschliste',
    share: 'Refugium teilen'
  },
  fr: {
    nightlyRate: 'Dès / Nuit',
    verifiedDesc: `${rating} · Sanctuaire 5 étoiles vérifié avec petit-déjeuner VIP, surclassement éligible et tarifs Expedia.`,
    viewSuite: 'Voir le guide',
    checkRates: 'Vérifier les tarifs',
    saveWishlist: 'Ajouter aux favoris',
    share: 'Partager le sanctuaire'
  },
  es: {
    nightlyRate: 'Desde / Noche',
    verifiedDesc: `${rating} · Santuario de 5 estrellas verificado con desayuno VIP, opción de mejora y tarifas Expedia.`,
    viewSuite: 'Ver guía',
    checkRates: 'Consultar precios',
    saveWishlist: 'Guardar en favoritos',
    share: 'Compartir santuario'
  },
  it: {
    nightlyRate: 'A partire da / Notte',
    verifiedDesc: `${rating} · Santuario a 5 stelle verificato con colazione VIP, possibilità di upgrade e tariffe Expedia.`,
    viewSuite: 'Vedi guida',
    checkRates: 'Verifica prezzi',
    saveWishlist: 'Salva nei preferiti',
    share: 'Condividi santuario'
  },
  ja: {
    nightlyRate: '1泊あたりの目安',
    verifiedDesc: `${rating} · VIP朝食、客室アップグレード優先権、Expedia公式パートナー優待が確認された5つ星ホテル。`,
    viewSuite: '詳細ガイドを見る',
    checkRates: '空室と料金を確認',
    saveWishlist: 'お気に入りに保存',
    share: 'この宿を共有'
  },
  ko: {
    nightlyRate: '1박 기준 요금',
    verifiedDesc: `${rating} · VIP 조식 무료, 객실 업그레이드 우선권 및 익스피디아 파트너 혜택이 검증된 5성급 호텔.`,
    viewSuite: '가이드 보기',
    checkRates: '요금 확인',
    saveWishlist: '위시리스트 저장',
    share: '생크추어리 공유'
  },
  'zh-tw': {
    nightlyRate: '每晚起價',
    verifiedDesc: `${rating} · 官方認證五星級頂級旅宿，享雙人VIP精緻早餐、優先升等資格與Expedia夥伴特惠。`,
    viewSuite: '查看深度指南',
    checkRates: '查詢即時房價',
    saveWishlist: '收藏至心願清單',
    share: '分享這座秘境'
  },
  'zh-cn': {
    nightlyRate: '每晚起价',
    verifiedDesc: `${rating} · 官方认证五星级顶级酒店，享双人VIP精致早餐、优先升等资格与Expedia伙伴特惠。`,
    viewSuite: '查看深度指南',
    checkRates: '查询实时房价',
    saveWishlist: '收藏至心愿单',
    share: '分享这座秘境'
  },
  pt: {
    nightlyRate: 'A partir de / Noite',
    verifiedDesc: `${rating} · Santuário de 5 estrelas verificado com pequeno-almoço VIP, elegibilidade a upgrade e tarifas Expedia.`,
    viewSuite: 'Ver guia',
    checkRates: 'Verificar tarifas',
    saveWishlist: 'Guardar nos favoritos',
    share: 'Partilhar santuário'
  },
  ru: {
    nightlyRate: 'От / ночь',
    verifiedDesc: `${rating} · Проверенный 5-звездочный отель с бесплатным VIP-завтраком, возможностью повышения категории и ценами Expedia.`,
    viewSuite: 'Смотреть гид',
    checkRates: 'Узнать цены',
    saveWishlist: 'Сохранить в избранное',
    share: 'Поделиться'
  }
};

const labels = cardLabels[locale] || cardLabels.en;
const nightlyRateLabel = labels.nightlyRate;
const verifiedDesc = labels.verifiedDesc;
const viewSuiteLabel = labels.viewSuite;
const checkRatesLabel = labels.checkRates;
const saveWishlistLabel = labels.saveWishlist;
const shareLabel = labels.share;
---

<div
  class="destination-card-item group bg-[#0b1726] border border-slate-800 rounded-2xl overflow-hidden hover:border-[#c9a54e]/60 transition-all duration-300 hover:shadow-2xl hover:shadow-[#c9a54e]/10 flex flex-col h-full relative"
  data-title={title}
  data-location={location}
  data-region={region}
  data-category={category}
  data-id={postId}
>
  
  <!-- Image Container -->
  <div class="relative aspect-[16/10] overflow-hidden bg-slate-900">
    <img
      src={image}
      alt={title}
      loading="eager"
      onerror="this.onerror=null;this.src='/media/expedia_hotels/expedia_paris_four_seasons_george_v_hero_4k.jpg'"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#0b1726] via-transparent to-black/40"></div>
    
    <!-- Top Left: Location Badge -->
    <div class="absolute top-3.5 left-3.5 flex items-center space-x-2">
      <span class="bg-[#07111e]/90 backdrop-blur-md text-[#c9a54e] text-[11px] font-bold uppercase tracking-wider px-3 py-1 rounded-full border border-[#c9a54e]/30 shadow-md">
        {location}
      </span>
    </div>

    <!-- Top Right: Action Buttons (Bookmark Heart & Social Share) -->
    <div class="absolute top-3.5 right-3.5 flex items-center space-x-1.5 z-10">
      
      <!-- Bookmark Heart Button -->
      <button
        type="button"
        class="bookmark-btn w-8 h-8 rounded-full bg-[#07111e]/90 backdrop-blur-md border border-slate-700 text-slate-300 hover:text-red-500 hover:border-red-500/50 flex items-center justify-center transition-all shadow-md focus:outline-none"
        data-slug={slug}
        title={saveWishlistLabel}
        aria-label={saveWishlistLabel}
      >
        <svg class="heart-icon w-4 h-4 transition-transform duration-200 active:scale-125" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
        </svg>
      </button>

      <!-- Quick Share Button -->
      <button
        type="button"
        class="card-share-btn w-8 h-8 rounded-full bg-[#07111e]/90 backdrop-blur-md border border-slate-700 text-slate-300 hover:text-[#c9a54e] hover:border-[#c9a54e]/50 flex items-center justify-center transition-all shadow-md focus:outline-none"
        data-url={detailUrl}
        data-title={title}
        title={shareLabel}
        aria-label={shareLabel}
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
        </svg>
      </button>

    </div>

    <!-- Bottom Left: Price Overlay -->
    <div class="absolute bottom-3 left-3.5">
      <span class="text-[10px] text-slate-300 block uppercase tracking-wider font-medium">{nightlyRateLabel}</span>
      <span class="text-base font-bold text-white font-serif">{price}</span>
    </div>

    <!-- Bottom Right: Social Proof Rating & Likes -->
    <div class="absolute bottom-3 right-3.5 flex items-center space-x-2">
      <span class="bg-[#07111e]/90 backdrop-blur-md text-amber-400 text-xs font-semibold px-2.5 py-1 rounded-full border border-slate-700 shadow-md flex items-center space-x-1">
        <span>★</span>
        <span>{rating.split(' ')[0]}</span>
      </span>
    </div>
  </div>

  <!-- Content Body -->
  <div class="p-5 flex flex-col flex-grow justify-between">
    <div>
      <h3 class="font-serif text-lg font-bold text-white group-hover:text-[#c9a54e] transition-colors leading-snug mb-2 line-clamp-2">
        <a href={detailUrl}>
          {title}
        </a>
      </h3>
      <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed mb-4">
        {verifiedDesc}
      </p>
    </div>

    <!-- Actions -->
    <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between gap-3">
      <a
        href={detailUrl}
        class="text-xs font-bold text-slate-300 hover:text-white flex items-center space-x-1 transition-colors"
      >
        <span>{viewSuiteLabel}</span>
        <span>→</span>
      </a>

      <a
        href={bookingUrl}
        target="_blank"
        rel="nofollow sponsored noopener"
        class="bg-[#c9a54e] hover:bg-[#d8b560] text-[#07111e] text-xs font-bold px-4 py-2.5 rounded-xl shadow-md shadow-[#c9a54e]/20 hover:shadow-[#c9a54e]/40 transition-all text-center flex items-center space-x-1.5"
      >
        <span>{checkRatesLabel}</span>
        <span>→</span>
      </a>
    </div>

  </div>

</div>
