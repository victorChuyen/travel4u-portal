---
/**
 * 🏛️ TRAVEL4U VIP LUXURY DISPATCH & EBOOK GUIDE MODAL
 * High-Converting Affiliate Lead Magnet (Affiliate Media Model)
 * Allows travelers & readers to subscribe for:
 *   - The 2026 Global Luxury Sanctuaries Gold List (Curated by Victor & Lucky)
 *   - Unadvertised secret perks & upgrade hacks (Expedia, GYG, Travelpayouts)
 * Strict 1-1-1-1 Luxury Focus: No manual tour design, Email-first VIP dispatch.
 */

interface Props {
  currentLocale?: string;
}

const { currentLocale = 'vi' } = Astro.props;
const isVi = currentLocale === 'vi';
---

<!-- LUXURY VIP DISPATCH & GUIDE POPUP MODAL -->
<div
  id="concierge-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/85 backdrop-blur-md hidden opacity-0 transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
>
  <div class="relative w-full max-w-lg rounded-3xl border border-[#c9a54e]/50 bg-gradient-to-b from-[#0c182b] via-[#091322] to-[#060d17] p-6 sm:p-8 shadow-2xl text-slate-100 overflow-hidden">
    
    <!-- Ambient Gold Glow -->
    <div class="absolute -top-20 -right-20 w-48 h-48 bg-amber-500/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-20 -left-20 w-48 h-48 bg-[#c9a54e]/10 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Close Button -->
    <button
      id="close-concierge-btn"
      type="button"
      class="absolute top-5 right-5 w-8 h-8 rounded-full bg-slate-800/80 hover:bg-slate-700 text-slate-400 hover:text-white flex items-center justify-center transition border border-slate-700"
      aria-label="Close modal"
    >
      ✕
    </button>

    <!-- Modal Content: Subscription Form -->
    <div id="concierge-form-view">
      <div class="mb-5">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-[11px] font-bold uppercase tracking-wider mb-2">
          <span>👑 TRAVEL4U PRIVATE DISPATCH • VICTOR & LUCKY</span>
        </div>
        <h3 class="text-xl sm:text-2xl font-bold text-white font-serif tracking-tight">
          {isVi ? 'Nhận Cẩm Nang Khách Sạn Xa Xỉ & Ưu Đãi VIP Mới Nhất' : 'Get The 2026 VIP Luxury Travel Guide & Secret Perks'}
        </h3>
        <p class="text-xs text-slate-300 mt-1.5 leading-relaxed">
          {isVi
            ? 'Đăng ký nhận ngay Cẩm nang Tuyển chọn 100+ Thánh địa Nghỉ dưỡng Xa xỉ Toàn cầu (Gold List 2026), mẹo nâng hạng phòng Suite miễn phí và các mã ưu đãi ẩn hàng tuần từ Expedia, GetYourGuide & Travelpayouts.'
            : 'Subscribe to receive the curated 2026 Global Luxury Sanctuaries Gold List (PDF Guide), complimentary suite upgrade tips, and weekly unadvertised perks from Expedia, GetYourGuide & Travelpayouts.'}
        </p>
      </div>

      <!-- VIP Value Stack Bullets -->
      <div class="mb-5 p-3.5 rounded-2xl bg-slate-900/70 border border-amber-500/20 space-y-2 text-xs">
        <div class="flex items-start gap-2.5 text-slate-200">
          <span class="text-amber-400 mt-0.5">📘</span>
          <span>
            {isVi 
              ? 'Tặng ngay Ebook PDF: Tuyển tập 100+ Khách sạn, Resort & Đảo tư nhân danh giá nhất thế giới.' 
              : 'Instant PDF Guide: 100+ Curated 5-Star Sanctuaries & Overwater Villas Worldwide.'}
          </span>
        </div>
        <div class="flex items-start gap-2.5 text-slate-200">
          <span class="text-amber-400 mt-0.5">🛎️</span>
          <span>
            {isVi 
              ? 'Bí quyết đặt phòng Expedia VIP: Cách nhận nâng hạng Suite & bữa sáng miễn phí.' 
              : 'Expedia VIP Booking Insider: Room upgrade formulas & complimentary breakfast perks.'}
          </span>
        </div>
        <div class="flex items-start gap-2.5 text-slate-200">
          <span class="text-amber-400 mt-0.5">🎟️</span>
          <span>
            {isVi 
              ? 'Bản tin Trải nghiệm độc quyền: Tour GetYourGuide VIP bỏ qua hàng chờ & deal di chuyển Travelpayouts.' 
              : 'Exclusive Experiences Dispatch: Skip-the-line GetYourGuide VIP access & mobility deals.'}
          </span>
        </div>
      </div>

      <form id="lead-capture-form" class="space-y-3.5">
        <!-- Interactive Preference Selector -->
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase mb-2 flex items-center gap-1.5">
            <span class="text-amber-400">🎯</span>
            <span>{isVi ? 'Gu du lịch bạn quan tâm nhất:' : 'Select your primary travel interest:'}</span>
          </label>
          <div class="flex flex-wrap gap-1.5" id="modal-pref-container">
            <button
              type="button"
              data-pref="all"
              class="modal-pref-btn px-2.5 py-1 rounded-full text-xs font-bold bg-[#d4a359] text-[#07111e] border border-[#d4a359] transition-all cursor-pointer"
            >
              {isVi ? '✨ Tất Cả' : '✨ All Guides'}
            </button>
            <button
              type="button"
              data-pref="islands"
              class="modal-pref-btn px-2.5 py-1 rounded-full text-xs font-medium bg-slate-950 text-slate-300 border border-slate-700 hover:border-amber-400 transition-all cursor-pointer"
            >
              {isVi ? '🏝️ Đảo Riêng' : '🏝️ Islands'}
            </button>
            <button
              type="button"
              data-pref="palaces"
              class="modal-pref-btn px-2.5 py-1 rounded-full text-xs font-medium bg-slate-950 text-slate-300 border border-slate-700 hover:border-amber-400 transition-all cursor-pointer"
            >
              {isVi ? '🏰 Cung Điện' : '🏰 Palaces'}
            </button>
            <button
              type="button"
              data-pref="ryokans"
              class="modal-pref-btn px-2.5 py-1 rounded-full text-xs font-medium bg-slate-950 text-slate-300 border border-slate-700 hover:border-amber-400 transition-all cursor-pointer"
            >
              {isVi ? '♨️ Ryokan' : '♨️ Ryokans'}
            </button>
            <button
              type="button"
              data-pref="safaris"
              class="modal-pref-btn px-2.5 py-1 rounded-full text-xs font-medium bg-slate-950 text-slate-300 border border-slate-700 hover:border-amber-400 transition-all cursor-pointer"
            >
              {isVi ? '🦁 Safari' : '🦁 Safari'}
            </button>
            <button
              type="button"
              data-pref="vip_hacks"
              class="modal-pref-btn px-2.5 py-1 rounded-full text-xs font-medium bg-slate-950 text-slate-300 border border-slate-700 hover:border-amber-400 transition-all cursor-pointer"
            >
              {isVi ? '✈️ Mẹo VIP' : '✈️ VIP Hacks'}
            </button>
          </div>
        </div>

        <!-- Hidden Honeypot Input -->
        <input
          type="text"
          name="website"
          id="modal-lead-hp"
          class="hidden"
          tabindex="-1"
          autocomplete="off"
          style="position:absolute;left:-9999px;opacity:0;"
        />

        <div>
          <label for="lead-name" class="block text-xs font-semibold text-slate-300 uppercase mb-1">
            {isVi ? 'Họ và tên của bạn' : 'Your Name'}
          </label>
          <input
            type="text"
            id="lead-name"
            placeholder={isVi ? 'Ví dụ: Victor Chuyen' : 'e.g. Victor Chuyen'}
            class="w-full bg-slate-950/80 border border-slate-700/80 rounded-xl px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 transition"
          />
        </div>

        <div>
          <label for="lead-email" class="block text-xs font-semibold text-slate-300 uppercase mb-1">
            {isVi ? 'Địa chỉ Email nhận Cẩm Nang & Ưu Đãi *' : 'Email Address to Receive Guide & Perks *'}
          </label>
          <input
            type="email"
            id="lead-email"
            required
            placeholder="victor@example.com"
            class="w-full bg-slate-950/80 border border-slate-700/80 rounded-xl px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 transition"
          />
        </div>

        <button
          type="submit"
          id="btn-submit-lead"
          class="w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-amber-500 via-[#c9a54e] to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-black text-sm transition shadow-xl shadow-amber-500/25 flex items-center justify-center gap-2 mt-2 cursor-pointer"
        >
          <span>{isVi ? 'NHẬN CẨM NANG VIP 2026 & ĐÓN BẢN TIN THỨ BẢY' : 'GET 2026 VIP GUIDE & SATURDAY DISPATCH'}</span>
          <span>→</span>
        </button>

        <p class="text-[11px] text-center text-slate-400 pt-1 leading-normal">
          🔒 {isVi ? '1 cẩm nang chuyên sâu mỗi tuần (Vào 09:00 Thứ Bảy) • Cam kết không spam • Hủy 1-chạm.' : 'Weekly Saturday 09:00 AM dispatch • 100% Confidential · No Spam · Unsubscribe anytime.'}
        </p>
      </form>
    </div>

    <!-- Success View (Hidden by default) -->
    <div id="concierge-success-view" class="hidden text-center py-6">
      <div class="w-16 h-16 rounded-full bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 flex items-center justify-center text-3xl mx-auto mb-4 animate-bounce">
        ✓
      </div>
      <h3 class="text-2xl font-bold text-white font-serif mb-2">
        {isVi ? 'Đăng Ký Thành Công!' : 'Welcome to Travel4U VIP!'}
      </h3>
      <p class="text-slate-300 text-sm mb-6 leading-relaxed max-w-sm mx-auto">
        {isVi
          ? 'Cẩm nang Tuyển chọn Khách sạn Xa xỉ 2026 (Gold List) và mã ưu đãi độc quyền đã được gửi tới email của bạn. Hãy kiểm tra hộp thư đến (hoặc hòm thư Spam/Quảng cáo) nhé!'
          : 'The 2026 Luxury Gold List Guide and exclusive affiliate perks have been sent to your email. Please check your inbox or Promotions tab!'}
      </p>
      <div>
        <button
          type="button"
          id="btn-close-success"
          class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 text-slate-950 font-bold text-xs hover:from-amber-400 hover:to-amber-500 transition shadow-lg"
        >
          {isVi ? 'Tiếp tục khám phá' : 'Continue Exploring'}
        </button>
      </div>
    </div>

  </div>
</div>

<script>
  function setupConciergeModal() {
    const modal = document.getElementById('concierge-modal');
    const closeBtn = document.getElementById('close-concierge-btn');
    const closeSuccessBtn = document.getElementById('btn-close-success');
    const form = document.getElementById('lead-capture-form');
    const formView = document.getElementById('concierge-form-view');
    const successView = document.getElementById('concierge-success-view');
    const submitBtn = document.getElementById('btn-submit-lead');

    function openModal() {
      if (!modal) return;
      modal.classList.remove('hidden');
      setTimeout(() => {
        modal.classList.remove('opacity-0');
      }, 10);
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('opacity-0');
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 300);
    }

    // Expose openModal on window so any link/button can open the newsletter guide modal
    (window as any).openConciergeModal = openModal;
    (window as any).openVipGuideModal = openModal;

    closeBtn?.addEventListener('click', closeModal);
    closeSuccessBtn?.addEventListener('click', closeModal);

    // Close on backdrop click
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    // Modal Preference Pill Selection
    const modalPrefBtns = document.querySelectorAll('.modal-pref-btn');
    let selectedModalPref = 'all';

    const prefLabels: Record<string, string> = {
      all: 'Tất Cả Cẩm Nang VIP 2026',
      islands: '🏝️ Đảo Riêng & Biệt Thự Nổi',
      palaces: '🏰 Cung Điện Hoàng Gia & Lâu Đài Cổ',
      ryokans: '♨️ Ryokan & Suối Khoáng Onsen',
      safaris: '🦁 Safari Hoang Dã Châu Phi',
      vip_hacks: '✈️ Bí Kíp Nâng Hạng VIP 5 Sao'
    };

    modalPrefBtns.forEach((pBtn) => {
      pBtn.addEventListener('click', () => {
        selectedModalPref = pBtn.getAttribute('data-pref') || 'all';
        modalPrefBtns.forEach((b) => {
          b.classList.remove('bg-[#d4a359]', 'text-[#07111e]', 'font-bold', 'border-[#d4a359]');
          b.classList.add('bg-slate-950', 'text-slate-300', 'font-medium', 'border-slate-700');
        });
        pBtn.classList.remove('bg-slate-950', 'text-slate-300', 'font-medium', 'border-slate-700');
        pBtn.classList.add('bg-[#d4a359]', 'text-[#07111e]', 'font-bold', 'border-[#d4a359]');
      });
    });

    // Handle newsletter subscription submit
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Bot honeypot protection
      const honeypot = (document.getElementById('modal-lead-hp') as HTMLInputElement)?.value;
      if (honeypot && honeypot.trim() !== '') {
        console.warn('Bot detected in modal.');
        if (formView && successView) {
          formView.classList.add('hidden');
          successView.classList.remove('hidden');
        }
        return;
      }

      const name = (document.getElementById('lead-name') as HTMLInputElement)?.value.trim() || 'VIP Reader';
      const email = (document.getElementById('lead-email') as HTMLInputElement)?.value.trim();

      if (!email || !email.includes('@')) return;

      const refCode = localStorage.getItem('t4u_ref') || 'direct';
      const chosenLabel = prefLabels[selectedModalPref] || prefLabels.all;

      if (submitBtn) {
        submitBtn.setAttribute('disabled', 'true');
        submitBtn.innerHTML = '<span>Đang kích hoạt quyền truy cập VIP...</span>';
      }

      try {
        await fetch('/api/leads/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name,
            email,
            interest: 'newsletter_vip_guide',
            preference: chosenLabel,
            preference_key: selectedModalPref,
            note: `Đăng ký nhận Cẩm nang VIP 2026 qua Modal Popup [Gu: ${chosenLabel}]`,
            ref_code: refCode,
            source_url: window.location.pathname,
            locale: document.documentElement.lang || 'vi'
          })
        });

        // Store subscription locally
        try {
          localStorage.setItem('t4u_journal_subscribed', email);
          localStorage.setItem('t4u_journal_pref', selectedModalPref);
        } catch (e) {}

        // Show success state
        if (formView && successView) {
          formView.classList.add('hidden');
          successView.classList.remove('hidden');
        }

      } catch (err) {
        // Fallback: Still show success to user
        try {
          localStorage.setItem('t4u_journal_subscribed', email);
          localStorage.setItem('t4u_journal_pref', selectedModalPref);
        } catch (e) {}
        if (formView && successView) {
          formView.classList.add('hidden');
          successView.classList.remove('hidden');
        }
      }
    });
  }

  document.addEventListener('DOMContentLoaded', setupConciergeModal);
</script>
