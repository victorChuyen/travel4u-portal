---
import i18n from '../data/i18n.json';

interface Props {
  currentLocale?: string;
  alternateUrls?: Record<string, string>;
}

const { currentLocale = 'en', alternateUrls = {} } = Astro.props;
const dict = (i18n as any)[currentLocale] || (i18n as any).en;

const languages = [
  { code: 'en', label: 'English', path: '/' },
  { code: 'vi', label: 'Tiếng Việt', path: '/vi/' },
  { code: 'de', label: 'Deutsch', path: '/de/' },
  { code: 'fr', label: 'Français', path: '/fr/' },
  { code: 'es', label: 'Español', path: '/es/' },
  { code: 'it', label: 'Italiano', path: '/it/' },
  { code: 'ja', label: '日本語', path: '/ja/' },
  { code: 'ko', label: '한국어', path: '/ko/' },
  { code: 'zh-tw', label: '繁體中文', path: '/zh-tw/' },
  { code: 'zh-cn', label: '简体中文', path: '/zh-cn/' },
  { code: 'pt', label: 'Português', path: '/pt/' },
  { code: 'ru', label: 'Русский', path: '/ru/' },
];

const homeUrl = currentLocale === 'en' ? '/' : `/${currentLocale}/`;
---

<header class="sticky top-0 z-50 bg-[#07111e]/95 backdrop-blur-md border-b border-slate-800/80 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      <!-- Brand Logo -->
      <a href={homeUrl} class="group flex items-center space-x-2.5 sm:space-x-3 shrink-0">
        <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-lg bg-gradient-to-tr from-[#c9a54e] via-[#dfba63] to-[#ff7043] p-0.5 shadow-lg shadow-[#c9a54e]/20 group-hover:scale-105 transition-transform duration-300 shrink-0">
          <div class="w-full h-full bg-[#07111e] rounded-[6px] sm:rounded-[7px] flex items-center justify-center">
            <span class="text-base sm:text-xl font-bold font-serif text-[#c9a54e]">4U</span>
          </div>
        </div>
        <div class="flex flex-col">
          <span class="font-serif tracking-widest text-base sm:text-lg font-bold text-white uppercase group-hover:text-[#c9a54e] transition-colors leading-tight">
            Travel4U
          </span>
          <span class="text-[8px] sm:text-[10px] tracking-wider sm:tracking-[0.25em] text-[#c9a54e] uppercase font-semibold leading-tight">
            Luxury Stays & Concierge
          </span>
        </div>
      </a>

      <!-- Desktop Clean Navigation Links (No clashing buttons) -->
      <nav class="hidden lg:flex items-center space-x-7 xl:space-x-8 text-sm font-medium text-slate-300">
        <a href={homeUrl} class="hover:text-white transition-colors">{dict.nav_home}</a>
        <a href={`${homeUrl}#experiences`} class="hover:text-[#c9a54e] transition-colors">{dict.nav_experiences}</a>
        <a href={`${homeUrl}#destinations`} class="hover:text-[#c9a54e] transition-colors">{dict.nav_destinations}</a>
        <a href={`${homeUrl}#curator`} class="hover:text-[#c9a54e] transition-colors">{dict.nav_curators}</a>
      </nav>

      <!-- Right Actions: Unified Height (h-9 / 36px), Pixel-Perfect Capsule Design -->
      <div class="flex items-center space-x-2 sm:space-x-3 shrink-0">
        
        <!-- 1. VIP Member & Partner Auth Button (Single line, no text wrapping) -->
        <a
          href="/aff/login"
          id="header-vip-auth-btn"
          class="inline-flex items-center space-x-1.5 h-9 px-3.5 sm:px-4 rounded-full bg-[#0b1726]/90 border border-[#c9a54e]/50 hover:border-[#c9a54e] text-[#dfba63] hover:text-white text-xs font-semibold tracking-wide transition-all duration-200 shadow-sm shadow-[#c9a54e]/10 hover:shadow-[#c9a54e]/25 shrink-0 whitespace-nowrap"
          title="Cổng Đăng Nhập & Đăng Ký VIP Member"
        >
          <span id="header-vip-icon" class="text-xs">🔑</span>
          <span id="header-vip-label">{currentLocale === 'vi' ? 'Đăng Nhập VIP' : 'VIP Sign In'}</span>
        </a>

        <!-- 2. Language Selector Dropdown (Exact same h-9 height & pill style) -->
        <div class="relative group shrink-0">
          <button
            type="button"
            class="inline-flex items-center space-x-1.5 h-9 px-3 rounded-full bg-[#0b1726]/90 border border-slate-700/70 hover:border-[#c9a54e] text-xs font-semibold text-slate-200 hover:text-white transition-all duration-200 shrink-0"
            aria-label="Select Language"
          >
            <span class="text-xs">🌐</span>
            <span class="uppercase font-bold tracking-wider text-[11px] sm:text-xs">{currentLocale}</span>
            <svg class="w-3 h-3 text-slate-400 group-hover:text-[#c9a54e] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          
          <div class="absolute right-0 mt-2 w-48 bg-[#0b1b30] border border-slate-700/80 rounded-xl shadow-2xl py-2 invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all duration-200 z-50">
            <div class="px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-slate-400 border-b border-slate-800">
              Select Locale
            </div>
            <div class="max-h-64 overflow-y-auto py-1">
              {languages.map((lang) => {
                const targetUrl = alternateUrls[lang.code] || lang.path;
                return (
                  <a
                    href={targetUrl}
                    class={`flex items-center justify-between px-3.5 py-2 text-xs hover:bg-[#11223f] transition-colors ${currentLocale === lang.code ? 'text-[#c9a54e] font-bold bg-[#11223f]/50' : 'text-slate-300'}`}
                  >
                    <span>{lang.label}</span>
                    <span class="text-[10px] uppercase font-mono text-slate-400">{lang.code}</span>
                  </a>
                );
              })}
            </div>
          </div>
        </div>

        <!-- 3. GetYourGuide VIP CTA (Refined Luxury Sunset Button, h-9 height) -->
        <a
          href="https://www.getyourguide.com/?partner_id=4G5BPIE&cmp=t4u_app_header"
          target="_blank"
          rel="nofollow sponsored noopener"
          class="hidden xl:inline-flex items-center space-x-1.5 h-9 px-4 rounded-full bg-gradient-to-r from-[#e65100] via-[#f4511e] to-[#ff7043] hover:from-[#f4511e] hover:to-[#ff8a65] text-white text-[11px] font-bold uppercase tracking-wider shadow-md shadow-orange-950/40 hover:shadow-orange-500/20 transition-all duration-300 shrink-0 whitespace-nowrap"
        >
          <span>GetYourGuide VIP</span>
          <span class="text-xs">→</span>
        </a>

        <!-- 4. Mobile & Tablet Hamburger Toggle Button -->
        <button
          id="mobile-menu-toggle"
          type="button"
          class="lg:hidden flex items-center justify-center w-9 h-9 rounded-lg bg-slate-900 border border-slate-700/80 text-slate-300 hover:text-white hover:border-[#c9a54e] transition-all focus:outline-none shrink-0"
          aria-label="Toggle Mobile Navigation"
          aria-expanded="false"
        >
          <svg id="icon-menu" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

      </div>

    </div>
  </div>

  <!-- Mobile Navigation Drawer (iPhone / Android / iPad) -->
  <div
    id="mobile-menu-drawer"
    class="hidden lg:hidden bg-[#07111e] border-b border-slate-800 px-4 pt-4 pb-6 space-y-4 shadow-2xl transition-all duration-300"
  >
    <!-- Navigation Links -->
    <div class="space-y-1">
      <a
        href={homeUrl}
        class="flex items-center h-12 px-4 rounded-lg text-slate-200 hover:text-white hover:bg-[#0b1b30] text-sm font-semibold transition-colors"
      >
        <span>🏛️</span>
        <span class="ml-3">{dict.nav_home}</span>
      </a>
      <a
        href={`${homeUrl}#experiences`}
        class="flex items-center h-12 px-4 rounded-lg text-slate-200 hover:text-[#c9a54e] hover:bg-[#0b1b30] text-sm font-semibold transition-colors"
      >
        <span>💎</span>
        <span class="ml-3">{dict.nav_experiences}</span>
      </a>
      <a
        href={`${homeUrl}#destinations`}
        class="flex items-center h-12 px-4 rounded-lg text-slate-200 hover:text-[#c9a54e] hover:bg-[#0b1b30] text-sm font-semibold transition-colors"
      >
        <span>📍</span>
        <span class="ml-3">{dict.nav_destinations}</span>
      </a>
      <a
        href={`${homeUrl}#curator`}
        class="flex items-center h-12 px-4 rounded-lg text-slate-200 hover:text-[#c9a54e] hover:bg-[#0b1b30] text-sm font-semibold transition-colors"
      >
        <span>👑</span>
        <span class="ml-3">{dict.nav_curators}</span>
      </a>
      <a
        href="/aff/"
        class="flex items-center h-12 px-4 rounded-lg text-amber-300 bg-amber-500/15 border border-amber-500/40 text-sm font-bold transition-colors"
      >
        <span>💎</span>
        <span class="ml-3">{currentLocale === 'vi' ? 'Đối Tác VIP & Bảng Điều Khiển' : 'VIP Affiliate & Dashboard'}</span>
      </a>
      <a
        href="/aff/login"
        class="flex items-center h-12 px-4 rounded-lg text-slate-200 hover:text-amber-400 bg-slate-900 border border-slate-700/80 text-sm font-bold transition-colors"
      >
        <span>🔑</span>
        <span class="ml-3">{currentLocale === 'vi' ? 'Đăng Nhập / Đăng Ký VIP Member' : 'VIP Member Sign In / Sign Up'}</span>
      </a>
    </div>

    <!-- Mobile Language Selector Grid (12 Locales) -->
    <div class="pt-3 border-t border-slate-800/80">
      <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block mb-2 px-1">
        Select Language (12 Locales)
      </span>
      <div class="grid grid-cols-3 sm:grid-cols-4 gap-1.5 sm:gap-2">
        {languages.map((lang) => {
          const targetUrl = alternateUrls[lang.code] || lang.path;
          return (
            <a
              href={targetUrl}
              class={`flex items-center justify-center py-2 px-1 text-center rounded-lg text-[11px] sm:text-xs font-semibold border transition-all ${currentLocale === lang.code ? 'bg-[#c9a54e]/20 border-[#c9a54e] text-[#c9a54e]' : 'bg-slate-900/80 border-slate-800 text-slate-300 hover:border-slate-700'}`}
            >
              {lang.label}
            </a>
          );
        })}
      </div>
    </div>

    <!-- Mobile Curators Note -->
    <div class="p-3 bg-slate-900/90 border border-slate-800/80 rounded-xl text-xs text-slate-400">
      <span class="text-[#c9a54e] font-bold block mb-1">👑 Curators</span>
      <span>Curated by Luxury Victor Travel4U & Luxury Lucky Travel4U. Verified GetYourGuide Partner.</span>
    </div>

    <!-- Mobile Direct GYG CTA -->
    <a
      href="https://www.getyourguide.com/?partner_id=4G5BPIE&cmp=t4u_app_mobile_header"
      target="_blank"
      rel="nofollow sponsored noopener"
      class="flex items-center justify-center w-full py-3.5 bg-gradient-to-r from-[#ff7043] to-[#f4511e] text-white text-xs font-bold uppercase tracking-wider rounded-xl shadow-lg shadow-[#ff7043]/30"
    >
      <span>Browse GetYourGuide VIP Catalog →</span>
    </a>
  </div>

  <script is:inline>
    // Dynamic Auth Button Check for Header
    (function checkHeaderAuth() {
      try {
        const vipUserStr = localStorage.getItem('t4u_vip_user');
        const authBtn = document.getElementById('header-vip-auth-btn');
        const iconEl = document.getElementById('header-vip-icon');
        const labelEl = document.getElementById('header-vip-label');
        if (vipUserStr && authBtn && labelEl) {
          const vipUser = JSON.parse(vipUserStr);
          const name = vipUser.displayName || vipUser.email?.split('@')[0] || 'VIP';
          authBtn.href = '/aff/';
          if (iconEl) iconEl.textContent = '💎';
          labelEl.textContent = name.length > 12 ? name.substring(0, 10) + '...' : name;
          authBtn.title = 'Truy cập Bảng điều khiển VIP Affiliate';
          authBtn.classList.remove('border-[#c9a54e]/50');
          authBtn.classList.add('border-emerald-500/60', 'text-emerald-300');
        }
      } catch (e) {}
    })();

    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-menu-drawer');
    const iconMenu = document.getElementById('icon-menu');
    const iconClose = document.getElementById('icon-close');

    if (toggleBtn && drawer && iconMenu && iconClose) {
      toggleBtn.addEventListener('click', () => {
        const isHidden = drawer.classList.contains('hidden');
        if (isHidden) {
          drawer.classList.remove('hidden');
          iconMenu.classList.add('hidden');
          iconClose.classList.remove('hidden');
          toggleBtn.setAttribute('aria-expanded', 'true');
        } else {
          drawer.classList.add('hidden');
          iconMenu.classList.remove('hidden');
          iconClose.classList.add('hidden');
          toggleBtn.setAttribute('aria-expanded', 'false');
        }
      });

      // Close drawer on link click
      drawer.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          drawer.classList.add('hidden');
          iconMenu.classList.remove('hidden');
          iconClose.classList.add('hidden');
          toggleBtn.setAttribute('aria-expanded', 'false');
        });
      });
    }
  </script>
</header>
