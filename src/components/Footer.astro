<script is:inline define:vars={{ currentLocale }}>
  (function initFooterJournal() {
    const form = document.getElementById('footer-journal-form');
    const input = document.getElementById('footer-journal-email');
    const btn = document.getElementById('footer-journal-btn');
    const btnText = document.getElementById('footer-journal-btn-text');
    const btnArrow = document.getElementById('footer-journal-btn-arrow');
    const btnSpinner = document.getElementById('footer-journal-btn-spinner');
    const errorBox = document.getElementById('footer-journal-error');
    const errorMsg = document.getElementById('footer-journal-error-msg');
    const successBox = document.getElementById('footer-journal-success');
    const successText = document.getElementById('footer-journal-success-text');
    const honeypot = document.getElementById('footer-journal-hp');
    const prefBtns = document.querySelectorAll('.footer-pref-btn');

    if (!form || !input || !btn) return;

    let selectedPref = 'all';

    const prefLabels = {
      all: currentLocale === 'vi' ? 'Tất Cả Cẩm Nang VIP 2026' : 'All 2026 VIP Sanctuaries',
      islands: currentLocale === 'vi' ? '🏝️ Đảo Riêng & Biệt Thự Nổi' : '🏝️ Private Islands & Overwater Villas',
      palaces: currentLocale === 'vi' ? '🏰 Cung Điện Hoàng Gia & Lâu Đài Cổ' : '🏰 Historic European Grand Palaces',
      ryokans: currentLocale === 'vi' ? '♨️ Ryokan Truyền Thống & Suối Khoáng Onsen' : '♨️ Japanese Zen Ryokans & Mineral Onsens',
      safaris: currentLocale === 'vi' ? '🦁 Safari Hoang Dã Châu Phi (Big Five)' : '🦁 African Big Five Luxury Safaris',
      vip_hacks: currentLocale === 'vi' ? '✈️ Bí Kíp Săn Phòng & Nâng Hạng VIP 5 Sao' : '✈️ VIP Booking Perks & Suite Upgrades'
    };

    // Initialize preference buttons
    prefBtns.forEach((pBtn) => {
      pBtn.addEventListener('click', () => {
        selectedPref = pBtn.getAttribute('data-pref') || 'all';
        prefBtns.forEach((b) => {
          b.classList.remove('bg-[#d4a359]', 'text-[#07111e]', 'font-bold', 'border-[#d4a359]', 'shadow-sm');
          b.classList.add('bg-[#040a12]', 'text-slate-300', 'font-medium', 'border-slate-700/80');
        });
        pBtn.classList.remove('bg-[#040a12]', 'text-slate-300', 'font-medium', 'border-slate-700/80');
        pBtn.classList.add('bg-[#d4a359]', 'text-[#07111e]', 'font-bold', 'border-[#d4a359]', 'shadow-sm');
      });
    });

    // Check if user already subscribed in this browser
    try {
      const alreadySubscribed = localStorage.getItem('t4u_journal_subscribed');
      if (alreadySubscribed) {
        input.value = alreadySubscribed;
      }
      const savedPref = localStorage.getItem('t4u_journal_pref');
      if (savedPref) {
        const targetBtn = document.querySelector(`.footer-pref-btn[data-pref="${savedPref}"]`);
        if (targetBtn) targetBtn.click();
      }
    } catch (e) {}

    function showError(msg) {
      if (!errorBox || !errorMsg) return;
      errorMsg.textContent = msg;
      errorBox.classList.remove('hidden');
      input.classList.add('border-rose-500');
    }

    function clearError() {
      if (!errorBox) return;
      errorBox.classList.add('hidden');
      input.classList.remove('border-rose-500');
    }

    input.addEventListener('input', clearError);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearError();

      // Anti-Bot Honeypot Protection
      if (honeypot && honeypot.value.trim() !== '') {
        console.warn('Bot detected via honeypot.');
        form.classList.add('hidden');
        if (successBox) successBox.classList.remove('hidden');
        return;
      }

      const email = input.value.trim();
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      if (!email || !emailRegex.test(email)) {
        showError(currentLocale === 'vi' ? 'Vui lòng nhập địa chỉ email hợp lệ.' : 'Please enter a valid email address.');
        input.focus();
        return;
      }

      // UI: Loading State
      btn.disabled = true;
      btn.classList.add('opacity-80', 'cursor-not-allowed');
      if (btnArrow) btnArrow.classList.add('hidden');
      if (btnSpinner) btnSpinner.classList.remove('hidden');
      if (btnText) btnText.textContent = currentLocale === 'vi' ? 'Đang kích hoạt...' : 'Activating...';

      try {
        let refCode = 'direct';
        try {
          refCode = localStorage.getItem('t4u_ref') || localStorage.getItem('t4u_partner_ref') || 'direct';
        } catch (e) {}

        const chosenLabel = prefLabels[selectedPref] || prefLabels.all;

        const payload = {
          name: 'VIP Journal Reader',
          email: email,
          interest: 'newsletter_vip_guide',
          preference: chosenLabel,
          preference_key: selectedPref,
          note: `Subscribed via Footer Travel4You Journal [Gu: ${chosenLabel}]`,
          ref_code: refCode,
          source_url: window.location.pathname,
          locale: currentLocale
        };

        // Send to backend Cloudflare Pages Function
        const res = await fetch('/api/leads/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        // Save subscription status and preferred category
        try {
          localStorage.setItem('t4u_journal_subscribed', email);
          localStorage.setItem('t4u_journal_pref', selectedPref);
        } catch (e) {}

        // Personalize Success Description
        if (successText && selectedPref !== 'all') {
          if (currentLocale === 'vi') {
            successText.textContent = `Tuyệt vời! Cẩm nang 2026 Gold List cùng chuyên đề "${chosenLabel}" đang được chuyển tới email của bạn. Hãy đón chờ bản tin chuyên sâu vào lúc 09:00 Sáng Thứ Bảy hàng tuần!`;
          } else {
            successText.textContent = `Splendid! The 2026 Gold List Guide and your personalized "${chosenLabel}" dispatch are on their way to your email. Expect your curated deep-dive every Saturday at 09:00 AM!`;
          }
        }

        // Success UI
        form.classList.add('hidden');
        if (successBox) successBox.classList.remove('hidden');

        // Trigger global toast if present
        if (typeof window.showToast === 'function') {
          window.showToast(
            currentLocale === 'vi' ? 'Đăng ký cẩm nang thành công! ✨' : 'Subscribed to Travel4You Journal! ✨',
            '👑'
          );
        }
      } catch (err) {
        console.warn('Journal submission network fallback:', err);
        try {
          localStorage.setItem('t4u_journal_subscribed', email);
          localStorage.setItem('t4u_journal_pref', selectedPref);
        } catch (e) {}
        form.classList.add('hidden');
        if (successBox) successBox.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.classList.remove('opacity-80', 'cursor-not-allowed');
        if (btnArrow) btnArrow.classList.remove('hidden');
        if (btnSpinner) btnSpinner.classList.add('hidden');
      }
    });
  })();
</script>
