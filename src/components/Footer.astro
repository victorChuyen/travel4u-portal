const t = journalContent[currentLocale] || journalContent.en;
---

<footer class="bg-[#040a12] border-t border-slate-800/80 pt-16 pb-12 text-slate-400 text-sm mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- 📰 Top Section: TRAVEL4YOU JOURNAL (Email Lead Capture Banner) -->
    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-b from-[#081526] to-[#040a12] border border-slate-800/90 p-6 sm:p-10 lg:p-12 mb-16 shadow-2xl">
      <!-- Ambient Luxury Glow Background -->
      <div class="absolute -top-24 -right-24 w-80 sm:w-96 h-80 sm:h-96 bg-[#c9a54e]/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -left-24 w-80 h-80 bg-blue-600/5 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl">
        <!-- Eyebrow Badge -->
        <p class="text-xs sm:text-sm font-semibold tracking-widest text-[#d4a359] uppercase mb-3">
          {t.badge}
        </p>

        <!-- Headline -->
        <h3 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-bold text-white tracking-tight leading-tight mb-3">
          {t.title}
        </h3>

        <!-- Subtitle -->
        <p class="text-sm sm:text-base text-slate-300/90 leading-relaxed mb-6 sm:mb-8 max-w-2xl font-sans">
          {t.subtitle}
        </p>

        <!-- Subscription Form -->
        <form id="footer-journal-form" class="space-y-4" novalidate>
          <!-- Interactive Preference Selector (Demand-Driven Segment) -->
          <div>
            <p class="text-xs text-slate-300 font-semibold mb-2 flex items-center gap-1.5">
              <span class="text-[#d4a359]">🎯</span>
              <span>{t.preferenceTitle}</span>
            </p>
            <div class="flex flex-wrap gap-2" id="footer-journal-pref-container">
              <button
                type="button"
                data-pref="all"
                class="footer-pref-btn px-3 py-1.5 rounded-full text-xs font-bold bg-[#d4a359] text-[#07111e] border border-[#d4a359] shadow-sm transition-all cursor-pointer"
              >
                {t.pref_all}
              </button>
              <button
                type="button"
                data-pref="islands"
                class="footer-pref-btn px-3 py-1.5 rounded-full text-xs font-medium bg-[#040a12] text-slate-300 border border-slate-700/80 hover:border-[#d4a359]/60 hover:text-white transition-all cursor-pointer"
              >
                {t.pref_islands}
              </button>
              <button
                type="button"
                data-pref="palaces"
                class="footer-pref-btn px-3 py-1.5 rounded-full text-xs font-medium bg-[#040a12] text-slate-300 border border-slate-700/80 hover:border-[#d4a359]/60 hover:text-white transition-all cursor-pointer"
              >
                {t.pref_palaces}
              </button>
              <button
                type="button"
                data-pref="ryokans"
                class="footer-pref-btn px-3 py-1.5 rounded-full text-xs font-medium bg-[#040a12] text-slate-300 border border-slate-700/80 hover:border-[#d4a359]/60 hover:text-white transition-all cursor-pointer"
              >
                {t.pref_ryokans}
              </button>
              <button
                type="button"
                data-pref="safaris"
                class="footer-pref-btn px-3 py-1.5 rounded-full text-xs font-medium bg-[#040a12] text-slate-300 border border-slate-700/80 hover:border-[#d4a359]/60 hover:text-white transition-all cursor-pointer"
              >
                {t.pref_safaris}
              </button>
              <button
                type="button"
                data-pref="vip_hacks"
                class="footer-pref-btn px-3 py-1.5 rounded-full text-xs font-medium bg-[#040a12] text-slate-300 border border-slate-700/80 hover:border-[#d4a359]/60 hover:text-white transition-all cursor-pointer"
              >
                {t.pref_vip_hacks}
              </button>
            </div>
          </div>

          <!-- Hidden Honeypot for Anti-Bot Spam Protection -->
          <input
            type="text"
            name="website"
            id="footer-journal-hp"
            class="hidden"
            tabindex="-1"
            autocomplete="off"
            style="position:absolute;left:-9999px;opacity:0;"
          />

          <div class="flex flex-col sm:flex-row items-stretch gap-3 w-full max-w-2xl pt-1">
            <!-- Email Input (iOS 16px font-size prevents unwanted auto-zoom) -->
            <div class="relative flex-1">
              <input
                type="email"
                id="footer-journal-email"
                name="email"
                placeholder={t.placeholder}
                required
                autocomplete="email"
                inputmode="email"
                autocapitalize="none"
                spellcheck="false"
                class="w-full h-12 sm:h-13 px-4 py-3 bg-[#040a12] border border-slate-700/80 rounded-xl text-white text-base placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-[#c9a54e]/40 focus:border-[#c9a54e] transition-all duration-200"
              />
              <span id="footer-journal-input-icon" class="absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-500 text-sm pointer-events-none">
                ✉️
              </span>
            </div>

            <!-- Submit Button (Touch-friendly 48px+ height, active click scale, gold luxury color) -->
            <button
              type="submit"
              id="footer-journal-btn"
              class="h-12 sm:h-13 px-6 sm:px-8 bg-[#d4a359] hover:bg-[#dfba63] active:bg-[#c9a54e] active:scale-[0.98] text-[#07111e] font-bold text-sm sm:text-base rounded-xl transition-all duration-200 shadow-lg shadow-[#d4a359]/20 hover:shadow-[#d4a359]/30 flex items-center justify-center space-x-2 flex-shrink-0 cursor-pointer"
            >
              <span id="footer-journal-btn-text">{t.button}</span>
              <span id="footer-journal-btn-arrow" class="text-base font-bold">→</span>
              <span id="footer-journal-btn-spinner" class="hidden animate-spin">
                <svg class="w-5 h-5 text-[#07111e]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
              </span>
            </button>
          </div>

          <!-- Privacy & Trust Microcopy -->
          <div class="flex items-center space-x-2 text-xs text-slate-400 pt-1">
            <span class="text-[#d4a359]">🔒</span>
            <span>{t.privacy}</span>
          </div>

          <!-- Error Alert Container -->
          <div id="footer-journal-error" class="hidden p-3 rounded-lg bg-rose-950/60 border border-rose-800/80 text-rose-300 text-xs flex items-center space-x-2">
            <span>⚠️</span>
            <span id="footer-journal-error-msg"></span>
          </div>
        </form>

