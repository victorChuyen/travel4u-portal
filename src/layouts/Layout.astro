---
interface Props {
  title: string;
  description: string;
  locale?: string;
  image?: string;
  keywords?: string;
  schema?: any;
  canonicalUrl?: string;
  type?: 'website' | 'article';
  alternateUrls?: Record<string, string>;
}

const {
  title,
  description,
  locale = 'en',
  image = '/Luxury-Travel4U.png',
  keywords = 'luxury hotels, 5 star presidential suites, private overwater villas, Lake Como luxury stays, Kyoto luxury ryokan, luxury safari camps, Swiss Alps luxury chalets, Expedia VIP perks, Travel4U Victor and Lucky, luxury travel concierge',
  schema,
  canonicalUrl = Astro.url.href,
  type = 'website',
  alternateUrls
} = Astro.props;

const locales = ['en', 'vi', 'de', 'fr', 'es', 'it', 'ja', 'ko', 'zh-tw', 'zh-cn', 'pt', 'ru'];

const ogLocales: Record<string, string> = {
  en: 'en_US',
  vi: 'vi_VN',
  de: 'de_DE',
  fr: 'fr_FR',
  es: 'es_ES',
  it: 'it_IT',
  ja: 'ja_JP',
  ko: 'ko_KR',
  'zh-tw': 'zh_TW',
  'zh-cn': 'zh_CN',
  pt: 'pt_PT',
  ru: 'ru_RU'
};

const ogLocale = ogLocales[locale] || 'en_US';
const otherOgLocales = Object.entries(ogLocales)
  .filter(([l]) => l !== locale)
  .map(([_, v]) => v);

const siteOrigin = 'https://travel4u.us';
const fullImageUrl = image.startsWith('http') ? image : `${siteOrigin}${image.startsWith('/') ? image : '/' + image}`;

// Compute default alternates if not provided
const effectiveAlternates: Record<string, string> = alternateUrls || {};
if (Object.keys(effectiveAlternates).length === 0) {
  locales.forEach(loc => {
    effectiveAlternates[loc] = loc === 'en' ? `${siteOrigin}/` : `${siteOrigin}/${loc}/`;
  });
  effectiveAlternates['x-default'] = `${siteOrigin}/`;
}
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Primary Search & AI Search Engine Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Victor & Lucky, Luxury Travel4U" />
    <meta name="creator" content="Luxury Travel4U Victor & Lucky" />
    <meta name="publisher" content="Travel4U - Sovereign Luxury Concierge" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#07111e" />

    <!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Travel4U | Luxury Journeys, Intelligently Crafted" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:image:secure_url" content={fullImageUrl} />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1080" />
    <meta property="og:image:alt" content="Travel4U - Luxury Journeys, Intelligently Crafted (Curated by Victor & Lucky)" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:locale" content={ogLocale} />
    {otherOgLocales.map(alt => (
      <meta property="og:locale:alternate" content={alt} />
    ))}

    <!-- Twitter / X Cards -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:site" content="@Travel4U_VIP" />
    <meta property="twitter:creator" content="@VictorLucky_VIP" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={fullImageUrl} />
    <meta property="twitter:image:alt" content="Travel4U - Luxury Journeys, Intelligently Crafted" />

    <!-- Alternate Hreflang Clusters (Google & AI Search Geotargeting) -->
    {Object.entries(effectiveAlternates).map(([altLoc, altUrl]) => (
      <link rel="alternate" hreflang={altLoc} href={altUrl} />
    ))}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Schema.org JSON-LD Structured Data for Google & AI Search Engines -->
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <!-- Multi-Tenant Team Member Attribution Engine -->
    <script is:inline src="/scripts/team_attribution.js"></script>
  </head>
  <body class="bg-[#07111e] text-slate-100 font-sans antialiased selection:bg-[#c9a54e] selection:text-[#07111e] min-h-screen flex flex-col">
    <slot />

    <!-- Toast Notification Container -->
    <div id="t4u-toast" class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none bg-[#0b1726]/95 border border-[#c9a54e]/60 text-white text-xs font-semibold px-4 py-3 rounded-xl shadow-2xl backdrop-blur-md flex items-center space-x-2">
      <span id="toast-icon" class="text-base">✨</span>
      <span id="toast-msg">Notification message</span>
    </div>

    <script is:inline>
      // Global Bookmark & Social Share Engine
      function showToast(msg, icon = '✨') {
        const toast = document.getElementById('t4u-toast');
        const toastMsg = document.getElementById('toast-msg');
        const toastIcon = document.getElementById('toast-icon');
        if (!toast || !toastMsg) return;

        toastMsg.textContent = msg;
        if (toastIcon) toastIcon.textContent = icon;

        toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
        toast.classList.add('translate-y-0', 'opacity-100');

        setTimeout(() => {
          toast.classList.remove('translate-y-0', 'opacity-100');
          toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
        }, 3000);
      }

      function initBookmarks() {
        let bookmarks = [];
        try {
          bookmarks = JSON.parse(localStorage.getItem('t4u_bookmarks') || '[]');
        } catch (e) {
          bookmarks = [];
        }

        // Render existing bookmarks state
        document.querySelectorAll('.bookmark-btn').forEach(btn => {
          const slug = btn.getAttribute('data-slug');
          const heartIcon = btn.querySelector('.heart-icon');
          if (bookmarks.includes(slug)) {
            btn.classList.add('text-rose-500', 'border-rose-500/60');
            if (heartIcon) {
              heartIcon.setAttribute('fill', 'currentColor');
            }
          }

          btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();

            const isSaved = bookmarks.includes(slug);
            if (isSaved) {
              bookmarks = bookmarks.filter(s => s !== slug);
              btn.classList.remove('text-rose-500', 'border-rose-500/60');
              if (heartIcon) heartIcon.setAttribute('fill', 'none');
              showToast('Removed from your private wishlist', '🤍');
            } else {
              bookmarks.push(slug);
              btn.classList.add('text-rose-500', 'border-rose-500/60');
              if (heartIcon) heartIcon.setAttribute('fill', 'currentColor');
              showToast('Saved to your private VIP wishlist!', '❤️');
            }
            localStorage.setItem('t4u_bookmarks', JSON.stringify(bookmarks));
          });
        });

        // Global Share Handlers
        document.querySelectorAll('.card-share-btn, .page-share-btn').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            e.preventDefault();
            e.stopPropagation();

            const url = btn.getAttribute('data-url') || window.location.href;
            const fullUrl = url.startsWith('http') ? url : window.location.origin + url;
            const title = btn.getAttribute('data-title') || document.title;

            if (navigator.share) {
              try {
                await navigator.share({
                  title: title,
                  text: 'Explore this curated VIP experience on Travel4You Sovereign Concierge:',
                  url: fullUrl
                });
                return;
              } catch (err) {
                // User cancelled or unsupported
              }
            }

            // Fallback: Copy to clipboard
            try {
              await navigator.clipboard.writeText(fullUrl);
              showToast('Link copied to clipboard!', '🔗');
            } catch (err) {
              showToast('Share link: ' + fullUrl, '📋');
            }
          });
        });
      }

      document.addEventListener('DOMContentLoaded', initBookmarks);
    </script>
  </body>
</html>
